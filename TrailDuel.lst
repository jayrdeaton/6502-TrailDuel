000420r 2  A5 60          lda DIGIT_TMP
000422r 2  4C rr rr       jmp PlotValue
000425r 2               @done:
000425r 2  60             rts
000426r 2               
000426r 2               ; PixelSetBorder - a pixel of the arena's border, at row A, column X (bit 8 in
000426r 2               ; PX_HI). Keeps X and Y.
000426r 2               PixelSetBorder:
000426r 2  DA             phx
000427r 2  5A             phy
