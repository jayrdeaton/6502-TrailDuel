000286r 2  AA             tax
000287r 2  20 rr rr       jsr VAddr
00028Ar 2  A2 1F          ldx #>(LAYER_BYTES + 16 + 255)
00028Cr 2  A9 00          lda #0
00028Er 2  A8             tay
00028Fr 2               @vramPage:
