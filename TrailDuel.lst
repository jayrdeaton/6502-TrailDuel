0011E0r 2               ; -----------------------------------------------------------------------------
0011E0r 2               ; DrawTitleScreen - always a full wipe and fresh redraw, drawn into the arena
0011E0r 2               ; the same way the trails are. Reached both at initial boot (over an
0011E0r 2               ; already-blank arena) and after a game over (over the frozen final trails
0011E0r 2               ; under the result) -- wiping only at one of those call sites would leave
0011E0r 2               ; the other showing stale content underneath.
0011E0r 2               ; -----------------------------------------------------------------------------
0011E0r 2               DrawTitleScreen:
0011E0r 2  20 rr rr       jsr ClearScreen
0011E3r 2  20 rr rr       jsr DrawBorder
0011E6r 2  20 rr rr       jsr InitHeadSprites             ; both heads hidden
0011E9r 2               
0011E9r 2  A9 3A          lda #58
0011EBr 2  85 6F          sta TEXT_ROW
0011EDr 2  A9 48          lda #72                     ; "TRAIL DUEL" is 10 cells of 12px, so the
0011EFr 2  85 70          sta TEXT_COL                ; words start at 72 and 144
0011F1r 2  A9 0F          lda #TMS_WHITE
0011F3r 2  85 71          sta TEXT_COLOR
0011F5r 2  A9 rr          lda #<TitleLine1
0011F7r 2  85 78          sta TEXT_STR_PTR
0011F9r 2  A9 rr          lda #>TitleLine1
0011FBr 2  85 79          sta TEXT_STR_PTR+1
0011FDr 2  20 rr rr       jsr DrawTextBig
001200r 2  20 rr rr       jsr DrawTitleDecoration
001203r 2  20 rr rr       jsr DrawMenu
001206r 2  A9 90          lda #144
001208r 2  A2 rr          ldx #<TitleLine4
00120Ar 2  A0 rr          ldy #>TitleLine4
00120Cr 2  20 rr rr       jsr CenterText
00120Fr 2               
00120Fr 2  A9 00          lda #STATE_TITLE
001211r 2  85 3A          sta GAME_STATE
001213r 2  60             rts
001214r 2               
001214r 2               ; -----------------------------------------------------------------------------
001214r 2               ; DrawTitleDecoration - the title underlined in each player's trail color:
001214r 2               ; "TRAIL" in P1's, "DUEL" in P2's, so the title screen reads as the same
001214r 2               ; game rather than a bolted-on splash, right from the two-word split the
001214r 2               ; name already has. Each line is drawn in its player's value, so a new color
001214r 2               ; pick recolors it through the palette.
001214r 2               ; -----------------------------------------------------------------------------
001214r 2               DrawTitleDecoration:
001214r 2  20 rr rr       jsr DrawP1Underline
001217r 2  4C rr rr       jmp DrawP2Underline
00121Ar 2               
00121Ar 2               ; -----------------------------------------------------------------------------
00121Ar 2               ; DrawP1Underline - erases and redraws the underline beneath "TRAIL" (row
00121Ar 2               ; 74) in P1's trail color, with a single white lead pixel at its rightmost
00121Ar 2               ; end, closest to P2's line, so the two read as racing toward each other
00121Ar 2               ; across the gap between the words. White outright, not a brighter tint of
00121Ar 2               ; the trail color -- a picked color's "bright" tier (used by the head
00121Ar 2               ; sprites) is sometimes identical to its own trail color (light blue/light
00121Ar 2               ; yellow have no brighter tier above them), which made the lead invisible
00121Ar 2               ; for those picks. The body is columns 72-127 and the lead pixel 128.
00121Ar 2               ; Erases first, so the line comes out the same whatever was there.
00121Ar 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_COLOR, TEXT_ROW_I, TEXT_COL_I,
00121Ar 2               ;   plus everything PixelSet/PixelClear clobber
00121Ar 2               ; -----------------------------------------------------------------------------
00121Ar 2               DrawP1Underline:
00121Ar 2  A9 01          lda #1
00121Cr 2  85 75          sta TEXT_ROW_I
00121Er 2  A9 39          lda #57
001220r 2  85 76          sta TEXT_COL_I
001222r 2  A9 4A          lda #74
001224r 2  A2 48          ldx #72
001226r 2  20 rr rr       jsr EraseRect
001229r 2               
001229r 2  A4 64          ldy P1_TRAIL_COLOR
00122Br 2  84 71          sty TEXT_COLOR
00122Dr 2  64 76          stz TEXT_COL_I
00122Fr 2               @bodyLoop:
00122Fr 2  A5 76          lda TEXT_COL_I
001231r 2  18             clc
001232r 2  69 48          adc #72
001234r 2  AA             tax
001235r 2  A9 4A          lda #74
001237r 2  A4 71          ldy TEXT_COLOR
001239r 2  20 rr rr       jsr PixelSet
00123Cr 2  E6 76          inc TEXT_COL_I
00123Er 2  A5 76          lda TEXT_COL_I
001240r 2  C9 38          cmp #56                     ; body is cols 72-127; the lead pixel is at 128
001242r 2  D0 EB          bne @bodyLoop
001244r 2               
001244r 2  A9 4A          lda #74
001246r 2  A2 80          ldx #128
001248r 2  A0 0F          ldy #TMS_WHITE
00124Ar 2  20 rr rr       jsr PixelSet
00124Dr 2  60             rts
00124Er 2               
00124Er 2               ; -----------------------------------------------------------------------------
00124Er 2               ; DrawP2Underline - same idea as DrawP1Underline, for the line beneath
00124Er 2               ; "DUEL" (row 74) in P2's trail color. Its white lead pixel is at the
00124Er 2               ; LEFTMOST end instead -- P2's line faces P1's across the gap, so the lead
00124Er 2               ; has to point the other way for the two to race toward each other rather
00124Er 2               ; than both pointing right. The lead pixel is column 143, in the gap
00124Er 2               ; between the words, and the body spans the word's full width at 144-189.
00124Er 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_COLOR, TEXT_ROW_I, TEXT_COL_I,
00124Er 2               ;   plus everything PixelSet/PixelClear clobber
00124Er 2               ; -----------------------------------------------------------------------------
00124Er 2               DrawP2Underline:
00124Er 2  A9 01          lda #1
001250r 2  85 75          sta TEXT_ROW_I
001252r 2  A9 2F          lda #47
001254r 2  85 76          sta TEXT_COL_I
001256r 2  A9 4A          lda #74
001258r 2  A2 8F          ldx #143
00125Ar 2  20 rr rr       jsr EraseRect
00125Dr 2               
00125Dr 2  A9 4A          lda #74
00125Fr 2  A2 8F          ldx #143
001261r 2  A0 0F          ldy #TMS_WHITE
001263r 2  20 rr rr       jsr PixelSet
001266r 2               
001266r 2  A4 65          ldy P2_TRAIL_COLOR
001268r 2  84 71          sty TEXT_COLOR
00126Ar 2  A9 01          lda #1
00126Cr 2  85 76          sta TEXT_COL_I
00126Er 2               @bodyLoop:
00126Er 2  A5 76          lda TEXT_COL_I
001270r 2  18             clc
001271r 2  69 8F          adc #143
001273r 2  AA             tax
001274r 2  A9 4A          lda #74
001276r 2  A4 71          ldy TEXT_COLOR
001278r 2  20 rr rr       jsr PixelSet
00127Br 2  E6 76          inc TEXT_COL_I
00127Dr 2  A5 76          lda TEXT_COL_I
00127Fr 2  C9 2F          cmp #47
001281r 2  D0 EB          bne @bodyLoop
001283r 2  60             rts
001284r 2               
001284r 2               ; -----------------------------------------------------------------------------
001284r 2               ; DrawGameOverScreen - per Jay: the win screen IS the gameplay screen, with
001284r 2               ; the result text drawn directly on top of the frozen final trail
001284r 2               ; positions. No full clear -- draws straight into whatever is already in
001284r 2               ; the arena. A (or space) returns to the title screen, where
001284r 2               ; DrawTitleScreen's own full wipe takes over.
001284r 2               ; Erases a margin around its own text first, though (unlike the rest of
001284r 2               ; the frozen field, which is deliberately left alone) -- the result text
001284r 2               ; lands wherever the round happened to end, maybe right across a trail.
001284r 2               ; The erase box is padded well past the glyphs themselves (not just their
001284r 2               ; tight bounding box) so the text reads as sitting in its own clear space
001284r 2               ; instead of packed right up against whatever trail happened to end nearby.
001284r 2               ; Vertically centered on the 192px-tall field (row 93, so the 7px-tall
001284r 2               ; glyphs sit on rows 93-99, centered on row 96) rather than a fixed row
001284r 2               ; that happened to work for one particular round's trail shapes.
001284r 2               ; Hides both head sprites first -- the frozen trails are deliberate,
001284r 2               ; but the crash never reaches UpdateHeadSprites's "both alive" branch
001284r 2               ; (see ResolveRound), so without this a dead player's sprite is left
001284r 2               ; showing at its last pre-crash position instead of hidden, floating
001284r 2               ; uselessly next to the actual crash site drawn in the arena.
001284r 2               ; -----------------------------------------------------------------------------
001284r 2               DrawGameOverScreen:
001284r 2  20 rr rr       jsr InitHeadSprites
001287r 2               
001287r 2  A5 61          lda ROUND_RESULT
001289r 2  C9 03          cmp #3
00128Br 2  90 0E          bcc @winner
00128Dr 2  A2 rr          ldx #<WinnerDraw
00128Fr 2  A0 rr          ldy #>WinnerDraw
001291r 2  C9 03          cmp #3
001293r 2  F0 29          beq @haveWinner
001295r 2  A2 rr          ldx #<TxtOutOfSync             ; RESULT_SYNC: two linked machines disagreed
001297r 2  A0 rr          ldy #>TxtOutOfSync
001299r 2  80 23          bra @haveWinner
00129Br 2               @winner:
00129Br 2  A6 3B          ldx GAME_MODE
00129Dr 2  E0 02          cpx #MODE_LINK
00129Fr 2  F0 0E          beq @link
0012A1r 2  A2 rr          ldx #<WinnerP1
0012A3r 2  A0 rr          ldy #>WinnerP1
0012A5r 2  C9 01          cmp #1
0012A7r 2  F0 15          beq @haveWinner
0012A9r 2  A2 rr          ldx #<WinnerP2
0012ABr 2  A0 rr          ldy #>WinnerP2
0012ADr 2  80 0F          bra @haveWinner
0012AFr 2               @link:
0012AFr 2  38             sec                             ; the winner's seat is ROUND_RESULT - 1
0012B0r 2  E9 01          sbc #1
0012B2r 2  A2 rr          ldx #<TxtYouWin
0012B4r 2  A0 rr          ldy #>TxtYouWin
0012B6r 2  C5 91          cmp MY_SEAT
0012B8r 2  F0 04          beq @haveWinner
0012BAr 2  A2 rr          ldx #<TxtYouLose
0012BCr 2  A0 rr          ldy #>TxtYouLose
0012BEr 2               @haveWinner:
0012BEr 2  DA             phx
0012BFr 2  5A             phy
0012C0r 2               
0012C0r 2  A9 13          lda #19                   ; 7px glyph height + 6px margin top/bottom
0012C2r 2  85 75          sta TEXT_ROW_I
0012C4r 2  A9 62          lda #98                   ; 78px longest string ("PLAYER 1/2 WINS", 13
0012C6r 2  85 76          sta TEXT_COL_I              ; chars x 6px) + 10px margin each side
0012C8r 2  A9 57          lda #87
0012CAr 2  A2 4F          ldx #79
0012CCr 2  20 rr rr       jsr EraseRect
0012CFr 2               
0012CFr 2  7A             ply
0012D0r 2  FA             plx
0012D1r 2  A9 5D          lda #93
0012D3r 2  20 rr rr       jsr CenterText
0012D6r 2                 ; falls through
0012D6r 2               
0012D6r 2               ; RoundSting - the win sting when a person at this machine won the round, the
0012D6r 2               ; draw's otherwise: a double crash, the CPU winning, or the other machine's
0012D6r 2               ; player in a link.
0012D6r 2               RoundSting:
0012D6r 2  A5 61          lda ROUND_RESULT
0012D8r 2  C9 01          cmp #1
0012DAr 2  F0 14          beq @first
0012DCr 2  C9 02          cmp #2
0012DEr 2  D0 1A          bne @draw
0012E0r 2  A5 3B          lda GAME_MODE                   ; the second rider won
0012E2r 2  C9 00          cmp #MODE_1P
0012E4r 2  F0 14          beq @draw
0012E6r 2  C9 02          cmp #MODE_LINK
0012E8r 2  D0 13          bne @win
0012EAr 2  A5 91          lda MY_SEAT
0012ECr 2  D0 0F          bne @win
0012EEr 2  80 0A          bra @draw
0012F0r 2               @first:
0012F0r 2  A5 3B          lda GAME_MODE
0012F2r 2  C9 02          cmp #MODE_LINK
0012F4r 2  D0 07          bne @win
0012F6r 2  A5 91          lda MY_SEAT
0012F8r 2  F0 03          beq @win
0012FAr 2               @draw:
0012FAr 2  4C rr rr       jmp SndDraw
0012FDr 2               @win:
0012FDr 2  4C rr rr       jmp SndWin
001300r 2               
001300r 2               ; CenterText - the string X (low), Y (high) in white on row A, centered
001300r 2               ; across the screen. Clobbers what DrawText does.
001300r 2               CenterText:
001300r 2  85 6F          sta TEXT_ROW
001302r 2  86 78          stx TEXT_STR_PTR
001304r 2  84 79          sty TEXT_STR_PTR+1
001306r 2  A0 00          ldy #0
001308r 2               @len:
001308r 2  B1 78          lda (TEXT_STR_PTR),y
00130Ar 2  F0 03          beq @counted
00130Cr 2  C8             iny
00130Dr 2  80 F9          bra @len
00130Fr 2               @counted:
00130Fr 2  84 70          sty TEXT_COL                    ; 6 pixels a character: start half of
001311r 2  98             tya                             ; that left of the middle
001312r 2  0A             asl a
001313r 2  18             clc
001314r 2  65 70          adc TEXT_COL
001316r 2  85 70          sta TEXT_COL
001318r 2  A9 80          lda #128
00131Ar 2  38             sec
00131Br 2  E5 70          sbc TEXT_COL
00131Dr 2  85 70          sta TEXT_COL
00131Fr 2  A9 0F          lda #TMS_WHITE
001321r 2  85 71          sta TEXT_COLOR
001323r 2  4C rr rr       jmp DrawText
001326r 2               
001326r 2               ; -----------------------------------------------------------------------------
001326r 2               ; The title's menu: MODE, SPEED and each player's color, one to a line.
001326r 2               ; Up and down (either stick, W/S or the arrows) move the arrows from line to
001326r 2               ; line; left and right change the line they're on. A color shows as a swatch
001326r 2               ; drawn in that player's value, so a new pick recolors it through the palette
001326r 2               ; with nothing to redraw.
001326r 2               ; -----------------------------------------------------------------------------
001326r 2               MENU_LABEL_END = 128              ; the labels end here
001326r 2               MENU_VALUE     = 140              ; and the values start here
001326r 2               MENU_WIDTH     = 36               ; the widest value, NORMAL
001326r 2               MENU_LEFT      = 134              ; the arrows' columns
001326r 2               MENU_RIGHT     = MENU_VALUE + MENU_WIDTH + 3
001326r 2               
001326r 2               MenuRowY:
001326r 2  5A 65 70 7B    .byte 90, 101, 112, 123
00132Ar 2               MenuLabels:
00132Ar 2  rr rr rr rr    .word ModeLabel, SpeedLabel, P1ColorLabel, P2ColorLabel
00132Er 2  rr rr rr rr  
001332r 2               ModeNames:
001332r 2  rr rr rr rr    .word Mode1P, Mode2P, ModeLink
001336r 2  rr rr        
001338r 2               SpeedNames:
001338r 2  rr rr rr rr    .word SpeedSlow, SpeedNormal, SpeedFast
00133Cr 2  rr rr        
00133Er 2               DirBits:                          ; DIR_UP, DIR_DOWN, DIR_LEFT, DIR_RIGHT
00133Er 2  10 20 40 80    .byte JOY_UP, JOY_DOWN, JOY_LEFT, JOY_RIGHT
001342r 2               
001342r 2               ; DrawMenu - every line, and the arrows on MENU_ROW.
001342r 2               DrawMenu:
001342r 2  A2 00          ldx #0
001344r 2               @line:
001344r 2  DA             phx
001345r 2  8A             txa
001346r 2  0A             asl a
001347r 2  A8             tay
001348r 2  B9 rr rr       lda MenuLabels,y
00134Br 2  85 78          sta TEXT_STR_PTR
00134Dr 2  B9 rr rr       lda MenuLabels+1,y
001350r 2  85 79          sta TEXT_STR_PTR+1
001352r 2  20 rr rr       jsr TextLength                  ; right-aligned to MENU_LABEL_END
001355r 2  85 70          sta TEXT_COL
001357r 2  0A             asl a
001358r 2  18             clc
001359r 2  65 70          adc TEXT_COL
00135Br 2  0A             asl a                           ; 6 pixels a character
00135Cr 2  49 FF          eor #$FF
00135Er 2  38             sec
00135Fr 2  69 80          adc #MENU_LABEL_END
001361r 2  85 70          sta TEXT_COL
001363r 2  BD rr rr       lda MenuRowY,x
001366r 2  85 6F          sta TEXT_ROW
001368r 2  A9 0F          lda #TMS_WHITE
00136Ar 2  85 71          sta TEXT_COLOR
00136Cr 2  20 rr rr       jsr DrawText
00136Fr 2  68             pla
001370r 2  48             pha
001371r 2  20 rr rr       jsr DrawValue
001374r 2  FA             plx
001375r 2  E8             inx
001376r 2  E0 04          cpx #MENU_ROWS
001378r 2  D0 CA          bne @line
00137Ar 2  A5 C0          lda MENU_ROW
00137Cr 2  4C rr rr       jmp ShowArrows
00137Fr 2               
00137Fr 2               ; TextLength - A = the length of the string at TEXT_STR_PTR. Keeps X.
00137Fr 2               TextLength:
00137Fr 2  A0 00          ldy #0
001381r 2               @char:
001381r 2  B1 78          lda (TEXT_STR_PTR),y
001383r 2  F0 03          beq @done
001385r 2  C8             iny
001386r 2  80 F9          bra @char
001388r 2               @done:
001388r 2  98             tya
001389r 2  60             rts
00138Ar 2               
00138Ar 2               ; DrawValue - line A's value, over whatever was there.
00138Ar 2               DrawValue:
00138Ar 2  48             pha
00138Br 2  AA             tax
00138Cr 2  BD rr rr       lda MenuRowY,x
00138Fr 2  85 6F          sta TEXT_ROW
001391r 2  A9 07          lda #7
001393r 2  85 75          sta TEXT_ROW_I
001395r 2  A9 24          lda #MENU_WIDTH
001397r 2  85 76          sta TEXT_COL_I
001399r 2  A5 6F          lda TEXT_ROW
00139Br 2  A2 8C          ldx #MENU_VALUE
00139Dr 2  20 rr rr       jsr EraseRect
0013A0r 2  68             pla
0013A1r 2  C9 02          cmp #MENU_P1
0013A3r 2  B0 2D          bcs @swatch
0013A5r 2  A6 3B          ldx GAME_MODE
0013A7r 2  C9 00          cmp #MENU_MODE
0013A9r 2  F0 0F          beq @name
0013ABr 2  A6 C3          ldx SPEED
0013ADr 2  8A             txa
0013AEr 2  0A             asl a
0013AFr 2  A8             tay
0013B0r 2  B9 rr rr       lda SpeedNames,y
0013B3r 2  85 78          sta TEXT_STR_PTR
0013B5r 2  B9 rr rr       lda SpeedNames+1,y
0013B8r 2  80 0B          bra @text
0013BAr 2               @name:
0013BAr 2  8A             txa
0013BBr 2  0A             asl a
0013BCr 2  A8             tay
0013BDr 2  B9 rr rr       lda ModeNames,y
0013C0r 2  85 78          sta TEXT_STR_PTR
0013C2r 2  B9 rr rr       lda ModeNames+1,y
0013C5r 2               @text:
0013C5r 2  85 79          sta TEXT_STR_PTR+1
0013C7r 2  A9 8C          lda #MENU_VALUE
0013C9r 2  85 70          sta TEXT_COL
0013CBr 2  A9 0F          lda #TMS_WHITE
0013CDr 2  85 71          sta TEXT_COLOR
0013CFr 2  4C rr rr       jmp DrawText
0013D2r 2               @swatch:
0013D2r 2  A4 64          ldy P1_TRAIL_COLOR
0013D4r 2  C9 02          cmp #MENU_P1
0013D6r 2  F0 02          beq @drawSwatch
0013D8r 2  A4 65          ldy P2_TRAIL_COLOR
0013DAr 2               @drawSwatch:
0013DAr 2  A5 6F          lda TEXT_ROW
0013DCr 2  A2 8C          ldx #MENU_VALUE
0013DEr 2  4C rr rr       jmp DrawColorSwatch
0013E1r 2               
0013E1r 2               ; ShowArrows / HideArrows - the left and right arrows either side of line A's
0013E1r 2               ; value.
0013E1r 2               ShowArrows:
0013E1r 2  AA             tax
0013E2r 2  BD rr rr       lda MenuRowY,x
0013E5r 2  1A             inc a
0013E6r 2  48             pha
0013E7r 2  A2 86          ldx #MENU_LEFT
0013E9r 2  A0 0F          ldy #TMS_WHITE
0013EBr 2  20 rr rr       jsr DrawLeftTriangle
0013EEr 2  68             pla
0013EFr 2  A2 B3          ldx #MENU_RIGHT
0013F1r 2  A0 0F          ldy #TMS_WHITE
0013F3r 2  4C rr rr       jmp DrawRightTriangle
0013F6r 2               
0013F6r 2               HideArrows:
0013F6r 2  AA             tax
0013F7r 2  BD rr rr       lda MenuRowY,x
0013FAr 2  1A             inc a
0013FBr 2  48             pha
0013FCr 2  A9 05          lda #5
0013FEr 2  85 75          sta TEXT_ROW_I
001400r 2  A9 03          lda #3
001402r 2  85 76          sta TEXT_COL_I
001404r 2  68             pla
001405r 2  48             pha
001406r 2  A2 86          ldx #MENU_LEFT
001408r 2  20 rr rr       jsr EraseRect
00140Br 2  A9 05          lda #5
00140Dr 2  85 75          sta TEXT_ROW_I
00140Fr 2  A9 03          lda #3
001411r 2  85 76          sta TEXT_COL_I
001413r 2  68             pla
001414r 2  A2 B3          ldx #MENU_RIGHT
001416r 2  4C rr rr       jmp EraseRect
001419r 2               
001419r 2               ; MenuInput - a step for each new press of up, down, left or right on either
001419r 2               ; stick or key cluster.
001419r 2               MenuInput:
001419r 2  A5 3E          lda JOY_STATE                   ; active low: held on either stick
00141Br 2  25 4F          and JOY_STATE2
00141Dr 2  49 FF          eor #$FF
00141Fr 2  29 F0          and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
001421r 2  85 6B          sta PICKER_TMP
001423r 2  A6 68          ldx KB_DIR_P1                   ; and keys seen this tick
001425r 2  20 rr rr       jsr KeyBit
001428r 2  A6 69          ldx KB_DIR_P2
00142Ar 2  20 rr rr       jsr KeyBit
00142Dr 2  A5 C2          lda MENU_PREV                   ; only what wasn't held last tick
00142Fr 2  49 FF          eor #$FF
001431r 2  25 6B          and PICKER_TMP
001433r 2  A6 6B          ldx PICKER_TMP
001435r 2  86 C2          stx MENU_PREV
001437r 2  89 10          bit #JOY_UP
001439r 2  D0 0D          bne @up
00143Br 2  89 20          bit #JOY_DOWN
00143Dr 2  D0 18          bne @down
00143Fr 2  89 40          bit #JOY_LEFT
001441r 2  D0 2B          bne @left
001443r 2  89 80          bit #JOY_RIGHT
001445r 2  D0 3B          bne @right
001447r 2  60             rts
001448r 2               @up:
001448r 2  A5 C0          lda MENU_ROW
00144Ar 2  20 rr rr       jsr HideArrows
00144Dr 2  C6 C0          dec MENU_ROW
00144Fr 2  10 15          bpl @moved
001451r 2  A9 03          lda #MENU_ROWS - 1
001453r 2  85 C0          sta MENU_ROW
001455r 2  80 0F          bra @moved
001457r 2               @down:
001457r 2  A5 C0          lda MENU_ROW
001459r 2  20 rr rr       jsr HideArrows
00145Cr 2  E6 C0          inc MENU_ROW
00145Er 2  A5 C0          lda MENU_ROW
001460r 2  C9 04          cmp #MENU_ROWS
001462r 2  90 02          bcc @moved
001464r 2  64 C0          stz MENU_ROW
001466r 2               @moved:
001466r 2  20 rr rr       jsr SndSelect
001469r 2  A5 C0          lda MENU_ROW
00146Br 2  4C rr rr       jmp ShowArrows
00146Er 2               @left:
00146Er 2  A5 C0          lda MENU_ROW
001470r 2  C9 02          cmp #MENU_P1
001472r 2  D0 03          bne @notP1Left
001474r 2  4C rr rr       jmp DecP1Color
001477r 2               @notP1Left:
001477r 2  C9 03          cmp #MENU_P2
001479r 2  D0 03          bne @notP2Left
00147Br 2  4C rr rr       jmp DecP2Color
00147Er 2               @notP2Left:
00147Er 2  A9 FF          lda #$FF                        ; one back
001480r 2  80 12          bra @change
001482r 2               @right:
001482r 2  A5 C0          lda MENU_ROW
001484r 2  C9 02          cmp #MENU_P1
001486r 2  D0 03          bne @notP1Right
001488r 2  4C rr rr       jmp IncP1Color
00148Br 2               @notP1Right:
00148Br 2  C9 03          cmp #MENU_P2
00148Dr 2  D0 03          bne @notP2Right
00148Fr 2  4C rr rr       jmp IncP2Color
001492r 2               @notP2Right:
001492r 2  A9 01          lda #1                          ; one on
001494r 2               @change:
001494r 2  A6 C0          ldx MENU_ROW                    ; MODE or SPEED, three choices each, round
001496r 2  D0 0A          bne @speed
001498r 2  18             clc
001499r 2  65 3B          adc GAME_MODE
00149Br 2  20 rr rr       jsr Wrap3
00149Er 2  85 3B          sta GAME_MODE
0014A0r 2  80 08          bra @changed
0014A2r 2               @speed:
0014A2r 2  18             clc
0014A3r 2  65 C3          adc SPEED
0014A5r 2  20 rr rr       jsr Wrap3
0014A8r 2  85 C3          sta SPEED
0014AAr 2               @changed:
0014AAr 2  20 rr rr       jsr SndSelect
0014ADr 2  A5 C0          lda MENU_ROW
0014AFr 2  4C rr rr       jmp DrawValue
0014B2r 2               
0014B2r 2               ; Wrap3 - A, one past either end of 0-2, back round.
0014B2r 2               Wrap3:
0014B2r 2  10 03          bpl @notUnder
0014B4r 2  A9 02          lda #2
0014B6r 2  60             rts
0014B7r 2               @notUnder:
0014B7r 2  C9 03          cmp #3
0014B9r 2  90 02          bcc @done
0014BBr 2  A9 00          lda #0
0014BDr 2               @done:
0014BDr 2  60             rts
0014BEr 2               
0014BEr 2               ; KeyBit - the joystick bit for key direction X (a DIR_*, or KB_DIR_NONE) into
0014BEr 2               ; PICKER_TMP.
0014BEr 2               KeyBit:
0014BEr 2  E0 FF          cpx #KB_DIR_NONE
0014C0r 2  F0 07          beq @none
0014C2r 2  BD rr rr       lda DirBits,x
0014C5r 2  05 6B          ora PICKER_TMP
0014C7r 2  85 6B          sta PICKER_TMP
0014C9r 2               @none:
0014C9r 2  60             rts
0014CAr 2               
0014CAr 2               ; -----------------------------------------------------------------------------
0014CAr 2               ; IncP1Color/DecP1Color/IncP2Color/DecP2Color - cycle a player's trail
0014CAr 2               ; color index, skipping past whatever the OTHER player currently has
0014CAr 2               ; selected. Same-colored trails are only distinguishable by the head
0014CAr 2               ; sprites (both flat white, independent of trail color), not by the
0014CAr 2               ; trail itself, so letting both players land on the same color is a real
0014CAr 2               ; way to confuse yourself for no benefit -- worth blocking outright rather
0014CAr 2               ; than leaving it as a footgun, since 6 of 7 colors are still available
0014CAr 2               ; either way. Only ever skips one extra step: landing on a clash after a
0014CAr 2               ; single +1/-1 move can only happen once before moving away from it.
0014CAr 2               ; -----------------------------------------------------------------------------
0014CAr 2               IncP1Color:
0014CAr 2  20 rr rr       jsr SndSelect
0014CDr 2  A5 62          lda P1_COLOR_IDX
0014CFr 2  C9 06          cmp #6
0014D1r 2  D0 04          bne @p1Inc
0014D3r 2  64 62          stz P1_COLOR_IDX
0014D5r 2  80 02          bra @p1Clash
0014D7r 2               @p1Inc:
0014D7r 2  E6 62          inc P1_COLOR_IDX
0014D9r 2               @p1Clash:
0014D9r 2  A5 62          lda P1_COLOR_IDX
0014DBr 2  C5 63          cmp P2_COLOR_IDX
0014DDr 2  D0 0D          bne @p1Done
0014DFr 2  A5 62          lda P1_COLOR_IDX
0014E1r 2  C9 06          cmp #6
0014E3r 2  D0 05          bne @p1Inc2
0014E5r 2  64 62          stz P1_COLOR_IDX
0014E7r 2  4C rr rr       jmp ApplySelectedTrailColors
0014EAr 2               @p1Inc2:
0014EAr 2  E6 62          inc P1_COLOR_IDX
0014ECr 2               @p1Done:
0014ECr 2  4C rr rr       jmp ApplySelectedTrailColors
0014EFr 2               
0014EFr 2               DecP1Color:
0014EFr 2  20 rr rr       jsr SndSelect
0014F2r 2  A5 62          lda P1_COLOR_IDX
0014F4r 2  D0 06          bne @p1Dec
0014F6r 2  A9 06          lda #6
0014F8r 2  85 62          sta P1_COLOR_IDX
0014FAr 2  80 02          bra @p1Clash
0014FCr 2               @p1Dec:
0014FCr 2  C6 62          dec P1_COLOR_IDX
0014FEr 2               @p1Clash:
0014FEr 2  A5 62          lda P1_COLOR_IDX
001500r 2  C5 63          cmp P2_COLOR_IDX
001502r 2  D0 0D          bne @p1Done
001504r 2  A5 62          lda P1_COLOR_IDX
001506r 2  D0 07          bne @p1Dec2
001508r 2  A9 06          lda #6
00150Ar 2  85 62          sta P1_COLOR_IDX
00150Cr 2  4C rr rr       jmp ApplySelectedTrailColors
00150Fr 2               @p1Dec2:
00150Fr 2  C6 62          dec P1_COLOR_IDX
001511r 2               @p1Done:
001511r 2  4C rr rr       jmp ApplySelectedTrailColors
001514r 2               
001514r 2               IncP2Color:
001514r 2  20 rr rr       jsr SndSelect
001517r 2  A5 63          lda P2_COLOR_IDX
001519r 2  C9 06          cmp #6
00151Br 2  D0 04          bne @p2Inc
00151Dr 2  64 63          stz P2_COLOR_IDX
00151Fr 2  80 02          bra @p2Clash
001521r 2               @p2Inc:
001521r 2  E6 63          inc P2_COLOR_IDX
001523r 2               @p2Clash:
001523r 2  A5 63          lda P2_COLOR_IDX
001525r 2  C5 62          cmp P1_COLOR_IDX
001527r 2  D0 0D          bne @p2Done
001529r 2  A5 63          lda P2_COLOR_IDX
00152Br 2  C9 06          cmp #6
00152Dr 2  D0 05          bne @p2Inc2
00152Fr 2  64 63          stz P2_COLOR_IDX
001531r 2  4C rr rr       jmp ApplySelectedTrailColors
001534r 2               @p2Inc2:
001534r 2  E6 63          inc P2_COLOR_IDX
001536r 2               @p2Done:
001536r 2  4C rr rr       jmp ApplySelectedTrailColors
001539r 2               
001539r 2               DecP2Color:
001539r 2  20 rr rr       jsr SndSelect
00153Cr 2  A5 63          lda P2_COLOR_IDX
00153Er 2  D0 06          bne @p2Dec
001540r 2  A9 06          lda #6
001542r 2  85 63          sta P2_COLOR_IDX
001544r 2  80 02          bra @p2Clash
001546r 2               @p2Dec:
001546r 2  C6 63          dec P2_COLOR_IDX
001548r 2               @p2Clash:
001548r 2  A5 63          lda P2_COLOR_IDX
00154Ar 2  C5 62          cmp P1_COLOR_IDX
00154Cr 2  D0 0D          bne @p2Done
00154Er 2  A5 63          lda P2_COLOR_IDX
001550r 2  D0 07          bne @p2Dec2
001552r 2  A9 06          lda #6
001554r 2  85 63          sta P2_COLOR_IDX
001556r 2  4C rr rr       jmp ApplySelectedTrailColors
001559r 2               @p2Dec2:
001559r 2  C6 63          dec P2_COLOR_IDX
00155Br 2               @p2Done:
00155Br 2  4C rr rr       jmp ApplySelectedTrailColors
00155Er 2               
00155Er 2               ApplySelectedTrailColors:
00155Er 2  A6 62          ldx P1_COLOR_IDX
001560r 2  BD rr rr       lda TrailFgColorTable,x
001563r 2  85 64          sta P1_TRAIL_COLOR
001565r 2               
001565r 2  A6 63          ldx P2_COLOR_IDX
001567r 2  BD rr rr       lda TrailFgColorTable,x
00156Ar 2  85 65          sta P2_TRAIL_COLOR
00156Cr 2  4C rr rr       jmp SetPalette
00156Fr 2               
00156Fr 2               TitleLine1:
00156Fr 2  54 52 41 49    .byte "TRAIL DUEL",0
001573r 2  4C 20 44 55  
001577r 2  45 4C 00     
00157Ar 2               
00157Ar 2               TitleLine4:
00157Ar 2  41 3A 20 53    .byte "A: START",0
00157Er 2  54 41 52 54  
001582r 2  00           
001583r 2               
001583r 2               WinnerP1:
001583r 2  50 4C 41 59    .byte "PLAYER 1 WINS",0
001587r 2  45 52 20 31  
00158Br 2  20 57 49 4E  
001591r 2               
001591r 2               WinnerP2:
001591r 2  50 4C 41 59    .byte "PLAYER 2 WINS",0
001595r 2  45 52 20 32  
001599r 2  20 57 49 4E  
00159Fr 2               
00159Fr 2               WinnerDraw:
00159Fr 2  44 4F 55 42    .byte "DOUBLE CRASH",0
0015A3r 2  4C 45 20 43  
0015A7r 2  52 41 53 48  
0015ACr 2               
0015ACr 2               ModeLabel:
0015ACr 2  4D 4F 44 45    .byte "MODE:",0
0015B0r 2  3A 00        
0015B2r 2               SpeedLabel:
0015B2r 2  53 50 45 45    .byte "SPEED:",0
0015B6r 2  44 3A 00     
0015B9r 2               Mode1P:
0015B9r 2  31 50 00       .byte "1P",0
0015BCr 2               Mode2P:
0015BCr 2  32 50 00       .byte "2P",0
0015BFr 2               ModeLink:
0015BFr 2  4C 49 4E 4B    .byte "LINK",0
0015C3r 2  00           
0015C4r 2               SpeedSlow:
0015C4r 2  53 4C 4F 57    .byte "SLOW",0
0015C8r 2  00           
0015C9r 2               SpeedNormal:
0015C9r 2  4E 4F 52 4D    .byte "NORMAL",0
0015CDr 2  41 4C 00     
0015D0r 2               SpeedFast:
0015D0r 2  46 41 53 54    .byte "FAST",0
0015D4r 2  00           
0015D5r 2               
