0015D5r 2  59 4F 55 20    .byte "YOU WIN",0
0015D9r 2  57 49 4E 00  
0015DDr 2               
0015DDr 2               TxtYouLose:
0015DDr 2  59 4F 55 20    .byte "YOU LOSE",0
0015E1r 2  4C 4F 53 45  
0015E5r 2  00           
0015E6r 2               
0015E6r 2               TxtOutOfSync:
0015E6r 2  4F 55 54 20    .byte "OUT OF SYNC",0
0015EAr 2  4F 46 20 53  
0015EEr 2  59 4E 43 00  
0015F2r 2               
0015F2r 2               P1ColorLabel:
0015F2r 2  50 31 3A 00    .byte "P1:",0
0015F6r 2               
0015F6r 2               P2ColorLabel:
0015F6r 2  50 32 3A 00    .byte "P2:",0
0015FAr 2               
0015FAr 2               ; One saturated, vivid shade per hue -- rendered every candidate shade to
0015FAr 2               ; the screen and looked at them side by side rather than going by name.
0015FAr 2               ; Result: for red and yellow specifically, the "light" tier is the pastel
0015FAr 2               ; one (salmon, pale khaki) and the "medium"/"dark" tier is the more vivid,
0015FAr 2               ; saturated look (true red, golden yellow) -- backwards from what the
0015FAr 2               ; names suggest. Blue's the exception: LT_BLUE reads as a rich periwinkle,
0015FAr 2               ; not pastel, so it stays over DK_BLUE. Green only offers MED_GREEN as the
0015FAr 2               ; vivid pick over the minty LT_GREEN. CYAN and MAGENTA only come in one
0015FAr 2               ; (already vivid) shade. GRAY rounds it out as a neutral -- WHITE was
0015FAr 2               ; considered too, but it's close enough to GRAY to not read as a distinct
0015FAr 2               ; option, and would've meant the lead pixel/head sprite (both hardcoded
0015FAr 2               ; white) blending into that one trail color instead of standing out.
0015FAr 2               TrailFgColorTable:
0015FAr 2  08 0A 02 07    .byte TMS_MED_RED, TMS_DK_YELLOW, TMS_MED_GREEN, TMS_CYAN, TMS_LT_BLUE, TMS_MAGENTA, TMS_GRAY
0015FEr 2  05 0D 0E     
001601r 2               
001601r 2               ; -----------------------------------------------------------------------------
001601r 2               ; ApplyRequestedTurns - each rider takes the heading asked for at once, unless
001601r 2               ; it's straight back the way it came (DIR_UP/DIR_DOWN and DIR_LEFT/DIR_RIGHT
001601r 2               ; differ only in bit 0). A person's turn blips; the CPU's doesn't.
001601r 2               ; -----------------------------------------------------------------------------
001601r 2               ApplyRequestedTurns:
001601r 2  A5 42          lda P1_DIR
001603r 2  49 01          eor #1                          ; straight back
001605r 2  C5 43          cmp P1_NEXT_DIR
001607r 2  F0 0B          beq @p2
001609r 2  A5 43          lda P1_NEXT_DIR
00160Br 2  C5 42          cmp P1_DIR
00160Dr 2  F0 05          beq @p2
00160Fr 2  85 42          sta P1_DIR
001611r 2  20 rr rr       jsr SndTurn
001614r 2               @p2:
001614r 2  A5 47          lda P2_DIR
001616r 2  49 01          eor #1
001618r 2  C5 48          cmp P2_NEXT_DIR
00161Ar 2  F0 11          beq @done
00161Cr 2  A5 48          lda P2_NEXT_DIR
00161Er 2  C5 47          cmp P2_DIR
001620r 2  F0 0B          beq @done
001622r 2  85 47          sta P2_DIR
001624r 2  A5 3B          lda GAME_MODE
001626r 2  C9 00          cmp #MODE_1P
001628r 2  F0 03          beq @done                       ; the CPU turns quietly
00162Ar 2  20 rr rr       jsr SndTurn
00162Dr 2               @done:
00162Dr 2  60             rts
00162Er 2               
00162Er 2               ; -----------------------------------------------------------------------------
00162Er 2               ; ComputeP2LeftTurn / ComputeP2RightTurn -- the 90-degree turn-candidate
00162Er 2               ; tables, factored out so ComputeP2AIDirection can try them in either
00162Er 2               ; order (see the coin flip there). In: P2_DIR. Out: A = the candidate
00162Er 2               ; direction for that turn from the current heading.
00162Er 2               ;
00162Er 2               ; Each case returns immediately after its lda instead of falling through
00162Er 2               ; to a shared exit via bne. The old inline right-turn table used that
00162Er 2               ; fall-through idiom and it broke for DIR_UP, which is 0: "lda #DIR_UP /
00162Er 2               ; bne @rightReady" never branches when A is 0, so the LEFT-heading case
00162Er 2               ; silently fell through into DIR_DOWN instead of DIR_UP -- P2 never even
00162Er 2               ; tried its "up" escape when heading left. Returning per-case avoids that
00162Er 2               ; class of bug rather than reproducing it here.
00162Er 2               ; -----------------------------------------------------------------------------
00162Er 2               ComputeP2LeftTurn:
00162Er 2  A5 47          lda P2_DIR
001630r 2  C9 00          cmp #DIR_UP
001632r 2  D0 03          bne @lNotUp
001634r 2  A9 02          lda #DIR_LEFT
001636r 2  60             rts
001637r 2               @lNotUp:
001637r 2  A5 47          lda P2_DIR
001639r 2  C9 01          cmp #DIR_DOWN
00163Br 2  D0 03          bne @lNotDown
00163Dr 2  A9 03          lda #DIR_RIGHT
00163Fr 2  60             rts
001640r 2               @lNotDown:
001640r 2  A5 47          lda P2_DIR
001642r 2  C9 02          cmp #DIR_LEFT
001644r 2  D0 03          bne @lNotLeft
001646r 2  A9 01          lda #DIR_DOWN
001648r 2  60             rts
001649r 2               @lNotLeft:
001649r 2  A9 00          lda #DIR_UP
00164Br 2  60             rts
00164Cr 2               
00164Cr 2               ComputeP2RightTurn:
00164Cr 2  A5 47          lda P2_DIR
00164Er 2  C9 00          cmp #DIR_UP
001650r 2  D0 03          bne @rNotUp
001652r 2  A9 03          lda #DIR_RIGHT
001654r 2  60             rts
001655r 2               @rNotUp:
001655r 2  A5 47          lda P2_DIR
001657r 2  C9 01          cmp #DIR_DOWN
001659r 2  D0 03          bne @rNotDown
00165Br 2  A9 02          lda #DIR_LEFT
00165Dr 2  60             rts
00165Er 2               @rNotDown:
00165Er 2  A5 47          lda P2_DIR
001660r 2  C9 02          cmp #DIR_LEFT
001662r 2  D0 03          bne @rNotLeft
001664r 2  A9 00          lda #DIR_UP
001666r 2  60             rts
001667r 2               @rNotLeft:
001667r 2  A9 01          lda #DIR_DOWN
001669r 2  60             rts
00166Ar 2               
00166Ar 2               ; -----------------------------------------------------------------------------
00166Ar 2               ; DirTowardP1 -- which of the two directions perpendicular to P2's
00166Ar 2               ; CURRENT heading closes the distance to P1 on the axis that matters.
00166Ar 2               ; P2_DIR horizontal -> compares Y (result is DIR_UP/DIR_DOWN). P2_DIR
00166Ar 2               ; vertical -> compares X (result is DIR_LEFT/DIR_RIGHT). Out: A = that
00166Ar 2               ; direction, or $FF if P1 is exactly level with P2 on that axis (no
00166Ar 2               ; preference either way).
00166Ar 2               ; -----------------------------------------------------------------------------
00166Ar 2               DirTowardP1:
00166Ar 2  A5 47          lda P2_DIR
00166Cr 2  C9 02          cmp #DIR_LEFT
00166Er 2  F0 20          beq @axisIsY
001670r 2  C9 03          cmp #DIR_RIGHT
001672r 2  F0 1C          beq @axisIsY
001674r 2               
001674r 2                 ; P2 currently vertical -- compare X, all 9 bits.
001674r 2  A5 40          lda P1_X
001676r 2  C5 45          cmp P2_X
001678r 2  D0 06          bne @xDiffer
00167Ar 2  A5 BB          lda P1_XH
00167Cr 2  C5 BC          cmp P2_XH
00167Er 2  F0 1E          beq @tied
001680r 2               @xDiffer:
001680r 2  A5 40          lda P1_X
001682r 2  C5 45          cmp P2_X
001684r 2  A5 BB          lda P1_XH
001686r 2  E5 BC          sbc P2_XH
001688r 2  90 03          bcc @wantLeft
00168Ar 2  A9 03          lda #DIR_RIGHT
00168Cr 2  60             rts
00168Dr 2               @wantLeft:
00168Dr 2  A9 02          lda #DIR_LEFT
00168Fr 2  60             rts
001690r 2               
001690r 2               @axisIsY:
001690r 2                 ; P2 currently horizontal -- compare Y.
001690r 2  A5 41          lda P1_Y
001692r 2  C5 46          cmp P2_Y
001694r 2  F0 08          beq @tied
001696r 2  90 03          bcc @wantUp
001698r 2  A9 01          lda #DIR_DOWN
00169Ar 2  60             rts
00169Br 2               @wantUp:
00169Br 2  A9 00          lda #DIR_UP
00169Dr 2  60             rts
00169Er 2               
00169Er 2               @tied:
00169Er 2  A9 FF          lda #$FF
0016A0r 2  60             rts
0016A1r 2               
0016A1r 2               ; -----------------------------------------------------------------------------
0016A1r 2               ; ComputeP2AIDirection -- picks P2_NEXT_DIR from three candidates:
0016A1r 2               ; continue straight, turn left, turn right.
0016A1r 2               ;
0016A1r 2               ; Continuing straight is preferred whenever it's safe -- but not
0016A1r 2               ; absolutely: about 1 time in 16, even a safe straight run gets
0016A1r 2               ; second-guessed and a turn is looked for anyway. Without this, P2 was a
0016A1r 2               ; pure wall-follower that never changed course unless a wall forced it
0016A1r 2               ; to, which is exactly what made it feel predictable and never actually
0016A1r 2               ; came at P1 -- it only ever reacted to geometry, never to the other
0016A1r 2               ; player.
0016A1r 2               ;
0016A1r 2               ; When a turn IS being considered (forced or not), left and right used
0016A1r 2               ; to be a flat coin flip. Now DirTowardP1 picks whichever turn actually
0016A1r 2               ; closes the distance to P1 on the relevant axis, and that's preferred
0016A1r 2               ; about 3 times out of 4 -- not always, since an AI that beelines for
0016A1r 2               ; the player with zero variance is its own kind of predictable, and the
0016A1r 2               ; remaining 1-in-4 (or ties, where neither side is objectively better)
0016A1r 2               ; falls back to the old plain coin flip.
0016A1r 2               ; -----------------------------------------------------------------------------
0016A1r 2               ComputeP2AIDirection:
0016A1r 2  A5 47          lda P2_DIR
0016A3r 2  85 5A          sta AI_DIR_TMP
0016A5r 2  20 rr rr       jsr IsDirectionSafeP2
0016A8r 2  90 07          bcc @pickTurn
0016AAr 2               
0016AAr 2                 ; Continuing straight is safe -- usually just take it, but roll a
0016AAr 2                 ; small chance to look for a turn anyway.
0016AAr 2  20 rr rr       jsr AdvanceRng
0016ADr 2  29 0F          and #$0F
0016AFr 2  D0 52          bne @keepCurrent
0016B1r 2               
0016B1r 2               @pickTurn:
0016B1r 2  20 rr rr       jsr DirTowardP1
0016B4r 2  85 81          sta AI_PREFERRED_DIR
0016B6r 2  C9 FF          cmp #$FF
0016B8r 2  F0 13          beq @coinFlip
0016BAr 2  20 rr rr       jsr AdvanceRng
0016BDr 2  29 03          and #3
0016BFr 2  C9 03          cmp #3
0016C1r 2  F0 0A          beq @coinFlip
0016C3r 2  20 rr rr       jsr ComputeP2LeftTurn
0016C6r 2  C5 81          cmp AI_PREFERRED_DIR
0016C8r 2  F0 09          beq @tryLeftFirst
0016CAr 2  4C rr rr       jmp @tryRightFirst
0016CDr 2               
0016CDr 2               @coinFlip:
0016CDr 2  20 rr rr       jsr AdvanceRng
0016D0r 2  4A             lsr a
0016D1r 2  B0 17          bcs @tryRightFirst
0016D3r 2               
0016D3r 2               @tryLeftFirst:
0016D3r 2  20 rr rr       jsr ComputeP2LeftTurn
0016D6r 2  85 5A          sta AI_DIR_TMP
0016D8r 2  20 rr rr       jsr IsDirectionSafeP2
0016DBr 2  B0 2B          bcs @useAiDir
0016DDr 2  20 rr rr       jsr ComputeP2RightTurn
0016E0r 2  85 5A          sta AI_DIR_TMP
0016E2r 2  20 rr rr       jsr IsDirectionSafeP2
0016E5r 2  B0 21          bcs @useAiDir
0016E7r 2  4C rr rr       jmp @noSafeTurn
0016EAr 2               
0016EAr 2               @tryRightFirst:
0016EAr 2  20 rr rr       jsr ComputeP2RightTurn
0016EDr 2  85 5A          sta AI_DIR_TMP
0016EFr 2  20 rr rr       jsr IsDirectionSafeP2
0016F2r 2  B0 14          bcs @useAiDir
0016F4r 2  20 rr rr       jsr ComputeP2LeftTurn
0016F7r 2  85 5A          sta AI_DIR_TMP
0016F9r 2  20 rr rr       jsr IsDirectionSafeP2
0016FCr 2  B0 0A          bcs @useAiDir
0016FEr 2               
0016FEr 2               @noSafeTurn:
0016FEr 2                 ; No safe turn found: keep current.
0016FEr 2  A5 47          lda P2_DIR
001700r 2  85 48          sta P2_NEXT_DIR
001702r 2  60             rts
001703r 2               
001703r 2               @keepCurrent:
001703r 2  A5 47          lda P2_DIR
001705r 2  85 48          sta P2_NEXT_DIR
001707r 2  60             rts
001708r 2               
001708r 2               @useAiDir:
001708r 2  A5 5A          lda AI_DIR_TMP
00170Ar 2  85 48          sta P2_NEXT_DIR
00170Cr 2  60             rts
00170Dr 2               
00170Dr 2               ; -----------------------------------------------------------------------------
00170Dr 2               ; IsDirectionSafeP2 - In: AI_DIR_TMP = candidate direction, from P2_X/P2_Y.
00170Dr 2               ; Out: carry set if safe, clear if not.
00170Dr 2               ; A turn is checked one pixel ahead. Carrying straight on is checked 8 pixels
00170Dr 2               ; ahead, so the CPU looks for a way out while there's still room to turn,
00170Dr 2               ; rather than twitching away a pixel from the wall, and does so the same on
00170Dr 2               ; either axis.
00170Dr 2               ; -----------------------------------------------------------------------------
00170Dr 2               IsDirectionSafeP2:
00170Dr 2  A5 45          lda P2_X
00170Fr 2  85 5B          sta AI_TEST_X
001711r 2  A5 BC          lda P2_XH
001713r 2  85 BF          sta AI_TEST_XH
001715r 2  A5 46          lda P2_Y
001717r 2  85 5C          sta AI_TEST_Y
001719r 2  A9 01          lda #1
00171Br 2  A6 5A          ldx AI_DIR_TMP
00171Dr 2  E4 47          cpx P2_DIR
00171Fr 2  D0 02          bne @steps
001721r 2  A9 08          lda #8
001723r 2               @steps:
001723r 2  85 77          sta SCAN_TMP2
001725r 2               @step:
001725r 2  A5 5A          lda AI_DIR_TMP
001727r 2  20 rr rr       jsr StepTest
00172Ar 2  A5 5C          lda AI_TEST_Y
00172Cr 2  C9 F0          cmp #240                        ; past the top wraps round to here too
00172Er 2  B0 11          bcs @blocked
001730r 2  A6 BF          ldx AI_TEST_XH
001732r 2  86 B8          stx PX_HI
001734r 2  A6 5B          ldx AI_TEST_X
001736r 2  20 rr rr       jsr PixelIsSet
001739r 2  D0 06          bne @blocked
00173Br 2  C6 77          dec SCAN_TMP2
00173Dr 2  D0 E6          bne @step
00173Fr 2  38             sec
001740r 2  60             rts
001741r 2               @blocked:
001741r 2  18             clc
001742r 2  60             rts
001743r 2               
001743r 2               ; StepTest - AI_TEST_X/AI_TEST_Y a pixel on in direction A (x with its
001743r 2               ; bit 8 in AI_TEST_XH).
001743r 2               StepTest:
001743r 2  C9 00          cmp #DIR_UP
001745r 2  D0 03          bne @notUp
001747r 2  C6 5C          dec AI_TEST_Y
001749r 2  60             rts
00174Ar 2               @notUp:
00174Ar 2  C9 01          cmp #DIR_DOWN
00174Cr 2  D0 03          bne @notDown
00174Er 2  E6 5C          inc AI_TEST_Y
001750r 2  60             rts
001751r 2               @notDown:
001751r 2  C9 02          cmp #DIR_LEFT
001753r 2  D0 09          bne @right
001755r 2  A5 5B          lda AI_TEST_X
001757r 2  D0 02          bne @lowLeft
001759r 2  C6 BF          dec AI_TEST_XH
00175Br 2               @lowLeft:
00175Br 2  C6 5B          dec AI_TEST_X
00175Dr 2  60             rts
00175Er 2               @right:
00175Er 2  E6 5B          inc AI_TEST_X
001760r 2  D0 02          bne @done
001762r 2  E6 BF          inc AI_TEST_XH
001764r 2               @done:
001764r 2  60             rts
001765r 2               
001765r 2               ComputeNextPositions:
001765r 2  A5 40          lda P1_X
001767r 2  85 56          sta P1_NEXT_X
001769r 2  A5 BB          lda P1_XH
00176Br 2  85 BD          sta P1_NEXT_XH
00176Dr 2  A5 41          lda P1_Y
00176Fr 2  85 57          sta P1_NEXT_Y
001771r 2               
001771r 2  A5 42          lda P1_DIR
001773r 2  C9 00          cmp #DIR_UP
001775r 2  D0 02          bne @p1NotUp
001777r 2  C6 57          dec P1_NEXT_Y
001779r 2               @p1NotUp:
001779r 2  A5 42          lda P1_DIR
00177Br 2  C9 01          cmp #DIR_DOWN
00177Dr 2  D0 02          bne @p1NotDown
00177Fr 2  E6 57          inc P1_NEXT_Y
001781r 2               @p1NotDown:
001781r 2  A5 42          lda P1_DIR
001783r 2  C9 02          cmp #DIR_LEFT
001785r 2  D0 08          bne @p1NotLeft
001787r 2  A5 56          lda P1_NEXT_X
001789r 2  D0 02          bne @p1Low
00178Br 2  C6 BD          dec P1_NEXT_XH
00178Dr 2               @p1Low:
00178Dr 2  C6 56          dec P1_NEXT_X
00178Fr 2               @p1NotLeft:
00178Fr 2  A5 42          lda P1_DIR
001791r 2  C9 03          cmp #DIR_RIGHT
001793r 2  D0 06          bne @p1Done
001795r 2  E6 56          inc P1_NEXT_X
001797r 2  D0 02          bne @p1Done
001799r 2  E6 BD          inc P1_NEXT_XH
00179Br 2               @p1Done:
00179Br 2               
00179Br 2  A5 45          lda P2_X
00179Dr 2  85 58          sta P2_NEXT_X
00179Fr 2  A5 BC          lda P2_XH
0017A1r 2  85 BE          sta P2_NEXT_XH
0017A3r 2  A5 46          lda P2_Y
0017A5r 2  85 59          sta P2_NEXT_Y
0017A7r 2               
0017A7r 2  A5 47          lda P2_DIR
0017A9r 2  C9 00          cmp #DIR_UP
0017ABr 2  D0 02          bne @p2NotUp
0017ADr 2  C6 59          dec P2_NEXT_Y
0017AFr 2               @p2NotUp:
0017AFr 2  A5 47          lda P2_DIR
0017B1r 2  C9 01          cmp #DIR_DOWN
0017B3r 2  D0 02          bne @p2NotDown
0017B5r 2  E6 59          inc P2_NEXT_Y
0017B7r 2               @p2NotDown:
0017B7r 2  A5 47          lda P2_DIR
0017B9r 2  C9 02          cmp #DIR_LEFT
0017BBr 2  D0 08          bne @p2NotLeft
0017BDr 2  A5 58          lda P2_NEXT_X
0017BFr 2  D0 02          bne @p2Low
0017C1r 2  C6 BE          dec P2_NEXT_XH
0017C3r 2               @p2Low:
0017C3r 2  C6 58          dec P2_NEXT_X
0017C5r 2               @p2NotLeft:
0017C5r 2  A5 47          lda P2_DIR
0017C7r 2  C9 03          cmp #DIR_RIGHT
0017C9r 2  D0 06          bne @p2Done
0017CBr 2  E6 58          inc P2_NEXT_X
0017CDr 2  D0 02          bne @p2Done
0017CFr 2  E6 BE          inc P2_NEXT_XH
0017D1r 2               @p2Done:
0017D1r 2  60             rts
0017D2r 2               
0017D2r 2               CommitP1Move:
0017D2r 2  A5 56          lda P1_NEXT_X
0017D4r 2  85 40          sta P1_X
0017D6r 2  A5 BD          lda P1_NEXT_XH
0017D8r 2  85 BB          sta P1_XH
0017DAr 2  85 B8          sta PX_HI
0017DCr 2  A5 57          lda P1_NEXT_Y
0017DEr 2  85 41          sta P1_Y
0017E0r 2  A6 40          ldx P1_X
0017E2r 2  4C rr rr       jmp PixelSetP1Trail
0017E5r 2               
0017E5r 2               CommitP2Move:
0017E5r 2  A5 58          lda P2_NEXT_X
0017E7r 2  85 45          sta P2_X
0017E9r 2  A5 BE          lda P2_NEXT_XH
0017EBr 2  85 BC          sta P2_XH
0017EDr 2  85 B8          sta PX_HI
0017EFr 2  A5 59          lda P2_NEXT_Y
0017F1r 2  85 46          sta P2_Y
0017F3r 2  A6 45          ldx P2_X
0017F5r 2  4C rr rr       jmp PixelSetP2Trail
0017F8r 2               
0017F8r 1               
0017F8r 1               .segment "CART"
0017F8r 1               
0017F8r 1               CartReset:
0017F8r 1  A2 FF          ldx #$FF
0017FAr 1  9A             txs                              ; KernalInit doesn't reset the stack
0017FBr 1  20 78 A0       jsr KernalInit
0017FEr 1  20 7B A0       jsr KernalVersion
001801r 1  C9 02          cmp #2
001803r 1  90 07          bcc @wrongMachine
001805r 1  AD 0D 03       lda HW_PRESENT
001808r 1  29 80          and #HW_VID                      ; set on BIOS 2.x only for a PICOVDP
00180Ar 1  D0 11          bne @ready
00180Cr 1               @wrongMachine:
00180Cr 1  A2 00          ldx #0
00180Er 1               @message:
00180Er 1  BD rr rr       lda NeedsMsg,x
001811r 1  F0 08          beq @halt
001813r 1  DA             phx
001814r 1  20 00 A0       jsr Chrout
001817r 1  FA             plx
001818r 1  E8             inx
001819r 1  80 F3          bra @message
00181Br 1               @halt:
00181Br 1  80 FE          bra @halt
00181Dr 1               
00181Dr 1               @ready:
00181Dr 1  64 B1          stz FRAME_COUNT
00181Fr 1  64 B2          stz FRAME_COUNT+1
001821r 1  A9 00          lda #0
001823r 1  20 0F A0       jsr SetIOMode                    ; the keyboard, for Chrin
001826r 1  20 rr rr       jsr SoundInit                    ; our interrupt handler, and the sound timer
001829r 1  20 rr rr       jsr LinkInit                     ; the serial port quiet
00182Cr 1  58             cli                              ; KernalInit leaves interrupts off, and the
00182Dr 1                                                  ; keyboard is read in them
00182Dr 1  20 rr rr       jsr VideoInit
001830r 1  20 rr rr       jsr NewGame
001833r 1               
001833r 1               ; A tick every TICK_FRAMES pictures, or every picture while a linked round
001833r 1               ; waits on the other machine; serial bytes are taken every picture.
001833r 1               MainLoop:
001833r 1  20 rr rr       jsr PollInput
001836r 1  20 rr rr       jsr PollInputP2
001839r 1  20 rr rr       jsr Tick
00183Cr 1               @frame:
00183Cr 1  A9 01          lda #1
00183Er 1  20 rr rr       jsr WaitFrames
001841r 1  E6 B1          inc FRAME_COUNT
001843r 1  D0 02          bne @counted
001845r 1  E6 B2          inc FRAME_COUNT+1
001847r 1               @counted:
001847r 1  20 rr rr       jsr LinkPoll
00184Ar 1  C6 B0          dec FRAMES_LEFT
00184Cr 1  D0 EE          bne @frame
00184Er 1  4C rr rr       jmp MainLoop
001851r 1               
001851r 1               NeedsMsg:
001851r 1  4E 45 45 44    .byte "NEEDS BIOS 2 AND A 6502-PICOVDP", 0
001855r 1  53 20 42 49  
001859r 1  4F 53 20 32  
001871r 1               
001871r 1               ; Through the RAM vectors KernalInit points at the Kernal's own handlers,
001871r 1               ; which read the keyboard.
001871r 1               IrqTrampoline:
001871r 1  6C 00 03       jmp (IRQ_PTR)
001874r 1               
001874r 1               NmiTrampoline:
001874r 1  6C 04 03       jmp (NMI_PTR)
001877r 1               
001877r 1               .segment "VECTORS"
000000r 1  rr rr        .word NmiTrampoline
000002r 1  rr rr        .word CartReset
000004r 1  rr rr        .word IrqTrampoline
000004r 1               
