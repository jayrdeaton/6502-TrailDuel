00042Br 2  B0 39          bcs PixelDone
00042Dr 2  A9 03          lda #3
00042Fr 2  80 32          bra PixelPlot
000431r 2               
000431r 2               ; UiPixel - pixel (X, A) of the title's 256 x 192 area as a screen pixel: A = row,
000431r 2               ; X = column's low byte, PX_HI = its bit 8.
000431r 2               UiPixel:
000431r 2  18             clc
000432r 2  69 18          adc #UI_Y
000434r 2  48             pha
000435r 2  8A             txa
000436r 2  18             clc
000437r 2  69 20          adc #UI_X
000439r 2  AA             tax
00043Ar 2  A9 00          lda #0
00043Cr 2  69 00          adc #0
00043Er 2  85 B8          sta PX_HI
000440r 2  68             pla
000441r 2  60             rts
000442r 2               
000442r 2               ; PixelSet - pixel (X, A) of the title's area in TMS color Y: a player's trail
000442r 2               ; color is that player's value, and white or any other color is 3, white
000442r 2               ; inside the arena. Keeps X and Y. Clobbers: A, DIGIT_TMP, WORK_PTR,
000442r 2               ; OFFSET_LO/HI, NUM_TMP, PX_X/Y/HI, VADDR
000442r 2               PixelSet:
000442r 2  DA             phx
000443r 2  5A             phy
000444r 2  84 60          sty DIGIT_TMP
000446r 2  20 rr rr       jsr UiPixel
000449r 2  20 rr rr       jsr ComputePixelAddress
00044Cr 2  B0 18          bcs PixelDone
00044Er 2  A5 60          lda DIGIT_TMP
000450r 2  A0 03          ldy #3
000452r 2  C9 0F          cmp #TMS_WHITE
000454r 2  F0 0C          beq @have
000456r 2  A0 01          ldy #1
000458r 2  C5 64          cmp P1_TRAIL_COLOR
00045Ar 2  F0 06          beq @have
00045Cr 2  C8             iny
00045Dr 2  C5 65          cmp P2_TRAIL_COLOR
00045Fr 2  F0 01          beq @have
000461r 2  C8             iny
000462r 2               @have:
000462r 2  98             tya
000463r 2               PixelPlot:
000463r 2  20 rr rr       jsr PlotValue
000466r 2               PixelDone:
000466r 2  7A             ply
000467r 2  FA             plx
000468r 2  60             rts
000469r 2               
000469r 2               ; PixelClear - pixel (X, A) of the title's area back to nothing. Keeps X and Y.
000469r 2               PixelClear:
000469r 2  DA             phx
00046Ar 2  5A             phy
00046Br 2  20 rr rr       jsr UiPixel
00046Er 2  20 rr rr       jsr ComputePixelAddress
000471r 2  B0 F3          bcs PixelDone
000473r 2  A9 00          lda #0
000475r 2  80 EC          bra PixelPlot
000477r 2               
000477r 2               ; EraseRect - clear a TEXT_ROW_I x TEXT_COL_I block of the title's area.
000477r 2               ; In: A = top row, X = left column, TEXT_ROW_I = height, TEXT_COL_I = width
000477r 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, FONT_HI, TEXT_COLOR, TEXT_ROW_I,
000477r 2               ;   TEXT_COL_I, plus what PixelClear clobbers
000477r 2               EraseRect:
000477r 2  85 55          sta SCAN_TMP               ; origin row
000479r 2  86 77          stx SCAN_TMP2               ; origin col
00047Br 2  A5 75          lda TEXT_ROW_I
00047Dr 2  85 7A          sta FONT_HI                  ; height
00047Fr 2  A5 76          lda TEXT_COL_I
000481r 2  85 71          sta TEXT_COLOR                ; width
000483r 2               
000483r 2  64 75          stz TEXT_ROW_I
000485r 2               @rowLoop:
000485r 2  64 76          stz TEXT_COL_I
000487r 2               @colLoop:
000487r 2  A5 76          lda TEXT_COL_I
000489r 2  18             clc
00048Ar 2  65 77          adc SCAN_TMP2
00048Cr 2  AA             tax
00048Dr 2  A5 75          lda TEXT_ROW_I
00048Fr 2  18             clc
000490r 2  65 55          adc SCAN_TMP
000492r 2  20 rr rr       jsr PixelClear
000495r 2               
000495r 2  E6 76          inc TEXT_COL_I
000497r 2  A5 76          lda TEXT_COL_I
000499r 2  C5 71          cmp TEXT_COLOR
00049Br 2  D0 EA          bne @colLoop
00049Dr 2               
00049Dr 2  E6 75          inc TEXT_ROW_I
00049Fr 2  A5 75          lda TEXT_ROW_I
0004A1r 2  C5 7A          cmp FONT_HI
0004A3r 2  D0 E0          bne @rowLoop
0004A5r 2  60             rts
0004A6r 2               
0004A6r 2               ; PixelIsSet - A = 1 (Z clear) if screen pixel (X, A), bit 8 of X in PX_HI, is
0004A6r 2               ; drawn, 0 (Z set) if not. Outside the arena's cells counts as drawn. Keeps X
0004A6r 2               ; and Y.
0004A6r 2               PixelIsSet:
0004A6r 2  DA             phx
0004A7r 2  5A             phy
0004A8r 2  20 rr rr       jsr ComputePixelAddress
0004ABr 2  B0 09          bcs @set
0004ADr 2  A6 5F          ldx NUM_TMP
0004AFr 2  B2 52          lda (WORK_PTR)
0004B1r 2  3D rr rr       and PixMask,x
0004B4r 2  F0 05          beq @clear
0004B6r 2               @set:
0004B6r 2  7A             ply
0004B7r 2  FA             plx
0004B8r 2  A9 01          lda #1
0004BAr 2  60             rts
0004BBr 2               @clear:
0004BBr 2  7A             ply
0004BCr 2  FA             plx
0004BDr 2  A9 00          lda #0
0004BFr 2  60             rts
0004C0r 2               
0004C0r 2               ; --- Text, drawn into the arena a pixel at a time ---
0004C0r 2               
0004C0r 2               DrawChar:
0004C0r 2  C9 20          cmp #' '
0004C2r 2  90 54          bcc @done
0004C4r 2  C9 5B          cmp #('Z'+1)
0004C6r 2  B0 50          bcs @done
0004C8r 2               
0004C8r 2  38             sec
0004C9r 2  E9 20          sbc #' '                 ; A = (char - ' '), index into FontData
0004CBr 2  85 74          sta FONT_TMP
0004CDr 2  0A             asl a
0004CEr 2  0A             asl a
0004CFr 2  18             clc
0004D0r 2  65 74          adc FONT_TMP              ; A = (index*5) mod 256; carry = the bit this
0004D2r 2                                            ; 8-bit add lost -- index*5 reaches 290 for
0004D2r 2                                            ; 'Z', past what one byte holds, and that
0004D2r 2                                            ; overflow bit has to reach FONT_PTR's high
0004D2r 2                                            ; byte, not just get thrown away by a clc
0004D2r 2  64 7A          stz FONT_HI
0004D4r 2  90 02          bcc @noHi
0004D6r 2  E6 7A          inc FONT_HI
0004D8r 2               @noHi:
0004D8r 2               
0004D8r 2  18             clc
0004D9r 2  69 rr          adc #<FontData
0004DBr 2  85 72          sta FONT_PTR
0004DDr 2  A5 7A          lda FONT_HI
0004DFr 2  69 rr          adc #>FontData
0004E1r 2  85 73          sta FONT_PTR+1
0004E3r 2               
0004E3r 2  64 76          stz TEXT_COL_I
0004E5r 2               @colLoop:
0004E5r 2  A4 76          ldy TEXT_COL_I
0004E7r 2  B1 72          lda (FONT_PTR),y
0004E9r 2  85 74          sta FONT_TMP
0004EBr 2               
0004EBr 2  64 75          stz TEXT_ROW_I
0004EDr 2               @rowLoop:
0004EDr 2  A6 75          ldx TEXT_ROW_I
0004EFr 2  A5 74          lda FONT_TMP
0004F1r 2  3D rr rr       and FontBitMask,x
0004F4r 2  F0 12          beq @rowSkip
0004F6r 2               
0004F6r 2  A5 75          lda TEXT_ROW_I
0004F8r 2  18             clc
0004F9r 2  65 6F          adc TEXT_ROW
0004FBr 2  48             pha
0004FCr 2  A5 76          lda TEXT_COL_I
0004FEr 2  18             clc
0004FFr 2  65 70          adc TEXT_COL
000501r 2  AA             tax
000502r 2  68             pla
000503r 2  A4 71          ldy TEXT_COLOR
000505r 2  20 rr rr       jsr PixelSet
000508r 2               
000508r 2               @rowSkip:
000508r 2  E6 75          inc TEXT_ROW_I
00050Ar 2  A5 75          lda TEXT_ROW_I
00050Cr 2  C9 07          cmp #7
00050Er 2  D0 DD          bne @rowLoop
000510r 2               
000510r 2  E6 76          inc TEXT_COL_I
000512r 2  A5 76          lda TEXT_COL_I
000514r 2  C9 05          cmp #5
000516r 2  D0 CD          bne @colLoop
000518r 2               
000518r 2               @done:
000518r 2  60             rts
000519r 2               
000519r 2               FontBitMask:
000519r 2  01 02 04 08    .byte $01, $02, $04, $08, $10, $20, $40
00051Dr 2  10 20 40     
000520r 2               
000520r 2               ; -----------------------------------------------------------------------------
000520r 2               ; DrawText - plot a null-terminated string, one glyph every 6 pixels (5 wide
000520r 2               ; plus 1 blank column of spacing).
000520r 2               ; In:  TEXT_STR_PTR = string pointer, TEXT_ROW/TEXT_COL = origin, TEXT_COLOR
000520r 2               ;      Deliberately NOT WORK_PTR -- DrawChar calls down into PixelSet /
000520r 2               ;      ComputePixelAddress, which clobbers WORK_PTR for its own shadow-
000520r 2               ;      buffer addressing on every pixel, so the string pointer needs its
000520r 2               ;      own zero-page home that survives those nested calls.
000520r 2               ; Out: TEXT_COL is left just past the string's last character
000520r 2               ; Clobbers: A, X, Y, STR_IDX, plus everything DrawChar clobbers
000520r 2               ; -----------------------------------------------------------------------------
000520r 2               DrawText:
000520r 2  64 54          stz STR_IDX
000522r 2               @loop:
000522r 2  A4 54          ldy STR_IDX
000524r 2  B1 78          lda (TEXT_STR_PTR),y
000526r 2  F0 0F          beq @done
000528r 2  20 rr rr       jsr DrawChar
00052Br 2  A5 70          lda TEXT_COL
00052Dr 2  18             clc
00052Er 2  69 06          adc #6
000530r 2  85 70          sta TEXT_COL
000532r 2  E6 54          inc STR_IDX
000534r 2  4C rr rr       jmp @loop
000537r 2               @done:
000537r 2  60             rts
000538r 2               
000538r 2               ; -----------------------------------------------------------------------------
000538r 2               ; DrawCharBig - like DrawChar, but each font pixel becomes a 2x2 block
000538r 2               ; (10x14 pixels per glyph instead of 5x7), for a title that reads as an
000538r 2               ; actual title instead of just another line of body text. Reuses FontData
000538r 2               ; as-is rather than needing a second, separately-authored big font.
000538r 2               ; In:  A = ASCII character code (space through 'Z')
000538r 2               ;      TEXT_ROW/TEXT_COL = top-left pixel origin, TEXT_COLOR = TMS_* color
000538r 2               ; Out: none
000538r 2               ; Clobbers: A, X, Y, FONT_PTR, FONT_TMP, FONT_HI, TEXT_ROW_I, TEXT_COL_I,
000538r 2               ;   SCAN_TMP, SCAN_TMP2
000538r 2               ; -----------------------------------------------------------------------------
000538r 2               DrawCharBig:
000538r 2  C9 20          cmp #' '
00053Ar 2  90 7E          bcc @done
00053Cr 2  C9 5B          cmp #('Z'+1)
00053Er 2  B0 7A          bcs @done
000540r 2               
000540r 2  38             sec
000541r 2  E9 20          sbc #' '
000543r 2  85 74          sta FONT_TMP
000545r 2  0A             asl a
000546r 2  0A             asl a
000547r 2  18             clc
000548r 2  65 74          adc FONT_TMP
00054Ar 2  64 7A          stz FONT_HI
00054Cr 2  90 02          bcc @noHi
00054Er 2  E6 7A          inc FONT_HI
000550r 2               @noHi:
000550r 2               
000550r 2  18             clc
000551r 2  69 rr          adc #<FontData
000553r 2  85 72          sta FONT_PTR
000555r 2  A5 7A          lda FONT_HI
000557r 2  69 rr          adc #>FontData
000559r 2  85 73          sta FONT_PTR+1
00055Br 2               
00055Br 2  64 76          stz TEXT_COL_I
00055Dr 2               @colLoop:
00055Dr 2  A4 76          ldy TEXT_COL_I
00055Fr 2  B1 72          lda (FONT_PTR),y
000561r 2  85 74          sta FONT_TMP
000563r 2               
000563r 2  64 75          stz TEXT_ROW_I
000565r 2               @rowLoop:
000565r 2  A6 75          ldx TEXT_ROW_I
000567r 2  A5 74          lda FONT_TMP
000569r 2  3D rr rr       and FontBitMask,x
00056Cr 2  F0 3C          beq @rowSkip
00056Er 2               
00056Er 2  A5 75          lda TEXT_ROW_I               ; SCAN_TMP = scaled absolute row (top of
000570r 2  0A             asl a                          ; this font pixel's 2x2 block)
000571r 2  18             clc
000572r 2  65 6F          adc TEXT_ROW
000574r 2  85 55          sta SCAN_TMP
000576r 2  A5 76          lda TEXT_COL_I               ; SCAN_TMP2 = scaled absolute col (left
000578r 2  0A             asl a                          ; of this font pixel's 2x2 block)
000579r 2  18             clc
00057Ar 2  65 70          adc TEXT_COL
00057Cr 2  85 77          sta SCAN_TMP2
00057Er 2               
00057Er 2  A5 55          lda SCAN_TMP
000580r 2  A6 77          ldx SCAN_TMP2
000582r 2  A4 71          ldy TEXT_COLOR
000584r 2  20 rr rr       jsr PixelSet
000587r 2               
000587r 2  A5 55          lda SCAN_TMP
000589r 2  A6 77          ldx SCAN_TMP2
00058Br 2  E8             inx
00058Cr 2  A4 71          ldy TEXT_COLOR
00058Er 2  20 rr rr       jsr PixelSet
000591r 2               
000591r 2  A5 55          lda SCAN_TMP
000593r 2  18             clc
000594r 2  69 01          adc #1
000596r 2  A6 77          ldx SCAN_TMP2
000598r 2  A4 71          ldy TEXT_COLOR
00059Ar 2  20 rr rr       jsr PixelSet
00059Dr 2               
00059Dr 2  A5 55          lda SCAN_TMP
00059Fr 2  18             clc
0005A0r 2  69 01          adc #1
0005A2r 2  A6 77          ldx SCAN_TMP2
0005A4r 2  E8             inx
0005A5r 2  A4 71          ldy TEXT_COLOR
0005A7r 2  20 rr rr       jsr PixelSet
0005AAr 2               
0005AAr 2               @rowSkip:
0005AAr 2  E6 75          inc TEXT_ROW_I
0005ACr 2  A5 75          lda TEXT_ROW_I
0005AEr 2  C9 07          cmp #7
0005B0r 2  D0 B3          bne @rowLoop
0005B2r 2               
0005B2r 2  E6 76          inc TEXT_COL_I
0005B4r 2  A5 76          lda TEXT_COL_I
0005B6r 2  C9 05          cmp #5
0005B8r 2  D0 A3          bne @colLoop
0005BAr 2               
0005BAr 2               @done:
0005BAr 2  60             rts
0005BBr 2               
0005BBr 2               ; -----------------------------------------------------------------------------
0005BBr 2               ; DrawTextBig - DrawText's counterpart for DrawCharBig: one glyph every 12
0005BBr 2               ; pixels (10 wide plus 2 blank columns of spacing) instead of 6.
0005BBr 2               ; In:  TEXT_STR_PTR = string pointer, TEXT_ROW/TEXT_COL = origin, TEXT_COLOR
0005BBr 2               ; Out: TEXT_COL is left just past the string's last character
0005BBr 2               ; -----------------------------------------------------------------------------
0005BBr 2               DrawTextBig:
0005BBr 2  64 54          stz STR_IDX
0005BDr 2               @loop:
0005BDr 2  A4 54          ldy STR_IDX
0005BFr 2  B1 78          lda (TEXT_STR_PTR),y
0005C1r 2  F0 0F          beq @done
0005C3r 2  20 rr rr       jsr DrawCharBig
0005C6r 2  A5 70          lda TEXT_COL
0005C8r 2  18             clc
0005C9r 2  69 0C          adc #12
0005CBr 2  85 70          sta TEXT_COL
0005CDr 2  E6 54          inc STR_IDX
0005CFr 2  4C rr rr       jmp @loop
0005D2r 2               @done:
0005D2r 2  60             rts
0005D3r 2               
0005D3r 2               ; -----------------------------------------------------------------------------
0005D3r 2               ; DrawColorSwatch - fill a small 7x7 pixel block with a solid color, used to
0005D3r 2               ; preview a player's selected trail color on the title screen. 7px to match
0005D3r 2               ; the font's own glyph height, so the swatch reads as sitting on the same
0005D3r 2               ; line as the "P1:"/"P2:" text instead of an arbitrary size. Reuses
0005D3r 2               ; DrawChar's TEXT_ROW_I/TEXT_COL_I as generic loop counters, safe since the
0005D3r 2               ; two routines are never active at the same time.
0005D3r 2               ; In: A = top-left row, X = top-left col, Y = TMS_* color
0005D3r 2               ; Out: none
0005D3r 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_ROW_I, TEXT_COL_I, TEXT_COLOR,
0005D3r 2               ;   plus everything PixelSet clobbers
0005D3r 2               ; -----------------------------------------------------------------------------
0005D3r 2               DrawColorSwatch:
0005D3r 2  85 55          sta SCAN_TMP               ; origin row
0005D5r 2  86 77          stx SCAN_TMP2               ; origin col
0005D7r 2  84 71          sty TEXT_COLOR
0005D9r 2               
0005D9r 2  64 75          stz TEXT_ROW_I
0005DBr 2               @rowLoop:
0005DBr 2  64 76          stz TEXT_COL_I
0005DDr 2               @colLoop:
0005DDr 2  A5 76          lda TEXT_COL_I
0005DFr 2  18             clc
0005E0r 2  65 77          adc SCAN_TMP2
0005E2r 2  AA             tax                          ; X = this pixel's absolute column
0005E3r 2  A5 75          lda TEXT_ROW_I
0005E5r 2  18             clc
0005E6r 2  65 55          adc SCAN_TMP                 ; A = this pixel's absolute row
0005E8r 2  A4 71          ldy TEXT_COLOR
0005EAr 2  20 rr rr       jsr PixelSet
0005EDr 2               
0005EDr 2  E6 76          inc TEXT_COL_I
0005EFr 2  A5 76          lda TEXT_COL_I
0005F1r 2  C9 07          cmp #7
0005F3r 2  D0 E8          bne @colLoop
0005F5r 2               
0005F5r 2  E6 75          inc TEXT_ROW_I
0005F7r 2  A5 75          lda TEXT_ROW_I
0005F9r 2  C9 07          cmp #7
0005FBr 2  D0 DE          bne @rowLoop
0005FDr 2  60             rts
0005FEr 2               
0005FEr 2               ; -----------------------------------------------------------------------------
0005FEr 2               ; DrawLeftTriangle / DrawRightTriangle - a small 3x5 "you can go this way"
0005FEr 2               ; affordance: a solid filled arrowhead coming to a single-pixel point, not
0005FEr 2               ; the font's thin </> glyphs, either side of the title menu's line.
0005FEr 2               ; In: A = top row, X = left col, Y = color
0005FEr 2               ; Out: none
0005FEr 2               ; Clobbers: A, X, Y, SCAN_TMP, SCAN_TMP2, TEXT_COLOR, plus everything
0005FEr 2               ;   PixelSet clobbers
0005FEr 2               ; -----------------------------------------------------------------------------
0005FEr 2               DrawLeftTriangle:
0005FEr 2  85 55          sta SCAN_TMP               ; top row
000600r 2  86 77          stx SCAN_TMP2               ; left col
000602r 2  84 71          sty TEXT_COLOR
000604r 2               
000604r 2  A5 55          lda SCAN_TMP                ; row0, col+2
000606r 2  A6 77          ldx SCAN_TMP2
000608r 2  E8             inx
000609r 2  E8             inx
00060Ar 2  A4 71          ldy TEXT_COLOR
00060Cr 2  20 rr rr       jsr PixelSet
00060Fr 2               
00060Fr 2  A5 55          lda SCAN_TMP                ; row1, col+1
000611r 2  18             clc
000612r 2  69 01          adc #1
000614r 2  A6 77          ldx SCAN_TMP2
000616r 2  E8             inx
000617r 2  A4 71          ldy TEXT_COLOR
000619r 2  20 rr rr       jsr PixelSet
00061Cr 2               
00061Cr 2  A5 55          lda SCAN_TMP                ; row1, col+2
00061Er 2  18             clc
00061Fr 2  69 01          adc #1
000621r 2  A6 77          ldx SCAN_TMP2
000623r 2  E8             inx
000624r 2  E8             inx
000625r 2  A4 71          ldy TEXT_COLOR
000627r 2  20 rr rr       jsr PixelSet
00062Ar 2               
00062Ar 2  A5 55          lda SCAN_TMP                ; row2, col+0
00062Cr 2  18             clc
00062Dr 2  69 02          adc #2
00062Fr 2  A6 77          ldx SCAN_TMP2
000631r 2  A4 71          ldy TEXT_COLOR
000633r 2  20 rr rr       jsr PixelSet
000636r 2               
000636r 2  A5 55          lda SCAN_TMP                ; row2, col+1
000638r 2  18             clc
000639r 2  69 02          adc #2
00063Br 2  A6 77          ldx SCAN_TMP2
00063Dr 2  E8             inx
00063Er 2  A4 71          ldy TEXT_COLOR
000640r 2  20 rr rr       jsr PixelSet
000643r 2               
000643r 2  A5 55          lda SCAN_TMP                ; row2, col+2
000645r 2  18             clc
000646r 2  69 02          adc #2
000648r 2  A6 77          ldx SCAN_TMP2
00064Ar 2  E8             inx
00064Br 2  E8             inx
00064Cr 2  A4 71          ldy TEXT_COLOR
00064Er 2  20 rr rr       jsr PixelSet
000651r 2               
000651r 2  A5 55          lda SCAN_TMP                ; row3, col+1
000653r 2  18             clc
000654r 2  69 03          adc #3
000656r 2  A6 77          ldx SCAN_TMP2
000658r 2  E8             inx
000659r 2  A4 71          ldy TEXT_COLOR
00065Br 2  20 rr rr       jsr PixelSet
00065Er 2               
00065Er 2  A5 55          lda SCAN_TMP                ; row3, col+2
000660r 2  18             clc
000661r 2  69 03          adc #3
000663r 2  A6 77          ldx SCAN_TMP2
000665r 2  E8             inx
000666r 2  E8             inx
000667r 2  A4 71          ldy TEXT_COLOR
000669r 2  20 rr rr       jsr PixelSet
00066Cr 2               
00066Cr 2  A5 55          lda SCAN_TMP                ; row4, col+2
00066Er 2  18             clc
00066Fr 2  69 04          adc #4
000671r 2  A6 77          ldx SCAN_TMP2
000673r 2  E8             inx
000674r 2  E8             inx
000675r 2  A4 71          ldy TEXT_COLOR
000677r 2  20 rr rr       jsr PixelSet
00067Ar 2  60             rts
00067Br 2               
00067Br 2               DrawRightTriangle:
00067Br 2  85 55          sta SCAN_TMP               ; top row
