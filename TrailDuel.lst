000260r 2  B9 rr rr       lda TmsRgb+1,y
000263r 2  8D 00 9C       sta VC_DATA
000266r 2  60             rts
000267r 2               
000267r 2               ; ClearScreen - an empty arena: SHADOW and both layers' tiles.
000267r 2               ClearScreen:
000267r 2  A9 00          lda #<SHADOW
