0001ECr 2               SoundTick:
0001ECr 2  EE 2C 0A       inc S_TICKS
0001EFr 2  D0 03          bne @counted
0001F1r 2  EE 2D 0A       inc S_TICKS+1
0001F4r 2               @counted:
0001F4r 2  20 rr rr       jsr TakeRequests
0001F7r 2  A2 02          ldx #2
0001F9r 2               @effect:
0001F9r 2  20 rr rr       jsr EffectTick
0001FCr 2  CA             dex
0001FDr 2  10 FA          bpl @effect
0001FFr 2  20 rr rr       jsr FilterTick
000202r 2                 ; --- everything to the chip at once ---
000202r 2  A2 02          ldx #2
000204r 2               @retrigger:
000204r 2  BD 1C 0A       lda S_PEND,x
000207r 2  F0 11          beq @noRetrigger
000209r 2  9E 1C 0A       stz S_PEND,x
00020Cr 2  FE 19 0A       inc S_RTG,x
00020Fr 2  BC rr rr       ldy VoiceBase,x
000212r 2  B9 04 0A       lda S_REG+4,y
000215r 2  29 FE          and #$FE
000217r 2  99 04 98       sta SID_V1_FREQ_LO+4,y           ; let go first, so the note starts again
00021Ar 2               @noRetrigger:
00021Ar 2  CA             dex
00021Br 2  10 E7          bpl @retrigger
00021Dr 2  A2 18          ldx #$18
00021Fr 2               @copy:
00021Fr 2  BD 00 0A       lda S_REG,x
000222r 2  9D 00 98       sta SID_V1_FREQ_LO,x
000225r 2  CA             dex
000226r 2  10 F7          bpl @copy
000228r 2  60             rts
000229r 2               
000229r 2               TakeRequests:
000229r 2  AE 29 0A       ldx S_QT
00022Cr 2  EC 28 0A       cpx S_QH
00022Fr 2  F0 12          beq @done
000231r 2  BD 20 0A       lda S_Q,x
000234r 2  E8             inx
000235r 2  E0 08          cpx #8
000237r 2  90 02          bcc @stored
000239r 2  A2 00          ldx #0
00023Br 2               @stored:
00023Br 2  8E 29 0A       stx S_QT
00023Er 2  20 rr rr       jsr EffectStart
000241r 2  80 E6          bra TakeRequests
000243r 2               @done:
000243r 2  60             rts
000244r 2               
000244r 2               ; CanTake - carry set if an effect of priority S_A may have voice X.
000244r 2               CanTake:
000244r 2  BD 30 0A       lda SF_ID,x
000247r 2  F0 06          beq @yes
000249r 2  A5 B3          lda S_A
00024Br 2  DD 33 0A       cmp SF_P,x                       ; carry set if it matters as much or more
00024Er 2  60             rts
00024Fr 2               @yes:
00024Fr 2  38             sec
000250r 2  60             rts
000251r 2               
000251r 2               ; EffectStart - effect A on the voice it prefers, or its other choice, then
000251r 2               ; the effect that goes with it on another voice. Keeps X.
000251r 2               EffectStart:
000251r 2  DA             phx
000252r 2  A8             tay
000253r 2  B9 rr rr       lda FxPrio,y
000256r 2  85 B3          sta S_A
000258r 2  BE rr rr       ldx FxVoice,y
00025Br 2  20 rr rr       jsr CanTake
00025Er 2  B0 0C          bcs @take
000260r 2  B9 rr rr       lda FxOther,y
000263r 2  F0 27          beq @done
000265r 2  3A             dec a
000266r 2  AA             tax
000267r 2  20 rr rr       jsr CanTake
00026Ar 2  90 20          bcc @done
00026Cr 2               @take:
00026Cr 2  98             tya
00026Dr 2  9D 30 0A       sta SF_ID,x
000270r 2  A5 B3          lda S_A
000272r 2  9D 33 0A       sta SF_P,x
000275r 2  B9 rr rr       lda FxLo,y
000278r 2  9D 36 0A       sta SF_PL,x
00027Br 2  B9 rr rr       lda FxHi,y
00027Er 2  9D 39 0A       sta SF_PH,x
000281r 2  9E 3C 0A       stz SF_LEFT,x
000284r 2  B9 rr rr       lda FxPair,y
000287r 2  F0 03          beq @done
000289r 2  20 rr rr       jsr EffectStart
00028Cr 2               @done:
00028Cr 2  FA             plx
00028Dr 2  60             rts
00028Er 2               
00028Er 2               ; EffectEnd - voice X lets go.
00028Er 2               EffectEnd:
00028Er 2  BD 30 0A       lda SF_ID,x
000291r 2  F0 11          beq @done
000293r 2  9E 30 0A       stz SF_ID,x
000296r 2  9E 4E 0A       stz SF_FIL,x
000299r 2  BC rr rr       ldy VoiceBase,x
00029Cr 2  B9 04 0A       lda S_REG+4,y
00029Fr 2  29 FE          and #$FE
0002A1r 2  99 04 0A       sta S_REG+4,y
0002A4r 2               @done:
0002A4r 2  60             rts
0002A5r 2               
0002A5r 2               ; EffectTick - voice X's effect, one frame on.
0002A5r 2               EffectTick:
0002A5r 2  BD 30 0A       lda SF_ID,x
0002A8r 2  F0 29          beq @done
0002AAr 2  BD 3C 0A       lda SF_LEFT,x
0002ADr 2  D0 08          bne @run
0002AFr 2  20 rr rr       jsr NextStep
0002B2r 2  BD 30 0A       lda SF_ID,x
0002B5r 2  F0 1C          beq @done
0002B7r 2               @run:
0002B7r 2  DE 3C 0A       dec SF_LEFT,x
0002BAr 2  BD 4B 0A       lda SF_FLG,x
0002BDr 2  29 0F          and #$0F
0002BFr 2  F0 03          beq @write
0002C1r 2  20 rr rr       jsr SlidePitch
0002C4r 2               @write:
0002C4r 2  BC rr rr       ldy VoiceBase,x
0002C7r 2  BD 3F 0A       lda SF_FL,x
0002CAr 2  99 00 0A       sta S_REG,y
0002CDr 2  BD 42 0A       lda SF_FH,x
0002D0r 2  99 01 0A       sta S_REG+1,y
0002D3r 2               @done:
0002D3r 2  60             rts
0002D4r 2               
0002D4r 2               ; NextStep - load voice X's next step, or end the effect. A step is 12 bytes:
0002D4r 2               ; frames, control, AD, SR, pitch, target pitch, flags, pulse width, cutoff and
0002D4r 2               ; how fast it closes.
0002D4r 2               NextStep:
0002D4r 2  BD 36 0A       lda SF_PL,x
0002D7r 2  85 B4          sta S_P
0002D9r 2  BD 39 0A       lda SF_PH,x
0002DCr 2  85 B5          sta S_P+1
0002DEr 2  B2 B4          lda (S_P)
0002E0r 2  D0 03          bne @step
0002E2r 2  4C rr rr       jmp EffectEnd
0002E5r 2               @step:
0002E5r 2  9D 3C 0A       sta SF_LEFT,x
0002E8r 2  DA             phx
0002E9r 2  BD rr rr       lda VoiceBase,x
0002ECr 2  AA             tax
0002EDr 2  A0 01          ldy #1
0002EFr 2  B1 B4          lda (S_P),y
0002F1r 2  9D 04 0A       sta S_REG+4,x
0002F4r 2  C8             iny
0002F5r 2  B1 B4          lda (S_P),y
0002F7r 2  9D 05 0A       sta S_REG+5,x
0002FAr 2  C8             iny
0002FBr 2  B1 B4          lda (S_P),y
0002FDr 2  9D 06 0A       sta S_REG+6,x
000300r 2  A0 09          ldy #9
000302r 2  B1 B4          lda (S_P),y
000304r 2  9D 03 0A       sta S_REG+3,x
000307r 2  9E 02 0A       stz S_REG+2,x
00030Ar 2  FA             plx
00030Br 2  A0 08          ldy #8
00030Dr 2  B1 B4          lda (S_P),y
00030Fr 2  9D 4B 0A       sta SF_FLG,x
000312r 2  30 19          bmi @kept                        ; carries on from the last pitch
000314r 2  A0 04          ldy #4
000316r 2  B1 B4          lda (S_P),y
000318r 2  9D 3F 0A       sta SF_FL,x
00031Br 2  C8             iny
00031Cr 2  B1 B4          lda (S_P),y
00031Er 2  9D 42 0A       sta SF_FH,x
000321r 2  C8             iny
000322r 2  B1 B4          lda (S_P),y
000324r 2  9D 45 0A       sta SF_TL,x
000327r 2  C8             iny
000328r 2  B1 B4          lda (S_P),y
00032Ar 2  9D 48 0A       sta SF_TH,x
00032Dr 2               @kept:
00032Dr 2  A0 0A          ldy #10
00032Fr 2  B1 B4          lda (S_P),y
000331r 2  F0 0B          beq @noFilter
000333r 2  8D 2E 0A       sta S_FXC
000336r 2  C8             iny
000337r 2  B1 B4          lda (S_P),y
000339r 2  8D 2F 0A       sta S_FXK
00033Cr 2  A9 01          lda #1
00033Er 2               @noFilter:
00033Er 2  9D 4E 0A       sta SF_FIL,x
000341r 2  BD 4B 0A       lda SF_FLG,x
000344r 2  29 10          and #$10
000346r 2  F0 05          beq @noRetrigger
000348r 2  A9 01          lda #1
00034Ar 2  9D 1C 0A       sta S_PEND,x
00034Dr 2               @noRetrigger:
00034Dr 2  A5 B4          lda S_P
00034Fr 2  18             clc
000350r 2  69 0C          adc #12
000352r 2  9D 36 0A       sta SF_PL,x
000355r 2  A5 B5          lda S_P+1
000357r 2  69 00          adc #0
000359r 2  9D 39 0A       sta SF_PH,x
00035Cr 2  60             rts
00035Dr 2               
00035Dr 2               ; SlidePitch - voice X's pitch a share of the way to its target.
00035Dr 2               SlidePitch:
00035Dr 2  BD 45 0A       lda SF_TL,x
000360r 2  38             sec
000361r 2  FD 3F 0A       sbc SF_FL,x
000364r 2  85 B6          sta S_B
000366r 2  BD 48 0A       lda SF_TH,x
000369r 2  FD 42 0A       sbc SF_FH,x
00036Cr 2  85 B7          sta S_C
00036Er 2  BD 4B 0A       lda SF_FLG,x                     ; shifted right by the slide's amount
000371r 2  29 0F          and #$0F
000373r 2  A8             tay
000374r 2               @shift:
000374r 2  A5 B7          lda S_C
000376r 2  C9 80          cmp #$80
000378r 2  66 B7          ror S_C
00037Ar 2  66 B6          ror S_B
00037Cr 2  88             dey
00037Dr 2  D0 F5          bne @shift
00037Fr 2  A5 B6          lda S_B
000381r 2  05 B7          ora S_C
000383r 2  F0 12          beq @arrive
000385r 2  BD 3F 0A       lda SF_FL,x
000388r 2  18             clc
000389r 2  65 B6          adc S_B
00038Br 2  9D 3F 0A       sta SF_FL,x
00038Er 2  BD 42 0A       lda SF_FH,x
000391r 2  65 B7          adc S_C
000393r 2  9D 42 0A       sta SF_FH,x
000396r 2  60             rts
000397r 2               @arrive:
000397r 2  BD 45 0A       lda SF_TL,x
00039Ar 2  9D 3F 0A       sta SF_FL,x
00039Dr 2  BD 48 0A       lda SF_TH,x
0003A0r 2  9D 42 0A       sta SF_FH,x
0003A3r 2  60             rts
0003A4r 2               
0003A4r 2               ; FilterTick - the voices whose effects ask for it go through the low-pass
0003A4r 2               ; filter, its cutoff closing as the effect goes on; the rest go straight out.
0003A4r 2               FilterTick:
0003A4r 2  64 B7          stz S_C
0003A6r 2  A2 02          ldx #2
0003A8r 2               @voice:
0003A8r 2  BD 30 0A       lda SF_ID,x
0003ABr 2  F0 0C          beq @next
0003ADr 2  BD 4E 0A       lda SF_FIL,x
0003B0r 2  F0 07          beq @next
0003B2r 2  BD rr rr       lda VoiceBit,x
0003B5r 2  05 B7          ora S_C
0003B7r 2  85 B7          sta S_C
0003B9r 2               @next:
0003B9r 2  CA             dex
0003BAr 2  10 EC          bpl @voice
0003BCr 2  A5 B7          lda S_C
0003BEr 2  F0 22          beq @route
0003C0r 2  AD 2E 0A       lda S_FXC
0003C3r 2  8D 16 0A       sta S_REG+$16
0003C6r 2  9C 15 0A       stz S_REG+$15
0003C9r 2  AE 2F 0A       ldx S_FXK
0003CCr 2  F0 14          beq @route
0003CEr 2               @close:
0003CEr 2  4A             lsr a
0003CFr 2  CA             dex
0003D0r 2  D0 FC          bne @close
0003D2r 2  1A             inc a
0003D3r 2  49 FF          eor #$FF
0003D5r 2  38             sec
0003D6r 2  6D 2E 0A       adc S_FXC
0003D9r 2  C9 14          cmp #20
0003DBr 2  B0 02          bcs @closed
0003DDr 2  A9 14          lda #20
0003DFr 2               @closed:
0003DFr 2  8D 2E 0A       sta S_FXC
0003E2r 2               @route:
0003E2r 2  A5 B7          lda S_C
0003E4r 2  09 20          ora #$20                         ; a little resonance
0003E6r 2  8D 17 0A       sta S_REG+$17
0003E9r 2  A9 1F          lda #SID_FILT_LP | 15
0003EBr 2  8D 18 0A       sta S_REG+$18
0003EEr 2  60             rts
0003EFr 2               
0003EFr 1               .include "src/link.asm"
0003EFr 2               ; =============================================================================
0003EFr 2               ;   link.asm - two machines, one duel, over the serial port
0003EFr 2               ; =============================================================================
0003EFr 2               ;   Each machine plays the whole round, both riders, from the same start, and
0003EFr 2               ;   the two stay in step by trading each tick's turns: a rider's heading is
0003EFr 2               ;   all one machine needs from the other. A machine takes its own player's
0003EFr 2               ;   heading for tick t at tick t - LDELAY and sends it at once, so it's
0003EFr 2               ;   usually there before the other machine needs it. A machine that doesn't
0003EFr 2               ;   have the other's heading for a tick yet waits, and after half a second
0003EFr 2               ;   its border goes red; A then gives up and goes back to the title.
0003EFr 2               ;
0003EFr 2               ;   Everything is sent as 11-byte frames: $A5, type, a byte, 6 bytes, a 2-byte
0003EFr 2               ;   check, as in 6502-HexFleet's link. A frame that arrives damaged is dropped.
0003EFr 2               ;     HELLO  finds the other machine: who it is, its color and speed, how far
0003EFr 2               ;            along. Both play at the first seat's speed.
0003EFr 2               ;     INPUT  a machine's headings for its last 8 ticks, a check of the round
0003EFr 2               ;            as it stood LDELAY ticks back, and which pairing it's from.
0003EFr 2               ;   Every INPUT carries 8 ticks, and two machines are never more than
0003EFr 2               ;   2 x LDELAY (6 at most) apart, so a lost one costs nothing once a later one gets
0003EFr 2               ;   through. A waiting machine sends its latest again every LINK_RESEND
0003EFr 2               ;   frames. Received bytes go into a ring from the interrupt (SysIrq, in
0003EFr 2               ;   sound.asm), so nothing is lost while the screen is being drawn.
0003EFr 2               ; =============================================================================
0003EFr 2               
0003EFr 2               .segment "CART"
000AEBr 2               
000AEBr 2               FRAME_SYNC    = $A5
000AEBr 2               FRAME_SIZE    = 11
000AEBr 2               FR_HELLO      = 1
000AEBr 2               FR_INPUT      = 2
000AEBr 2               LINK_VERSION  = 2                  ; 2: HELLO carries the speed
000AEBr 2               ; Ticks between taking a heading and using it (LDELAY), by speed: about 50 ms
000AEBr 2               ; at each, the time a frame takes to cross and be read, with room to spare
000AEBr 2               LinkDelays:
000AEBr 2  01 02 03       .byte 1, 2, 3
000AEEr 2               LINK_RESEND   = 3                  ; frames between tries while waiting
000AEEr 2               HELLO_RESEND  = 4                  ; ticks between tries while looking
000AEEr 2               WAIT_SHOW     = 30                 ; frames of waiting before the border goes red
000AEEr 2               POLL_BYTES    = 40                 ; bytes handled a frame at most
000AEEr 2               BAD_SYNC      = 1                  ; LINK_BAD
000AEEr 2               BAD_VERSION   = 2
000AEEr 2               BAD_NOSERIAL  = 3
000AEEr 2               RESULT_SYNC   = 4                  ; ROUND_RESULT: the machines disagreed
000AEEr 2               
000AEEr 2  4C 49 4E 4B  TxtLinking:    .byte "LINKING", 0
000AF2r 2  49 4E 47 00  
000AF6r 2  57 41 49 54  TxtWaitFor:    .byte "WAITING FOR THE", 0
000AFAr 2  49 4E 47 20  
000AFEr 2  46 4F 52 20  
000B06r 2  4F 54 48 45  TxtOtherCart:  .byte "OTHER CART", 0
000B0Ar 2  52 20 43 41  
000B0Er 2  52 54 00     
000B11r 2  41 3A 20 43  TxtCancel:     .byte "A: CANCEL", 0
000B15r 2  41 4E 43 45  
000B19r 2  4C 00        
000B1Br 2  41 3A 20 42  TxtBack:       .byte "A: BACK", 0
000B1Fr 2  41 43 4B 00  
000B23r 2  4E 4F 20 53  TxtNoSerial:   .byte "NO SERIAL CARD", 0
000B27r 2  45 52 49 41  
000B2Br 2  4C 20 43 41  
000B32r 2  4F 54 48 45  TxtWrongCart:  .byte "OTHER BUILD", 0
000B36r 2  52 20 42 55  
000B3Ar 2  49 4C 44 00  
000B3Er 2               
000B3Er 2               ; --- Starting up ---
000B3Er 2               
000B3Er 2               ; LinkInit - at start-up: not linked, and the serial port quiet until a link
000B3Er 2               ; starts. SoundInit has already put SysIrq (sound.asm) in charge of interrupts.
000B3Er 2               LinkInit:
000B3Er 2  64 8B          stz LINK_ON
000B40r 2  64 8C          stz LINK_UP
000B42r 2  64 AB          stz HAVE_OLD
000B44r 2                 ; falls through
000B44r 2               
000B44r 2               ; SerialQuiet - no serial interrupts: another machine calling must not reach
000B44r 2               ; the keyboard buffer while this one isn't linked.
000B44r 2               SerialQuiet:
000B44r 2  AD 0D 03       lda HW_PRESENT
000B47r 2  29 10          and #HW_SC
000B49r 2  F0 08          beq @done
000B4Br 2  AD 02 90       lda SC_CMD
000B4Er 2  09 02          ora #SC_CMD_RXIRQ_OFF
000B50r 2  8D 02 90       sta SC_CMD
000B53r 2               @done:
000B53r 2  60             rts
000B54r 2               
000B54r 2               ; --- Looking for the other machine ---
000B54r 2               
000B54r 2               ; EnterLink - A on LINK, or after a linked round: show the linking screen and
000B54r 2               ; start looking. A rematch keeps the link on, with the colors as picked.
000B54r 2               EnterLink:
000B54r 2  20 rr rr       jsr SndSelect
000B57r 2  A9 05          lda #STATE_LINKING
000B59r 2  85 3A          sta GAME_STATE
000B5Br 2  64 8C          stz LINK_UP
000B5Dr 2  64 8D          stz LINK_BAD
000B5Fr 2  64 8E          stz LINK_SHOWN
000B61r 2  64 8F          stz HAVE_HELLO
000B63r 2  64 90          stz PEER_HAS
000B65r 2  A9 01          lda #1
000B67r 2  85 9E          sta LINK_T
000B69r 2  A5 8B          lda LINK_ON
000B6Br 2  D0 2D          bne @look
000B6Dr 2  A5 62          lda P1_COLOR_IDX                 ; the title's colors, to put back after
000B6Fr 2  85 AC          sta TITLE_C1
000B71r 2  85 96          sta MY_COLOR
000B73r 2  A5 63          lda P2_COLOR_IDX
000B75r 2  85 AD          sta TITLE_C2
000B77r 2  A5 C3          lda SPEED
000B79r 2  85 C7          sta TITLE_SPEED
000B7Br 2  85 C5          sta MY_SPEED
000B7Dr 2  AD 0D 03       lda HW_PRESENT
000B80r 2  29 10          and #HW_SC
000B82r 2  D0 07          bne @card
000B84r 2  A9 03          lda #BAD_NOSERIAL
000B86r 2  85 8D          sta LINK_BAD
000B88r 2  4C rr rr       jmp DrawLinkScreen
000B8Br 2               @card:
000B8Br 2  78             sei
000B8Cr 2  64 A0          stz RX_HEAD
000B8Er 2  64 A1          stz RX_TAIL
000B90r 2  20 4E A0       jsr InitSC                       ; 8-N-1, 19200 baud, receive interrupt on
000B93r 2  58             cli
000B94r 2  64 A2          stz PARSE_N
000B96r 2  A9 01          lda #1
000B98r 2  85 8B          sta LINK_ON
000B9Ar 2               @look:
000B9Ar 2  20 rr rr       jsr NewNonce
000B9Dr 2  4C rr rr       jmp DrawLinkScreen
000BA0r 2               
000BA0r 2               ; LinkOff - back to a machine on its own, with the title's colors as they were.
000BA0r 2               LinkOff:
000BA0r 2  A5 8B          lda LINK_ON
000BA2r 2  F0 18          beq @done
000BA4r 2  64 8B          stz LINK_ON
000BA6r 2  64 8C          stz LINK_UP
000BA8r 2  64 AB          stz HAVE_OLD
000BAAr 2  20 rr rr       jsr SerialQuiet
000BADr 2  A5 AC          lda TITLE_C1
000BAFr 2  85 62          sta P1_COLOR_IDX
000BB1r 2  A5 AD          lda TITLE_C2
000BB3r 2  85 63          sta P2_COLOR_IDX
000BB5r 2  A5 C7          lda TITLE_SPEED
000BB7r 2  85 C3          sta SPEED
000BB9r 2  20 rr rr       jsr ApplySelectedTrailColors
000BBCr 2               @done:
000BBCr 2  A9 00          lda #0
000BBEr 2  4C rr rr       jmp SetWaiting
000BC1r 2               
000BC1r 2               NewNonce:
000BC1r 2  A5 B1          lda FRAME_COUNT                  ; when this machine got here: the other
000BC3r 2  45 A0          eor RX_HEAD                      ; one almost certainly didn't at the same frame
000BC5r 2  85 92          sta MY_NONCE
000BC7r 2  A5 B2          lda FRAME_COUNT+1
000BC9r 2  85 93          sta MY_NONCE+1
000BCBr 2  60             rts
000BCCr 2               
000BCCr 2               DrawLinkScreen:
000BCCr 2  20 rr rr       jsr ClearScreen
000BCFr 2  20 rr rr       jsr DrawBorder
000BD2r 2  20 rr rr       jsr InitHeadSprites
000BD5r 2  A5 8D          lda LINK_BAD
000BD7r 2  85 8E          sta LINK_SHOWN
000BD9r 2  D0 24          bne @failed
000BDBr 2  A9 48          lda #72
000BDDr 2  A2 rr          ldx #<TxtLinking
000BDFr 2  A0 rr          ldy #>TxtLinking
000BE1r 2  20 rr rr       jsr CenterText
000BE4r 2  A9 5C          lda #92
000BE6r 2  A2 rr          ldx #<TxtWaitFor
000BE8r 2  A0 rr          ldy #>TxtWaitFor
000BEAr 2  20 rr rr       jsr CenterText
000BEDr 2  A9 66          lda #102
000BEFr 2  A2 rr          ldx #<TxtOtherCart
000BF1r 2  A0 rr          ldy #>TxtOtherCart
000BF3r 2  20 rr rr       jsr CenterText
000BF6r 2  A9 7E          lda #126
000BF8r 2  A2 rr          ldx #<TxtCancel
000BFAr 2  A0 rr          ldy #>TxtCancel
000BFCr 2  4C rr rr       jmp CenterText
000BFFr 2               @failed:
000BFFr 2  A2 rr          ldx #<TxtNoSerial
000C01r 2  A0 rr          ldy #>TxtNoSerial
000C03r 2  C9 02          cmp #BAD_VERSION
000C05r 2  D0 04          bne @say
000C07r 2  A2 rr          ldx #<TxtWrongCart
000C09r 2  A0 rr          ldy #>TxtWrongCart
000C0Br 2               @say:
000C0Br 2  A9 58          lda #88
000C0Dr 2  20 rr rr       jsr CenterText
000C10r 2  A9 6E          lda #110
000C12r 2  A2 rr          ldx #<TxtBack
000C14r 2  A0 rr          ldy #>TxtBack
000C16r 2  4C rr rr       jmp CenterText
000C19r 2               
000C19r 2               ; TickLinking - a tick on the linking screen.
000C19r 2               TickLinking:
000C19r 2  A5 4D          lda FIRE_EDGE
000C1Br 2  F0 09          beq @look
000C1Dr 2  20 rr rr       jsr SndSelect
000C20r 2  20 rr rr       jsr LinkOff
000C23r 2  4C rr rr       jmp DrawTitleScreen
000C26r 2               @look:
000C26r 2  A5 8D          lda LINK_BAD
000C28r 2  F0 07          beq @fine
000C2Ar 2  C5 8E          cmp LINK_SHOWN                   ; the other machine turned out to be another
000C2Cr 2  F0 1D          beq @done                        ; build: say so, once
000C2Er 2  4C rr rr       jmp DrawLinkScreen
000C31r 2               @fine:
000C31r 2  A5 8F          lda HAVE_HELLO
000C33r 2  F0 04          beq @resend
000C35r 2  A5 90          lda PEER_HAS
000C37r 2  D0 13          bne LinkGo
000C39r 2               @resend:
000C39r 2  C6 9E          dec LINK_T
000C3Br 2  D0 0E          bne @done
000C3Dr 2  A9 04          lda #HELLO_RESEND
000C3Fr 2  85 9E          sta LINK_T
000C41r 2  20 rr rr       jsr SendHello
000C44r 2  A5 AB          lda HAVE_OLD                     ; the other machine may still be waiting
000C46r 2  F0 03          beq @done                        ; on our last turns of the round before
000C48r 2  4C rr rr       jmp SendOld
000C4Br 2               @done:
000C4Br 2  60             rts
000C4Cr 2               
000C4Cr 2               ; LinkGo - both machines know each other: the lower number takes the first
000C4Cr 2               ; seat, the left, and each seat its machine's color, the second moved on one
000C4Cr 2               ; if they're the same. Then the round starts.
000C4Cr 2               LinkGo:
000C4Cr 2  A9 01          lda #1
000C4Er 2  85 8C          sta LINK_UP
000C50r 2  64 AB          stz HAVE_OLD
000C52r 2  A2 01          ldx #1
000C54r 2  A5 92          lda MY_NONCE
000C56r 2  C5 94          cmp PEER_NONCE
000C58r 2  A5 93          lda MY_NONCE+1
000C5Ar 2  E5 95          sbc PEER_NONCE+1
000C5Cr 2  B0 02          bcs @seat
000C5Er 2  A2 00          ldx #0
000C60r 2               @seat:
000C60r 2  86 91          stx MY_SEAT
000C62r 2  A5 92          lda MY_NONCE
000C64r 2  45 93          eor MY_NONCE+1
000C66r 2  45 94          eor PEER_NONCE
000C68r 2  45 95          eor PEER_NONCE+1
000C6Ar 2  85 98          sta SESSION                      ; the same on both machines
000C6Cr 2  A5 96          lda MY_COLOR
000C6Er 2  A4 97          ldy PEER_COLOR
000C70r 2  E0 00          cpx #0
000C72r 2  F0 04          beq @colors
000C74r 2  A5 97          lda PEER_COLOR
000C76r 2  A4 96          ldy MY_COLOR
000C78r 2               @colors:
000C78r 2  85 62          sta P1_COLOR_IDX
000C7Ar 2  C4 62          cpy P1_COLOR_IDX
000C7Cr 2  D0 07          bne @differ
000C7Er 2  C8             iny
000C7Fr 2  C0 07          cpy #7
000C81r 2  90 02          bcc @differ
000C83r 2  A0 00          ldy #0
000C85r 2               @differ:
000C85r 2  84 63          sty P2_COLOR_IDX
000C87r 2  20 rr rr       jsr ApplySelectedTrailColors
000C8Ar 2  A5 C5          lda MY_SPEED                     ; the first seat's speed
000C8Cr 2  A6 91          ldx MY_SEAT
000C8Er 2  F0 02          beq @speed
000C90r 2  A5 C6          lda PEER_SPEED
000C92r 2               @speed:
000C92r 2  85 C3          sta SPEED
000C94r 2  AA             tax
000C95r 2  BD rr rr       lda LinkDelays,x
000C98r 2  85 C8          sta LDELAY
000C9Ar 2  20 rr rr       jsr SendHello
000C9Dr 2  20 rr rr       jsr StartRound
000CA0r 2                 ; Ticks before LDELAY take each rider as it starts.
000CA0r 2  64 99          stz LT
000CA2r 2  64 9C          stz SAMPLED
000CA4r 2  64 9F          stz STALL_T
000CA6r 2  A5 C8          lda LDELAY
000CA8r 2  3A             dec a
000CA9r 2  85 9A          sta MY_LAST
000CABr 2  85 9B          sta PEER_LAST
000CADr 2  A9 03          lda #DIR_RIGHT
000CAFr 2  A0 02          ldy #DIR_LEFT
000CB1r 2  A6 91          ldx MY_SEAT
000CB3r 2  F0 04          beq @dirs
000CB5r 2  A9 02          lda #DIR_LEFT
000CB7r 2  A0 03          ldy #DIR_RIGHT
000CB9r 2               @dirs:
000CB9r 2  85 9D          sta LOCAL_DIR
000CBBr 2  A6 C8          ldx LDELAY
000CBDr 2  CA             dex
000CBEr 2               @fill:
000CBEr 2  9D 30 09       sta MY_IN,x
000CC1r 2  48             pha
000CC2r 2  98             tya
000CC3r 2  9D 38 09       sta PEER_IN,x
000CC6r 2  68             pla
000CC7r 2  CA             dex
000CC8r 2  10 F4          bpl @fill
000CCAr 2  A9 FF          lda #$FF
000CCCr 2  85 43          sta P1_NEXT_DIR
000CCEr 2  85 48          sta P2_NEXT_DIR
000CD0r 2  20 rr rr       jsr StateSum
000CD3r 2  8D 40 09       sta SUMS
000CD6r 2  A9 03          lda #LINK_RESEND
000CD8r 2  85 9E          sta LINK_T
000CDAr 2  60             rts
000CDBr 2               
000CDBr 2               ; --- A linked round ---
000CDBr 2               
000CDBr 2               ; TickLink - a tick of a linked round, or another try at one: called every
000CDBr 2               ; frame while it waits on the other machine.
000CDBr 2               TickLink:
000CDBr 2  A5 8D          lda LINK_BAD
000CDDr 2  F0 03          beq @fine
000CDFr 2  4C rr rr       jmp LinkBroken
000CE2r 2               @fine:
000CE2r 2                 ; This machine's player steers with either stick or either key cluster:
000CE2r 2                 ; whichever moved since the last look (PollInput and PollInputP2 only
000CE2r 2                 ; write a heading when one is held).
000CE2r 2  A5 43          lda P1_NEXT_DIR
000CE4r 2  C9 FF          cmp #$FF
000CE6r 2  D0 06          bne @local
000CE8r 2  A5 48          lda P2_NEXT_DIR
000CEAr 2  C9 FF          cmp #$FF
000CECr 2  F0 02          beq @sample
000CEEr 2               @local:
000CEEr 2  85 9D          sta LOCAL_DIR
000CF0r 2               @sample:
000CF0r 2  A9 FF          lda #$FF
000CF2r 2  85 43          sta P1_NEXT_DIR
000CF4r 2  85 48          sta P2_NEXT_DIR
000CF6r 2  A5 9C          lda SAMPLED                      ; once a tick: our heading for LDELAY on
000CF8r 2  D0 18          bne @peer
000CFAr 2  E6 9C          inc SAMPLED
000CFCr 2  A5 99          lda LT
000CFEr 2  18             clc
000CFFr 2  65 C8          adc LDELAY
000D01r 2  85 9A          sta MY_LAST
000D03r 2  29 07          and #7
000D05r 2  AA             tax
000D06r 2  A5 9D          lda LOCAL_DIR
000D08r 2  9D 30 09       sta MY_IN,x
000D0Br 2  20 rr rr       jsr SendInput
000D0Er 2  A9 03          lda #LINK_RESEND
000D10r 2  85 9E          sta LINK_T
000D12r 2               @peer:
000D12r 2  A5 9B          lda PEER_LAST                    ; the other machine's heading for this tick?
000D14r 2  38             sec
000D15r 2  E5 99          sbc LT
000D17r 2  10 36          bpl @go
000D19r 2                 ; Not yet: try again next frame, and send ours again now and then.
000D19r 2  A9 01          lda #1
000D1Br 2  85 B0          sta FRAMES_LEFT
000D1Dr 2  A5 9F          lda STALL_T
000D1Fr 2  C9 FF          cmp #255
000D21r 2  F0 0D          beq @long
000D23r 2  E6 9F          inc STALL_T
000D25r 2  A5 9F          lda STALL_T
000D27r 2  C9 1E          cmp #WAIT_SHOW
000D29r 2  D0 05          bne @long
000D2Br 2  A9 01          lda #1
000D2Dr 2  20 rr rr       jsr SetWaiting
000D30r 2               @long:
000D30r 2  A5 9F          lda STALL_T
000D32r 2  C9 1E          cmp #WAIT_SHOW
000D34r 2  90 0D          bcc @resend
000D36r 2  A5 4D          lda FIRE_EDGE                    ; given up on
000D38r 2  F0 09          beq @resend
000D3Ar 2  20 rr rr       jsr SndSelect
000D3Dr 2  20 rr rr       jsr LinkOff
000D40r 2  4C rr rr       jmp DrawTitleScreen
000D43r 2               @resend:
000D43r 2  C6 9E          dec LINK_T
000D45r 2  D0 07          bne @wait
000D47r 2  A9 03          lda #LINK_RESEND
000D49r 2  85 9E          sta LINK_T
000D4Br 2  4C rr rr       jmp SendOld
000D4Er 2               @wait:
000D4Er 2  60             rts
000D4Fr 2               
000D4Fr 2               @go:
000D4Fr 2  A5 9F          lda STALL_T
000D51r 2  C9 1E          cmp #WAIT_SHOW
000D53r 2  90 05          bcc @calm
000D55r 2  A9 00          lda #0
000D57r 2  20 rr rr       jsr SetWaiting
000D5Ar 2               @calm:
000D5Ar 2  64 9F          stz STALL_T
000D5Cr 2  A5 99          lda LT
000D5Er 2  29 07          and #7
000D60r 2  AA             tax
000D61r 2  BD 30 09       lda MY_IN,x
000D64r 2  BC 38 09       ldy PEER_IN,x
000D67r 2  A6 91          ldx MY_SEAT
000D69r 2  F0 05          beq @put
000D6Br 2  85 AE          sta LINK_TMP
000D6Dr 2  98             tya
000D6Er 2  A4 AE          ldy LINK_TMP
000D70r 2               @put:
000D70r 2  85 43          sta P1_NEXT_DIR
000D72r 2  84 48          sty P2_NEXT_DIR
000D74r 2  20 rr rr       jsr PlayTick
000D77r 2  A9 FF          lda #$FF
000D79r 2  85 43          sta P1_NEXT_DIR
000D7Br 2  85 48          sta P2_NEXT_DIR
000D7Dr 2  E6 99          inc LT
000D7Fr 2  64 9C          stz SAMPLED
000D81r 2  20 rr rr       jsr StateSum
000D84r 2  48             pha
000D85r 2  A5 99          lda LT
000D87r 2  29 07          and #7
000D89r 2  AA             tax
000D8Ar 2  68             pla
000D8Br 2  9D 40 09       sta SUMS,x
000D8Er 2  60             rts
000D8Fr 2               
000D8Fr 2               ; StateSum - A = a check of the round as it stands at tick LT.
000D8Fr 2               StateSum:
000D8Fr 2  A5 99          lda LT
000D91r 2  18             clc
000D92r 2  65 40          adc P1_X
000D94r 2  65 BB          adc P1_XH
000D96r 2  65 41          adc P1_Y
000D98r 2  65 42          adc P1_DIR
000D9Ar 2  65 44          adc P1_ALIVE
000D9Cr 2  65 45          adc P2_X
000D9Er 2  65 BC          adc P2_XH
000DA0r 2  65 46          adc P2_Y
000DA2r 2  65 47          adc P2_DIR
000DA4r 2  65 49          adc P2_ALIVE
000DA6r 2  60             rts
000DA7r 2               
000DA7r 2               ; LinkBroken - the two machines disagree about the round: stop and say so.
000DA7r 2               LinkBroken:
000DA7r 2  A9 00          lda #0
000DA9r 2  20 rr rr       jsr SetWaiting
000DACr 2  A9 04          lda #RESULT_SYNC
000DAEr 2  85 61          sta ROUND_RESULT
000DB0r 2  A9 03          lda #STATE_GAMEOVER
000DB2r 2  85 3A          sta GAME_STATE
000DB4r 2  4C rr rr       jmp DrawGameOverScreen
000DB7r 2               
000DB7r 2               ; LinkOver - a tick after a linked round: keep our last headings going out, in
000DB7r 2               ; case the other machine is still waiting on them. A starts another round, or
000DB7r 2               ; after a disagreement goes back to the title.
000DB7r 2               LinkOver:
000DB7r 2  C6 9E          dec LINK_T
000DB9r 2  D0 07          bne @fire
000DBBr 2  A9 04          lda #HELLO_RESEND
000DBDr 2  85 9E          sta LINK_T
000DBFr 2  20 rr rr       jsr SendOld
000DC2r 2               @fire:
000DC2r 2  A5 4D          lda FIRE_EDGE
000DC4r 2  F0 16          beq @done
000DC6r 2  A5 61          lda ROUND_RESULT
000DC8r 2  C9 04          cmp #RESULT_SYNC
000DCAr 2  F0 07          beq @quit
000DCCr 2  A9 01          lda #1
000DCEr 2  85 AB          sta HAVE_OLD
000DD0r 2  4C rr rr       jmp EnterLink
000DD3r 2               @quit:
000DD3r 2  20 rr rr       jsr SndSelect
000DD6r 2  20 rr rr       jsr LinkOff
000DD9r 2  4C rr rr       jmp DrawTitleScreen
000DDCr 2               @done:
000DDCr 2  60             rts
000DDDr 2               
000DDDr 2               ; --- Sending ---
000DDDr 2               
000DDDr 2               ; SendFrame - TX_FRAME, with its sync and check.
000DDDr 2               SendFrame:
000DDDr 2  A9 A5          lda #FRAME_SYNC
000DDFr 2  8D 10 09       sta TX_FRAME
000DE2r 2  A9 10          lda #<TX_FRAME
000DE4r 2  A2 09          ldx #>TX_FRAME
000DE6r 2  20 rr rr       jsr FrameCheck
000DE9r 2  A5 A4          lda CK_A
000DEBr 2  8D 19 09       sta TX_FRAME + FRAME_SIZE - 2
000DEEr 2  A5 A5          lda CK_B
000DF0r 2  8D 1A 09       sta TX_FRAME + FRAME_SIZE - 1
000DF3r 2  A2 00          ldx #0
000DF5r 2               @send:
000DF5r 2  BD 10 09       lda TX_FRAME,x
000DF8r 2  20 rr rr       jsr SendByte
000DFBr 2  E8             inx
000DFCr 2  E0 0B          cpx #FRAME_SIZE
000DFEr 2  D0 F5          bne @send
000E00r 2  60             rts
000E01r 2               
000E01r 2               ; SendOld - the last INPUT frame again.
000E01r 2               SendOld:
000E01r 2  A2 00          ldx #0
000E03r 2               @send:
000E03r 2  BD 20 09       lda OLD_TX,x
000E06r 2  20 rr rr       jsr SendByte
000E09r 2  E8             inx
000E0Ar 2  E0 0B          cpx #FRAME_SIZE
000E0Cr 2  D0 F5          bne @send
000E0Er 2  60             rts
000E0Fr 2               
000E0Fr 2               ; FrameCheck - CK_A, CK_B = the check of the frame at A (low), X (high). Two
000E0Fr 2               ; sums, the second over the first, so a frame put together from the pieces of
000E0Fr 2               ; two others, after a lost byte, doesn't pass by chance.
000E0Fr 2               FrameCheck:
000E0Fr 2  85 A7          sta FR_PTR
000E11r 2  86 A8          stx FR_PTR+1
000E13r 2  A9 5A          lda #$5A
000E15r 2  85 A4          sta CK_A
000E17r 2  A9 A5          lda #$A5
000E19r 2  85 A5          sta CK_B
000E1Br 2  A0 01          ldy #1
000E1Dr 2               @byte:
000E1Dr 2  B1 A7          lda (FR_PTR),y
000E1Fr 2  18             clc
000E20r 2  65 A4          adc CK_A
000E22r 2  85 A4          sta CK_A
000E24r 2  18             clc
000E25r 2  65 A5          adc CK_B
000E27r 2  85 A5          sta CK_B
000E29r 2  C8             iny
000E2Ar 2  C0 09          cpy #FRAME_SIZE - 2
000E2Cr 2  D0 EF          bne @byte
000E2Er 2  60             rts
000E2Fr 2               
000E2Fr 2               ; SendByte - A out of the serial port, once the last byte has gone. Not the
000E2Fr 2               ; Kernal's routine: while it waits it puts arriving bytes in the keyboard
000E2Fr 2               ; buffer, where they'd read as key presses. Here they go in the ring. Keeps X.
000E2Fr 2               SendByte:
000E2Fr 2  48             pha
000E30r 2  78             sei
000E31r 2               @wait:
000E31r 2  AD 01 90       lda SC_STATUS
000E34r 2  85 A6          sta LINK_S
000E36r 2  29 08          and #SC_STATUS_RDRF
000E38r 2  F0 0C          beq @noByte
000E3Ar 2  DA             phx
000E3Br 2  AD 00 90       lda SC_DATA
000E3Er 2  A6 A0          ldx RX_HEAD
000E40r 2  9D 00 08       sta RX_BUF,x
000E43r 2  E6 A0          inc RX_HEAD
000E45r 2  FA             plx
000E46r 2               @noByte:
000E46r 2  A5 A6          lda LINK_S
000E48r 2  29 10          and #SC_STATUS_TDRE
000E4Ar 2  F0 E5          beq @wait
000E4Cr 2  68             pla
000E4Dr 2  8D 00 90       sta SC_DATA
000E50r 2  58             cli
000E51r 2  60             rts
000E52r 2               
000E52r 2               ; SendHello - who this machine is, its color, and how far along: 0 looking,
000E52r 2               ; 1 has heard the other machine, 2 has started.
000E52r 2               SendHello:
000E52r 2  A9 01          lda #FR_HELLO
000E54r 2  8D 11 09       sta TX_FRAME+1
000E57r 2  9C 12 09       stz TX_FRAME+2
000E5Ar 2  A5 92          lda MY_NONCE
000E5Cr 2  8D 13 09       sta TX_FRAME+3
000E5Fr 2  A5 93          lda MY_NONCE+1
000E61r 2  8D 14 09       sta TX_FRAME+4
000E64r 2  A5 96          lda MY_COLOR
000E66r 2  8D 15 09       sta TX_FRAME+5
000E69r 2  A5 8C          lda LINK_UP
000E6Br 2  F0 04          beq @notUp
000E6Dr 2  A9 02          lda #2
000E6Fr 2  80 02          bra @stage
000E71r 2               @notUp:
000E71r 2  A5 8F          lda HAVE_HELLO
000E73r 2               @stage:
000E73r 2  8D 16 09       sta TX_FRAME+6
000E76r 2  A9 02          lda #LINK_VERSION
000E78r 2  8D 17 09       sta TX_FRAME+7
000E7Br 2  A5 C5          lda MY_SPEED
000E7Dr 2  8D 18 09       sta TX_FRAME+8
000E80r 2  4C rr rr       jmp SendFrame
000E83r 2               
000E83r 2               ; SendInput - our headings for ticks MY_LAST back to MY_LAST - 7, two bits
000E83r 2               ; each, the newest lowest: MY_LAST to MY_LAST - 3 in one byte, the four
000E83r 2               ; before that in the next. Kept in OLD_TX to send again.
000E83r 2               SendInput:
000E83r 2  A9 02          lda #FR_INPUT
000E85r 2  8D 11 09       sta TX_FRAME+1
000E88r 2  A5 9A          lda MY_LAST
000E8Ar 2  8D 12 09       sta TX_FRAME+2
000E8Dr 2  38             sec
000E8Er 2  E9 03          sbc #3
000E90r 2  85 AE          sta LINK_TMP                     ; the oldest tick in this byte
000E92r 2  A0 03          ldy #3
000E94r 2               @byte:
000E94r 2  64 AF          stz T_PACK
000E96r 2  A2 04          ldx #4
000E98r 2               @turn:
000E98r 2  06 AF          asl T_PACK
000E9Ar 2  06 AF          asl T_PACK
000E9Cr 2  DA             phx
000E9Dr 2  A5 AE          lda LINK_TMP
000E9Fr 2  29 07          and #7
000EA1r 2  AA             tax
000EA2r 2  BD 30 09       lda MY_IN,x
000EA5r 2  FA             plx
000EA6r 2  29 03          and #3
000EA8r 2  05 AF          ora T_PACK
000EAAr 2  85 AF          sta T_PACK
000EACr 2  E6 AE          inc LINK_TMP
000EAEr 2  CA             dex
000EAFr 2  D0 E7          bne @turn
000EB1r 2  A5 AF          lda T_PACK
000EB3r 2  99 10 09       sta TX_FRAME,y
000EB6r 2  A5 AE          lda LINK_TMP                     ; on to the four before
000EB8r 2  38             sec
000EB9r 2  E9 08          sbc #8
000EBBr 2  85 AE          sta LINK_TMP
000EBDr 2  C8             iny
000EBEr 2  C0 05          cpy #5
000EC0r 2  D0 D2          bne @byte
000EC2r 2  A5 99          lda LT                           ; the round as it stands now, LDELAY
000EC4r 2  29 07          and #7                           ; before MY_LAST
000EC6r 2  AA             tax
000EC7r 2  BD 40 09       lda SUMS,x
000ECAr 2  8D 15 09       sta TX_FRAME+5
000ECDr 2  A5 98          lda SESSION
000ECFr 2  8D 16 09       sta TX_FRAME+6
000ED2r 2  9C 17 09       stz TX_FRAME+7
000ED5r 2  9C 18 09       stz TX_FRAME+8
000ED8r 2  20 rr rr       jsr SendFrame
000EDBr 2  A2 0A          ldx #FRAME_SIZE - 1
000EDDr 2               @keep:
000EDDr 2  BD 10 09       lda TX_FRAME,x
000EE0r 2  9D 20 09       sta OLD_TX,x
000EE3r 2  CA             dex
000EE4r 2  10 F7          bpl @keep
000EE6r 2  60             rts
000EE7r 2               
000EE7r 2               ; --- Receiving ---
000EE7r 2               
000EE7r 2               ; LinkPoll - take what has arrived, a limited amount a frame.
000EE7r 2               LinkPoll:
000EE7r 2  A5 8B          lda LINK_ON
000EE9r 2  F0 34          beq @done
000EEBr 2  A9 28          lda #POLL_BYTES
000EEDr 2  85 A3          sta LINK_N
000EEFr 2               @next:
000EEFr 2  A6 A1          ldx RX_TAIL
000EF1r 2  E4 A0          cpx RX_HEAD
000EF3r 2  F0 2A          beq @done
000EF5r 2  BD 00 08       lda RX_BUF,x
000EF8r 2  E6 A1          inc RX_TAIL
000EFAr 2  A6 A2          ldx PARSE_N
000EFCr 2  D0 04          bne @inFrame
000EFEr 2  C9 A5          cmp #FRAME_SYNC
000F00r 2  D0 19          bne @count
000F02r 2               @inFrame:
000F02r 2  9D 00 09       sta FRAME,x
000F05r 2  E8             inx
000F06r 2  86 A2          stx PARSE_N
000F08r 2  E0 0B          cpx #FRAME_SIZE
000F0Ar 2  D0 0F          bne @count
000F0Cr 2  64 A2          stz PARSE_N
000F0Er 2  20 rr rr       jsr FrameOk
000F11r 2  90 05          bcc @damaged
000F13r 2  20 rr rr       jsr TakeFrame
000F16r 2  80 03          bra @count
000F18r 2               @damaged:
000F18r 2  20 rr rr       jsr Resync
000F1Br 2               @count:
000F1Br 2  C6 A3          dec LINK_N
000F1Dr 2  D0 D0          bne @next
000F1Fr 2               @done:
000F1Fr 2  60             rts
000F20r 2               
000F20r 2               ; FrameOk - carry set if the frame that just came in passes its check.
000F20r 2               FrameOk:
000F20r 2  A9 00          lda #<FRAME
000F22r 2  A2 09          ldx #>FRAME
000F24r 2  20 rr rr       jsr FrameCheck
000F27r 2  A5 A4          lda CK_A
000F29r 2  CD 09 09       cmp FRAME + FRAME_SIZE - 2
000F2Cr 2  D0 09          bne @bad
000F2Er 2  A5 A5          lda CK_B
000F30r 2  CD 0A 09       cmp FRAME + FRAME_SIZE - 1
000F33r 2  D0 02          bne @bad
000F35r 2  38             sec
000F36r 2  60             rts
000F37r 2               @bad:
000F37r 2  18             clc
000F38r 2  60             rts
000F39r 2               
000F39r 2               ; Resync - a frame that failed its check starts again from the next sync byte
000F39r 2               ; inside it. After a lost byte that's the start of the frame behind it, which
000F39r 2               ; would otherwise be lost as well. A sync byte that turns out to be data fails
000F39r 2               ; its check in turn and the search moves on.
000F39r 2               Resync:
000F39r 2  A2 01          ldx #1
000F3Br 2               @find:
000F3Br 2  BD 00 09       lda FRAME,x
000F3Er 2  C9 A5          cmp #FRAME_SYNC
000F40r 2  F0 06          beq @found
000F42r 2  E8             inx
000F43r 2  E0 0B          cpx #FRAME_SIZE
000F45r 2  D0 F4          bne @find
000F47r 2  60             rts                              ; none: wait for the next one
000F48r 2               @found:
000F48r 2  A0 00          ldy #0
000F4Ar 2               @move:
000F4Ar 2  BD 00 09       lda FRAME,x
000F4Dr 2  99 00 09       sta FRAME,y
000F50r 2  C8             iny
000F51r 2  E8             inx
000F52r 2  E0 0B          cpx #FRAME_SIZE
000F54r 2  D0 F4          bne @move
000F56r 2  84 A2          sty PARSE_N
000F58r 2  60             rts
000F59r 2               
000F59r 2               ; TakeFrame - act on a frame that passed its check.
000F59r 2               TakeFrame:
000F59r 2  AD 01 09       lda FRAME+1
000F5Cr 2  C9 01          cmp #FR_HELLO
000F5Er 2  F0 74          beq TakeHello
000F60r 2  C9 02          cmp #FR_INPUT
000F62r 2  F0 01          beq TakeInput
000F64r 2  60             rts
000F65r 2               
000F65r 2               TakeInput:
000F65r 2  A5 8C          lda LINK_UP
000F67r 2  F0 50          beq @done
000F69r 2  A5 3A          lda GAME_STATE
000F6Br 2  C9 01          cmp #STATE_PLAYING
000F6Dr 2  D0 4A          bne @done
000F6Fr 2  AD 06 09       lda FRAME+6
000F72r 2  C5 98          cmp SESSION
000F74r 2  D0 43          bne @done                        ; from an earlier round
000F76r 2                 ; Its check, if this machine has been at that tick in the last eight.
000F76r 2  AD 02 09       lda FRAME+2
000F79r 2  38             sec
000F7Ar 2  E5 C8          sbc LDELAY
000F7Cr 2  85 AE          sta LINK_TMP
000F7Er 2  A5 99          lda LT
000F80r 2  38             sec
000F81r 2  E5 AE          sbc LINK_TMP
000F83r 2  C9 08          cmp #8
000F85r 2  B0 12          bcs @headings
000F87r 2  A5 AE          lda LINK_TMP
000F89r 2  29 07          and #7
000F8Br 2  AA             tax
000F8Cr 2  BD 40 09       lda SUMS,x
000F8Fr 2  CD 05 09       cmp FRAME+5
000F92r 2  F0 05          beq @headings
000F94r 2  A9 01          lda #BAD_SYNC
000F96r 2  85 8D          sta LINK_BAD
000F98r 2  60             rts
000F99r 2               @headings:
000F99r 2  AD 02 09       lda FRAME+2                      ; anything newer than we have?
000F9Cr 2  38             sec
000F9Dr 2  E5 9B          sbc PEER_LAST
000F9Fr 2  F0 18          beq @done
000FA1r 2  30 16          bmi @done
000FA3r 2  AD 02 09       lda FRAME+2
000FA6r 2  85 AE          sta LINK_TMP
000FA8r 2  AD 03 09       lda FRAME+3
000FABr 2  20 rr rr       jsr Unpack4
000FAEr 2  AD 04 09       lda FRAME+4
000FB1r 2  20 rr rr       jsr Unpack4
000FB4r 2  AD 02 09       lda FRAME+2
000FB7r 2  85 9B          sta PEER_LAST
000FB9r 2               @done:
000FB9r 2  60             rts
000FBAr 2               
000FBAr 2               ; Unpack4 - four headings from A into PEER_IN, for LINK_TMP and the three
000FBAr 2               ; ticks before it; LINK_TMP moves back four.
000FBAr 2               Unpack4:
000FBAr 2  85 AF          sta T_PACK
000FBCr 2  A0 04          ldy #4
000FBEr 2               @turn:
000FBEr 2  A5 AE          lda LINK_TMP
000FC0r 2  29 07          and #7
000FC2r 2  AA             tax
000FC3r 2  A5 AF          lda T_PACK
000FC5r 2  29 03          and #3
000FC7r 2  9D 38 09       sta PEER_IN,x
000FCAr 2  46 AF          lsr T_PACK
000FCCr 2  46 AF          lsr T_PACK
000FCEr 2  C6 AE          dec LINK_TMP
000FD0r 2  88             dey
000FD1r 2  D0 EB          bne @turn
000FD3r 2  60             rts
000FD4r 2               
000FD4r 2               TakeHello:
000FD4r 2  AD 07 09       lda FRAME+7
000FD7r 2  C9 02          cmp #LINK_VERSION
000FD9r 2  F0 0B          beq @version
000FDBr 2  A5 3A          lda GAME_STATE
000FDDr 2  C9 05          cmp #STATE_LINKING
000FDFr 2  D0 69          bne @done
000FE1r 2  A9 02          lda #BAD_VERSION
000FE3r 2  85 8D          sta LINK_BAD
000FE5r 2  60             rts
000FE6r 2               @version:
000FE6r 2  A5 8C          lda LINK_UP
000FE8r 2  F0 18          beq @looking
000FEAr 2                 ; Already playing: it may not know yet.
000FEAr 2  AD 03 09       lda FRAME+3
000FEDr 2  C5 94          cmp PEER_NONCE
000FEFr 2  D0 59          bne @done
000FF1r 2  AD 04 09       lda FRAME+4
000FF4r 2  C5 95          cmp PEER_NONCE+1
000FF6r 2  D0 52          bne @done
000FF8r 2  AD 06 09       lda FRAME+6
000FFBr 2  C9 02          cmp #2
000FFDr 2  B0 4B          bcs @done
000FFFr 2  4C rr rr       jmp SendHello
001002r 2               @looking:
001002r 2  A5 3A          lda GAME_STATE
001004r 2  C9 05          cmp #STATE_LINKING
001006r 2  D0 42          bne @done
001008r 2  AD 03 09       lda FRAME+3
00100Br 2  C5 92          cmp MY_NONCE
00100Dr 2  D0 0E          bne @other
00100Fr 2  AD 04 09       lda FRAME+4
001012r 2  C5 93          cmp MY_NONCE+1
001014r 2  D0 07          bne @other
001016r 2  64 8F          stz HAVE_HELLO                   ; the same number: both pick again
001018r 2  64 90          stz PEER_HAS
00101Ar 2  4C rr rr       jmp NewNonce
00101Dr 2               @other:
00101Dr 2  AD 03 09       lda FRAME+3
001020r 2  85 94          sta PEER_NONCE
001022r 2  AD 04 09       lda FRAME+4
001025r 2  85 95          sta PEER_NONCE+1
001027r 2  AD 05 09       lda FRAME+5
00102Ar 2  C9 07          cmp #7
00102Cr 2  90 02          bcc @color
00102Er 2  A9 00          lda #0
001030r 2               @color:
001030r 2  85 97          sta PEER_COLOR
001032r 2  AD 08 09       lda FRAME+8
001035r 2  C9 03          cmp #3
001037r 2  90 02          bcc @speed
001039r 2  A9 01          lda #SPEED_NORMAL
00103Br 2               @speed:
00103Br 2  85 C6          sta PEER_SPEED
00103Dr 2  A9 01          lda #1
00103Fr 2  85 8F          sta HAVE_HELLO
001041r 2  AD 06 09       lda FRAME+6
001044r 2  F0 05          beq @answer
001046r 2  A9 01          lda #1
001048r 2  85 90          sta PEER_HAS
00104Ar 2               @done:
00104Ar 2  60             rts
00104Br 2               @answer:
00104Br 2  4C rr rr       jmp SendHello
00104Er 2               
00104Er 1               .include "src/game.asm"
00104Er 2               ; =============================================================================
00104Er 2               ;   game.asm - pixel-precision TrailDuel game loop
00104Er 2               ; =============================================================================
00104Er 2               
00104Er 2               .segment "CART"
00104Er 2               
00104Er 2               NewGame:
00104Er 2  A9 00          lda #MODE_1P
001050r 2  85 3B          sta GAME_MODE
001052r 2  A9 04          lda #4                    ; TrailFgColorTable[4] = LT_BLUE
001054r 2  85 62          sta P1_COLOR_IDX
001056r 2  A9 01          lda #1                    ; TrailFgColorTable[1] = LT_YELLOW
001058r 2  85 63          sta P2_COLOR_IDX
00105Ar 2  64 C0          stz MENU_ROW
00105Cr 2  64 C2          stz MENU_PREV
00105Er 2  A9 01          lda #SPEED_NORMAL
001060r 2  85 C3          sta SPEED
001062r 2  20 rr rr       jsr ApplySelectedTrailColors
001065r 2  A9 2A          lda #$2A
001067r 2  85 3C          sta RNG_STATE
001069r 2  20 rr rr       jsr DrawTitleScreen
00106Cr 2  60             rts
00106Dr 2               
00106Dr 2               Tick:
00106Dr 2  A9 05          lda #TICK_FRAMES                ; until the next tick, unless a linked round
00106Fr 2  85 B0          sta FRAMES_LEFT                 ; is waiting on the other machine
001071r 2  A5 3A          lda GAME_STATE
001073r 2  C9 00          cmp #STATE_TITLE
001075r 2  D0 03          bne :+
001077r 2  4C rr rr       jmp TickTitle
00107Ar 2               :
00107Ar 2  C9 01          cmp #STATE_PLAYING
00107Cr 2  D0 03          bne :+
00107Er 2  4C rr rr       jmp TickPlaying
001081r 2               :
001081r 2  C9 04          cmp #STATE_PAUSED
001083r 2  D0 03          bne :+
001085r 2  4C rr rr       jmp TickPaused
001088r 2               :
001088r 2  C9 03          cmp #STATE_GAMEOVER
00108Ar 2  D0 03          bne :+
00108Cr 2  4C rr rr       jmp TickGameOver
00108Fr 2               :
00108Fr 2  C9 05          cmp #STATE_LINKING
001091r 2  D0 03          bne :+
001093r 2  4C rr rr       jmp TickLinking
001096r 2               :
001096r 2  4C rr rr       jmp TickDone
001099r 2               
001099r 2               TickTitle:
001099r 2  20 rr rr       jsr MenuInput
00109Cr 2  A5 4D          lda FIRE_EDGE
00109Er 2  D0 03          bne :+
0010A0r 2  4C rr rr       jmp TickDone
0010A3r 2               :
0010A3r 2  A5 3B          lda GAME_MODE
0010A5r 2  C9 02          cmp #MODE_LINK
0010A7r 2  D0 03          bne :+
0010A9r 2  4C rr rr       jmp EnterLink
0010ACr 2               :
0010ACr 2  20 rr rr       jsr StartRound
0010AFr 2  60             rts
0010B0r 2               
0010B0r 2               TickGameOver:
0010B0r 2  A5 3B          lda GAME_MODE
0010B2r 2  C9 02          cmp #MODE_LINK
0010B4r 2  D0 07          bne :+
0010B6r 2  A5 8B          lda LINK_ON
0010B8r 2  F0 03          beq :+
0010BAr 2  4C rr rr       jmp LinkOver
0010BDr 2               :
0010BDr 2  A5 4D          lda FIRE_EDGE
0010BFr 2  D0 03          bne :+
0010C1r 2  4C rr rr       jmp TickDone
0010C4r 2               :
0010C4r 2  20 rr rr       jsr SndSelect
0010C7r 2  4C rr rr       jmp DrawTitleScreen
0010CAr 2               
0010CAr 2               ; Frames a tick at each speed: 20, 30 and 60 pixels a second
0010CAr 2               SpeedFrames:
0010CAr 2  03 02 01       .byte 3, 2, 1
0010CDr 2               
0010CDr 2               TickPaused:
0010CDr 2  A5 4D          lda FIRE_EDGE
0010CFr 2  D0 03          bne :+
0010D1r 2  4C rr rr       jmp TickDone
0010D4r 2               :
0010D4r 2  A9 01          lda #STATE_PLAYING
0010D6r 2  85 3A          sta GAME_STATE
0010D8r 2  4C rr rr       jmp SndSelect
0010DBr 2               
0010DBr 2               TickPlaying:
0010DBr 2  A6 C3          ldx SPEED                       ; the round's pace: frames to the next tick
0010DDr 2  BD rr rr       lda SpeedFrames,x
0010E0r 2  85 B0          sta FRAMES_LEFT
0010E2r 2  A5 3B          lda GAME_MODE
0010E4r 2  C9 02          cmp #MODE_LINK
0010E6r 2  D0 03          bne @here
0010E8r 2  4C rr rr       jmp TickLink
0010EBr 2               @here:
0010EBr 2  A5 4D          lda FIRE_EDGE
0010EDr 2  F0 07          beq @playAdvance
0010EFr 2  A9 04          lda #STATE_PAUSED
0010F1r 2  85 3A          sta GAME_STATE
0010F3r 2  4C rr rr       jmp SndSelect
0010F6r 2               
0010F6r 2               @playAdvance:
0010F6r 2  A5 3B          lda GAME_MODE
0010F8r 2  C9 00          cmp #MODE_1P
0010FAr 2  D0 03          bne @skipAi
0010FCr 2  20 rr rr       jsr ComputeP2AIDirection
0010FFr 2               @skipAi:
0010FFr 2                 ; falls through
0010FFr 2               
0010FFr 2               ; PlayTick - the riders turn, move and crash, each as its NEXT_DIR asks.
0010FFr 2               PlayTick:
0010FFr 2  20 rr rr       jsr ApplyRequestedTurns
001102r 2               
001102r 2  20 rr rr       jsr ComputeNextPositions
001105r 2               
001105r 2  A5 56          lda P1_NEXT_X
001107r 2  C5 58          cmp P2_NEXT_X
001109r 2  D0 13          bne @notHeadOn
00110Br 2  A5 BD          lda P1_NEXT_XH
00110Dr 2  C5 BE          cmp P2_NEXT_XH
00110Fr 2  D0 0D          bne @notHeadOn
001111r 2  A5 57          lda P1_NEXT_Y
001113r 2  C5 59          cmp P2_NEXT_Y
001115r 2  D0 07          bne @notHeadOn
001117r 2  64 44          stz P1_ALIVE
001119r 2  64 49          stz P2_ALIVE
00111Br 2  4C rr rr       jmp ResolveRound
00111Er 2               
00111Er 2               ; Collision is whether the pixel ahead is already drawn (PixelIsSet): a
00111Er 2               ; trail, either rider's own included, or the border.
00111Er 2               @notHeadOn:
00111Er 2  A5 57          lda P1_NEXT_Y
001120r 2  C9 F0          cmp #240                        ; past the top wraps round to here
001122r 2  B0 0B          bcs P1CollisionDead
001124r 2  A6 BD          ldx P1_NEXT_XH
001126r 2  86 B8          stx PX_HI
001128r 2  A6 56          ldx P1_NEXT_X
00112Ar 2  20 rr rr       jsr PixelIsSet
00112Dr 2  F0 02          beq P1CollisionClear
00112Fr 2               P1CollisionDead:
00112Fr 2  64 44          stz P1_ALIVE
001131r 2               P1CollisionClear:
001131r 2               
001131r 2  A5 59          lda P2_NEXT_Y
001133r 2  C9 F0          cmp #240
001135r 2  B0 0B          bcs P2CollisionDead
001137r 2  A6 BE          ldx P2_NEXT_XH
001139r 2  86 B8          stx PX_HI
00113Br 2  A6 58          ldx P2_NEXT_X
00113Dr 2  20 rr rr       jsr PixelIsSet
001140r 2  F0 02          beq P2CollisionClear
001142r 2               P2CollisionDead:
001142r 2  64 49          stz P2_ALIVE
001144r 2               P2CollisionClear:
001144r 2               
001144r 2               ResolveRound:
001144r 2  A5 44          lda P1_ALIVE
001146r 2  F0 0E          beq ResolveP1Dead
001148r 2  A5 49          lda P2_ALIVE
00114Ar 2  F0 1D          beq ResolveP2DeadOnly
00114Cr 2               
00114Cr 2  20 rr rr       jsr CommitP1Move
00114Fr 2  20 rr rr       jsr CommitP2Move
001152r 2  20 rr rr       jsr UpdateHeadSprites
001155r 2  60             rts
001156r 2               
001156r 2               ResolveP1Dead:
001156r 2  A5 49          lda P2_ALIVE
001158r 2  F0 1E          beq ResolveBothDead
00115Ar 2  A9 02          lda #2                   ; P1 crashed -> P2 wins (ROUND_RESULT names the
00115Cr 2  85 61          sta ROUND_RESULT           ; WINNER, not who died -- this was backwards
00115Er 2                                             ; before: P1 dying set ROUND_RESULT=1, which
00115Er 2                                             ; DrawGameOverScreen reads as "P1 wins"
00115Er 2  A9 03          lda #STATE_GAMEOVER
001160r 2  85 3A          sta GAME_STATE
001162r 2  20 rr rr       jsr SndCrash
001165r 2  20 rr rr       jsr DrawGameOverScreen
001168r 2  60             rts
001169r 2               
001169r 2               ResolveP2DeadOnly:
