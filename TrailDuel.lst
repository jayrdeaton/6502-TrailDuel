000367r 2               
000367r 2               ; --- Pixels ---
000367r 2               
000367r 2               ; ComputePixelAddress - where pixel (X, A) lives. In: A = row, X = column's
000367r 2               ; low byte, PX_HI = its bit 8. Out: carry clear, WORK_PTR = its byte in
000367r 2               ; SHADOW, OFFSET_LO/HI = that byte's place in SHADOW, NUM_TMP = which of the
000367r 2               ; byte's four pixels it is; or carry set if it's outside the arena's cells.
000367r 2               ; Keeps X. Clobbers: A, Y, PX_X, PX_Y
000367r 2               ComputePixelAddress:
000367r 2  85 BA          sta PX_Y
000369r 2  86 B9          stx PX_X
00036Br 2  4A             lsr a
00036Cr 2  4A             lsr a
00036Dr 2  4A             lsr a
00036Er 2  C9 02          cmp #FIRST_ROW
000370r 2  90 58          bcc @out
000372r 2  C9 1C          cmp #LAST_ROW + 1
000374r 2  B0 54          bcs @out
000376r 2  A8             tay
000377r 2  8A             txa
000378r 2  4A             lsr a
000379r 2  4A             lsr a
00037Ar 2  4A             lsr a
00037Br 2  A6 B8          ldx PX_HI
00037Dr 2  F0 02          beq @col
00037Fr 2  09 20          ora #$20                         ; past 255: 32 cells on
000381r 2               @col:
000381r 2  C9 01          cmp #FIRST_COL
000383r 2  90 45          bcc @out
000385r 2  C9 27          cmp #LAST_COL + 1
000387r 2  B0 41          bcs @out
000389r 2  AA             tax
00038Ar 2  B9 rr rr       lda RowOffLo,y
00038Dr 2  18             clc
00038Er 2  7D rr rr       adc ColOffLo,x
000391r 2  85 50          sta OFFSET_LO
000393r 2  B9 rr rr       lda RowOffHi,y
000396r 2  7D rr rr       adc ColOffHi,x
000399r 2  85 51          sta OFFSET_HI
00039Br 2  A5 BA          lda PX_Y                         ; two bytes a row
00039Dr 2  29 07          and #7
00039Fr 2  0A             asl a
0003A0r 2  85 5F          sta NUM_TMP
0003A2r 2  A5 B9          lda PX_X                         ; four pixels a byte
0003A4r 2  29 04          and #4
0003A6r 2  4A             lsr a
0003A7r 2  4A             lsr a
0003A8r 2  05 5F          ora NUM_TMP
0003AAr 2  18             clc
0003ABr 2  65 50          adc OFFSET_LO
0003ADr 2  85 50          sta OFFSET_LO
0003AFr 2  90 02          bcc @in
0003B1r 2  E6 51          inc OFFSET_HI
0003B3r 2               @in:
0003B3r 2  A5 50          lda OFFSET_LO
0003B5r 2  18             clc
0003B6r 2  69 00          adc #<SHADOW
0003B8r 2  85 52          sta WORK_PTR
0003BAr 2  A5 51          lda OFFSET_HI
0003BCr 2  69 20          adc #>SHADOW
0003BEr 2  85 53          sta WORK_PTR+1
0003C0r 2  A5 B9          lda PX_X
0003C2r 2  29 03          and #3
0003C4r 2  85 5F          sta NUM_TMP
0003C6r 2  A6 B9          ldx PX_X
0003C8r 2  18             clc
0003C9r 2  60             rts
0003CAr 2               @out:
0003CAr 2  A6 B9          ldx PX_X
0003CCr 2  38             sec
0003CDr 2  60             rts
0003CEr 2               
0003CEr 2               ; PlotValue - the pixel ComputePixelAddress found to value A (0-3), in SHADOW
0003CEr 2               ; and on the card. Clobbers: A, X, Y, VADDR
0003CEr 2               PlotValue:
0003CEr 2  0A             asl a
0003CFr 2  0A             asl a
0003D0r 2  05 5F          ora NUM_TMP
0003D2r 2  A8             tay
0003D3r 2  A6 5F          ldx NUM_TMP
0003D5r 2  B2 52          lda (WORK_PTR)
0003D7r 2  3D rr rr       and PixClear,x
0003DAr 2  19 rr rr       ora PixBits,y
0003DDr 2  92 52          sta (WORK_PTR)
0003DFr 2                 ; The arena's first LAYER_BYTES are layer 0's tiles in bank 1, the rest
0003DFr 2                 ; layer 1's in bank 2, each after its blank tile 0.
0003DFr 2  A5 50          lda OFFSET_LO
0003E1r 2  38             sec
0003E2r 2  E9 E0          sbc #<LAYER_BYTES
0003E4r 2  85 83          sta VADDR
0003E6r 2  A5 51          lda OFFSET_HI
0003E8r 2  E9 1E          sbc #>LAYER_BYTES
0003EAr 2  B0 0A          bcs @second
0003ECr 2  A5 50          lda OFFSET_LO
0003EEr 2  85 83          sta VADDR
0003F0r 2  A5 51          lda OFFSET_HI
0003F2r 2  A0 01          ldy #1
0003F4r 2  80 02          bra @bank
0003F6r 2               @second:
0003F6r 2  A0 02          ldy #2
0003F8r 2               @bank:
0003F8r 2  85 84          sta VADDR+1
0003FAr 2  98             tya
0003FBr 2  20 rr rr       jsr SetVBank
0003FEr 2  A5 83          lda VADDR
000400r 2  18             clc
000401r 2  69 10          adc #16
000403r 2  48             pha
000404r 2  A5 84          lda VADDR+1
000406r 2  69 00          adc #0
000408r 2  AA             tax
000409r 2  68             pla
00040Ar 2  20 rr rr       jsr VAddr
00040Dr 2  B2 52          lda (WORK_PTR)
00040Fr 2  8D 00 9C       sta VC_DATA
000412r 2  60             rts
000413r 2               
000413r 2               ; PixelSetP1Trail / PixelSetP2Trail - a pixel of a player's trail.
000413r 2               ; In: A = row, X = column, PX_HI = column's bit 8.
000413r 2               ; Clobbers: A, X, Y, plus what PlotValue clobbers
000413r 2               PixelSetP1Trail:
000413r 2  A0 01          ldy #1
000415r 2  80 02          bra PlotTrail
000417r 2               PixelSetP2Trail:
