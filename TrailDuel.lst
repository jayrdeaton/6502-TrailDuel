0006F0r 2               
0006F0r 1               .include "src/font.asm"
0006F0r 2               ; ============================================================
0006F0r 2               ; font.asm - 5x7 pixel font for TrailDuel, drawn into the arena by vdp.asm
0006F0r 2               ; ============================================================
0006F0r 2               ; FontData is a dense table covering ASCII $20 (space) through $5A ('Z')
0006F0r 2               ; inclusive, 5 bytes per glyph, in ascending ASCII order with no gaps.
0006F0r 2               ;
0006F0r 2               ; To look up a glyph for character C (where C is in $20..$5A):
0006F0r 2               ;     offset = (C - $20) * 5
0006F0r 2               ;   FontData+offset .. FontData+offset+4 are the glyph's 5 column bytes.
0006F0r 2               ;
0006F0r 2               ; Each glyph is 5 pixels wide x 7 pixels tall, stored as 5 consecutive
0006F0r 2               ; bytes - one byte per COLUMN, left column first (col0, col1, col2,
0006F0r 2               ; col3, col4).
0006F0r 2               ;
0006F0r 2               ; Within each column byte, bits correspond to rows top-to-bottom:
0006F0r 2               ;   bit0 (value $01) = row 0 (TOP row of the glyph)
0006F0r 2               ;   bit1 (value $02) = row 1
0006F0r 2               ;   bit2 (value $04) = row 2
0006F0r 2               ;   bit3 (value $08) = row 3
0006F0r 2               ;   bit4 (value $10) = row 4
0006F0r 2               ;   bit5 (value $20) = row 5
0006F0r 2               ;   bit6 (value $40) = row 6 (BOTTOM row of the glyph)
0006F0r 2               ;   bit7             = unused, always 0
0006F0r 2               ;
0006F0r 2               ; So every byte in this table is in the range $00-$7F.
0006F0r 2               ;
0006F0r 2               ; Example - capital 'A':
0006F0r 2               ;   .XXX.
0006F0r 2               ;   X...X
0006F0r 2               ;   X...X
0006F0r 2               ;   XXXXX
0006F0r 2               ;   X...X
0006F0r 2               ;   X...X
0006F0r 2               ;   X...X
0006F0r 2               ; encodes as: .byte $7E, $09, $09, $09, $7E
0006F0r 2               ;
0006F0r 2               ; Characters that have no clear standard 5x7 glyph, or that this game
0006F0r 2               ; will never plausibly display (# $ % & * @), are left blank (all
0006F0r 2               ; zero bytes) rather than inventing an arbitrary shape for them.
0006F0r 2               ; ============================================================
0006F0r 2               
0006F0r 2               FontData:
0006F0r 2                       ; $20 ' ' (space)
