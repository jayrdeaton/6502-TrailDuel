000817r 1               .include "src/rng.asm"
000817r 2               ; =============================================================================
000817r 2               ;   rng.asm - local bootstrap RNG (to be replaced by 6502-Lib include)
000817r 2               ; =============================================================================
000817r 2               
000817r 2               .segment "CART"
000817r 2               
000817r 2               AdvanceRng:
000817r 2  A5 3C          lda RNG_STATE
000819r 2  4A             lsr a
00081Ar 2  90 02          bcc @noeor
00081Cr 2  49 B4          eor #$B4
00081Er 2               @noeor:
00081Er 2  85 3C          sta RNG_STATE
000820r 2  60             rts
000821r 2               
000821r 1               .include "src/input.asm"
000821r 2               ; =============================================================================
000821r 2               ;   input.asm - TrailDuel input shim using 6502-Lib polling
000821r 2               ; =============================================================================
000821r 2               ;   Joystick-first, keyboard-fallback: PollInput reads both joystick ports
000821r 2               ;   via 6502-Lib's PollJoy1/PollJoy2 and drains the keyboard once a tick;
000821r 2               ;   each player then takes their own stick's direction, falling back to the
000821r 2               ;   keyboard split (WASD=P1, arrows=P2) only when that stick shows no
000821r 2               ;   direction at all this poll (including when no GPIO card is fitted).
000821r 2               ;   PollInputP2, which runs after PollInput in MainLoop, reuses the same
000821r 2               ;   reads rather than draining an already-empty Chrin buffer.
000821r 2               ;
000821r 2               ;   A bike always advances forward every tick regardless of input - turning
000821r 2               ;   is a discrete heading change, not something that needs to be held to
000821r 2               ;   keep moving - so unlike Pong's paddles, no hold/decay layer is needed
000821r 2               ;   here: DrainKeyboardSplit's per-tick "last direction seen" result is the
000821r 2               ;   same sticky-until-changed semantics the joystick-only code already had.
000821r 2               ; =============================================================================
000821r 2               
000821r 2               .include "../../6502-Lib/include/input.inc"
000821r 3               ; =============================================================================
000821r 3               ;   input.inc - interface contract for shared joystick-first input polling
000821r 3               ; =============================================================================
000821r 3               ;
000821r 3               ; Required caller symbols (defined by the consuming project before this
000821r 3               ; file is .include-d):
000821r 3               ;   HW_PRESENT, HW_GPIO, ReadJoystick1, ReadJoystick2,       ; Kernal
000821r 3               ;   BufferSize, ReadBuffer                                     ; Kernal
000821r 3               ;   DIR_UP, DIR_DOWN                        ; caller's own numeric values
000821r 3               ;   DIR_LEFT, DIR_RIGHT                     ; omit both for a 2-directional
000821r 3               ;                                            ; game (e.g. Pong) - LEFT/RIGHT
000821r 3               ;                                            ; checks compile out
000821r 3               ;   JOY_STATE                               ; zero page, for PollJoyCombined
000821r 3               ;                                            ; and PollJoy1
000821r 3               ;   JOY_STATE2                              ; zero page, for PollJoy2
000821r 3               ;   KB_DIR, KB_FIRE                         ; zero page, for
000821r 3               ;                                            ; DrainKeyboardCombined
000821r 3               ;   KB_DIR_P1, KB_DIR_P2, KB_FIRE           ; zero page, for
000821r 3               ;   KB_FIRE_P1, KB_FIRE_P2                  ; DrainKeyboardSplit
000821r 3               ;                                            ; (KB_FIRE_P1/P2 only needed
000821r 3               ;                                            ; by a caller that wants
000821r 3               ;                                            ; independent per-player fire
000821r 3               ;                                            ; - every game as of this
000821r 3               ;                                            ; writing uses the combined
000821r 3               ;                                            ; KB_FIRE instead)
000821r 3               ;
000821r 3               ; Exported routines:
000821r 3               ;   PollJoyCombined       both joystick ports AND-combined (single-player)
000821r 3               ;   PollJoy1 / PollJoy2   one joystick port, gated on HW_GPIO
000821r 3               ;   DrainKeyboardCombined single-player keyboard fallback (WASD or arrows)
000821r 3               ;   DrainKeyboardSplit    two-player keyboard fallback (WASD=P1, arrows=P2)
000821r 3               ;   NextKey               the next key in the buffer, carry clear if none,
000821r 3               ;                         without the echo Chrin does
000821r 3               ;
000821r 3               ; Fire keys: space (KEY_FIRE) is P1's/the single-player fallback; enter
000821r 3               ; (KEY_FIRE2) is P2's. DrainKeyboardCombined accepts either interchangeably
000821r 3               ; into one KB_FIRE flag. DrainKeyboardSplit sets both the combined KB_FIRE
000821r 3               ; (either key, for today's shared start/pause/confirm actions) and the
000821r 3               ; per-player KB_FIRE_P1/KB_FIRE_P2 (for a future game with independent
000821r 3               ; per-player fire, e.g. a two-player shooter).
000821r 3               ;
000821r 3               ; Priority rule every caller composes for itself (see docs/INPUT.md):
000821r 3               ;   Joystick first. If the joystick shows a direction this poll, use it and
000821r 3               ;   ignore the keyboard entirely this poll. Only consult the keyboard's
000821r 3               ;   drained result when the joystick shows nothing. The fire/A button is
000821r 3               ;   OR'd (joystick A or keyboard space, either triggers), independent of
000821r 3               ;   the direction priority.
000821r 3               ; =============================================================================
000821r 3               
000821r 2               .include "../../6502-Lib/core/input.asm"
000821r 3               ; =============================================================================
000821r 3               ;   input.asm - shared joystick-first, keyboard-fallback input primitives
000821r 3               ; =============================================================================
000821r 3               ; Caller contract:
000821r 3               ; - Consuming project defines HW_PRESENT, HW_GPIO, ReadJoystick1,
000821r 3               ;   ReadJoystick2, BufferSize, ReadBuffer (all Kernal-provided) before
000821r 3               ;   including this file.
000821r 3               ; - Consuming project defines its own DIR_UP/DIR_DOWN constants (and
000821r 3               ;   DIR_LEFT/DIR_RIGHT, only if it's a 4-directional game) at whatever
000821r 3               ;   numeric values it already uses - this file references them by name
000821r 3               ;   only, so Snake/LightCycles' 0/1/2/3 and Pong's 1/2 both work unchanged.
000821r 3               ; - Consuming project defines the zero-page output bytes each routine
000821r 3               ;   below documents (JOY_STATE, JOY_STATE2, KB_DIR, KB_DIR_P1, KB_DIR_P2,
000821r 3               ;   KB_FIRE, and - only if calling DrainKeyboardSplit - KB_FIRE_P1,
000821r 3               ;   KB_FIRE_P2) before including this file, at whatever address is free.
000821r 3               ;
000821r 3               ; Exported routines:
000821r 3               ; - PollJoyCombined      both ports AND-combined (single-player, either port)
000821r 3               ; - PollJoy1 / PollJoy2  a single port, gated on HW_GPIO
000821r 3               ; - DrainKeyboardCombined  single-player keyboard fallback (WASD or arrows)
000821r 3               ; - DrainKeyboardSplit     two-player keyboard fallback (WASD=P1, arrows=P2)
000821r 3               ;
000821r 3               ; This file intentionally does NOT resolve a final NEXT_DIR/START_PRESSED -
000821r 3               ; that composition (joystick-first priority, A-button-or-space, edge
000821r 3               ; detection) is project-specific glue that stays in each game's own
000821r 3               ; input.asm, since the exact target variables differ per game (NEXT_DIR vs
000821r 3               ; NEXT_P1/NEXT_P2, single-player vs split). See docs/INPUT.md for the
000821r 3               ; priority rule every caller should follow.
000821r 3               ; =============================================================================
000821r 3               
000821r 3               ; --- Joystick bits (active-low on the wire: 0 = pressed) ---
000821r 3               JOY_A     = %00000001
000821r 3               JOY_B     = %00000010
000821r 3               JOY_X     = %00000100
000821r 3               JOY_Y     = %00001000
000821r 3               JOY_UP    = %00010000
000821r 3               JOY_DOWN  = %00100000
000821r 3               JOY_LEFT  = %01000000
000821r 3               JOY_RIGHT = %10000000
000821r 3               
000821r 3               ; --- Keyboard fallback scancodes ---
000821r 3               ; Kernal delivers uppercase ASCII for letter keys; arrow keys are control
000821r 3               ; codes, not printable characters.
000821r 3               KEY_W           = 'W'
000821r 3               KEY_A           = 'A'
000821r 3               KEY_S           = 'S'
000821r 3               KEY_D           = 'D'
000821r 3               KEY_UP_ARROW    = $1E
000821r 3               KEY_DOWN_ARROW  = $1F
000821r 3               KEY_LEFT_ARROW  = $1C
000821r 3               KEY_RIGHT_ARROW = $1D
000821r 3               KEY_FIRE        = ' '     ; space bar: P1's fire fallback (thumb-reachable
000821r 3                                          ; from WASD's resting position; also the
000821r 3                                          ; traditional single-player shooter fire key)
000821r 3               KEY_FIRE2       = $0D     ; enter/return (CHAR_CR): P2's fire fallback,
000821r 3                                          ; sits right next to the arrow-key cluster on
000821r 3                                          ; nearly every layout. Deliberately not a
000821r 3                                          ; modifier key (Ctrl/Shift) -- the input buffer is a plain
000821r 3                                          ; character buffer, and modifier keys generally
000821r 3                                          ; don't produce their own readable character,
000821r 3                                          ; nor could left/right variants be told apart
000821r 3                                          ; even if they did.
000821r 3               
000821r 3               KB_DIR_NONE = $FF          ; sentinel: no direction seen in this drain
000821r 3               
000821r 3               .segment "CART"
000821r 3               
000821r 3               ; -----------------------------------------------------------------------------
000821r 3               ; PollJoyCombined - read both joystick ports and AND-combine them
000821r 3               ; (active-low AND = logical OR of "pressed"), so either port drives a
000821r 3               ; single-player game regardless of which one it's plugged into.
000821r 3               ; Out: JOY_STATE = combined active-low byte, or $FF (idle) if no GPIO card.
000821r 3               ; Clobbers: A
000821r 3               ; -----------------------------------------------------------------------------
000821r 3               PollJoyCombined:
000821r 3  AD 0D 03       lda HW_PRESENT
000824r 3  29 20          and #HW_GPIO
000826r 3  D0 05          bne @haveGpio
000828r 3  A9 FF          lda #$FF
00082Ar 3  85 3E          sta JOY_STATE
00082Cr 3  60             rts
00082Dr 3               @haveGpio:
00082Dr 3  20 48 A0       jsr ReadJoystick1
000830r 3  85 3E          sta JOY_STATE
000832r 3  20 4B A0       jsr ReadJoystick2
000835r 3  25 3E          and JOY_STATE
000837r 3  85 3E          sta JOY_STATE
000839r 3  60             rts
00083Ar 3               
00083Ar 3               ; -----------------------------------------------------------------------------
00083Ar 3               ; PollJoy1 / PollJoy2 - read a single joystick port, gated on HW_GPIO
00083Ar 3               ; (ReadJoystick1/2 do not check hardware presence themselves - a floating
00083Ar 3               ; bus reads as meaningless data with no GPIO card fitted).
00083Ar 3               ; Out: JOY_STATE / JOY_STATE2, or $FF (idle) if no GPIO card.
00083Ar 3               ; Clobbers: A
00083Ar 3               ; -----------------------------------------------------------------------------
00083Ar 3               PollJoy1:
00083Ar 3  AD 0D 03       lda HW_PRESENT
00083Dr 3  29 20          and #HW_GPIO
00083Fr 3  D0 05          bne @haveGpio
000841r 3  A9 FF          lda #$FF
000843r 3  85 3E          sta JOY_STATE
000845r 3  60             rts
000846r 3               @haveGpio:
000846r 3  20 48 A0       jsr ReadJoystick1
000849r 3  85 3E          sta JOY_STATE
00084Br 3  60             rts
00084Cr 3               
00084Cr 3               PollJoy2:
00084Cr 3  AD 0D 03       lda HW_PRESENT
00084Fr 3  29 20          and #HW_GPIO
000851r 3  D0 05          bne @haveGpio
000853r 3  A9 FF          lda #$FF
000855r 3  85 4F          sta JOY_STATE2
000857r 3  60             rts
000858r 3               @haveGpio:
000858r 3  20 4B A0       jsr ReadJoystick2
00085Br 3  85 4F          sta JOY_STATE2
00085Dr 3  60             rts
00085Er 3               
00085Er 3               ; -----------------------------------------------------------------------------
00085Er 3               ; NextKey - the next key waiting in the Kernal's input buffer, read with
00085Er 3               ; BufferSize/ReadBuffer rather than Chrin: Chrin echoes the key through
00085Er 3               ; Chrout, which on BIOS 2.x brings the Kernal's text screen up over the
00085Er 3               ; game's own picture, and on a TMS9918A writes the character into the screen
00085Er 3               ; at the cursor.
00085Er 3               ; Out: carry set and A = the key, or carry clear if none is waiting.
00085Er 3               ; Clobbers: A
00085Er 3               ; -----------------------------------------------------------------------------
00085Er 3               NextKey:
00085Er 3  20 0C A0       jsr BufferSize
000861r 3  C9 00          cmp #0
000863r 3  F0 07          beq @none
000865r 3  DA             phx
000866r 3  20 09 A0       jsr ReadBuffer
000869r 3  FA             plx
00086Ar 3  38             sec
00086Br 3  60             rts
00086Cr 3               @none:
00086Cr 3  18             clc
00086Dr 3  60             rts
00086Er 3               
00086Er 3               ; -----------------------------------------------------------------------------
00086Er 3               ; DrainKeyboardCombined - single-player keyboard fallback: WASD or arrow
00086Er 3               ; keys both work, whichever was pressed most recently in this call wins.
00086Er 3               ; Drains every pending key each call (not just one), so a
00086Er 3               ; burst typed between polls doesn't leave stale characters for next time.
00086Er 3               ; LEFT/RIGHT checks compile out entirely for a 2-directional caller that
00086Er 3               ; never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
00086Er 3               ; Out: KB_DIR = last recognized direction this call, or KB_DIR_NONE.
00086Er 3               ;      KB_FIRE = 1 if space or enter was seen this call, else 0. Both
00086Er 3               ;      fire keys work interchangeably here, matching how WASD and arrows
00086Er 3               ;      both work interchangeably for movement in this single-player case.
00086Er 3               ; Clobbers: A
00086Er 3               ; -----------------------------------------------------------------------------
00086Er 3               DrainKeyboardCombined:
00086Er 3  A9 FF          lda #KB_DIR_NONE
000870r 3  85 6C          sta KB_DIR
000872r 3  64 6A          stz KB_FIRE
000874r 3               @drain:
000874r 3  20 rr rr       jsr NextKey
000877r 3  90 4B          bcc @done                 ; C=0 = no key waiting, buffer empty
000879r 3               
000879r 3  C9 57          cmp #KEY_W
00087Br 3  F0 2B          beq @setUp
00087Dr 3  C9 1E          cmp #KEY_UP_ARROW
00087Fr 3  F0 27          beq @setUp
000881r 3  C9 53          cmp #KEY_S
000883r 3  F0 2A          beq @setDown
000885r 3  C9 1F          cmp #KEY_DOWN_ARROW
000887r 3  F0 26          beq @setDown
000889r 3               .ifdef DIR_LEFT
000889r 3  C9 41          cmp #KEY_A
00088Br 3  F0 29          beq @setLeft
00088Dr 3  C9 1C          cmp #KEY_LEFT_ARROW
00088Fr 3  F0 25          beq @setLeft
000891r 3               .endif
000891r 3               .ifdef DIR_RIGHT
000891r 3  C9 44          cmp #KEY_D
000893r 3  F0 28          beq @setRight
000895r 3  C9 1D          cmp #KEY_RIGHT_ARROW
000897r 3  F0 24          beq @setRight
000899r 3               .endif
000899r 3  C9 20          cmp #KEY_FIRE
00089Br 3  F0 04          beq @setFire
00089Dr 3  C9 0D          cmp #KEY_FIRE2
00089Fr 3  D0 D3          bne @drain
0008A1r 3               @setFire:
0008A1r 3  A9 01          lda #1
0008A3r 3  85 6A          sta KB_FIRE
0008A5r 3  4C rr rr       jmp @drain
0008A8r 3               
0008A8r 3               @setUp:
0008A8r 3  A9 00          lda #DIR_UP
0008AAr 3  85 6C          sta KB_DIR
0008ACr 3  4C rr rr       jmp @drain
0008AFr 3               @setDown:
0008AFr 3  A9 01          lda #DIR_DOWN
0008B1r 3  85 6C          sta KB_DIR
0008B3r 3  4C rr rr       jmp @drain
0008B6r 3               .ifdef DIR_LEFT
0008B6r 3               @setLeft:
0008B6r 3  A9 02          lda #DIR_LEFT
0008B8r 3  85 6C          sta KB_DIR
0008BAr 3  4C rr rr       jmp @drain
0008BDr 3               .endif
0008BDr 3               .ifdef DIR_RIGHT
0008BDr 3               @setRight:
0008BDr 3  A9 03          lda #DIR_RIGHT
0008BFr 3  85 6C          sta KB_DIR
0008C1r 3  4C rr rr       jmp @drain
0008C4r 3               .endif
0008C4r 3               
0008C4r 3               @done:
0008C4r 3  60             rts
0008C5r 3               
0008C5r 3               ; -----------------------------------------------------------------------------
0008C5r 3               ; DrainKeyboardSplit - two-player keyboard fallback: WASD drives P1 only,
0008C5r 3               ; arrow keys drive P2 only, so one player's keypresses can never move the
0008C5r 3               ; other's paddle/cycle. Drains every pending key ONCE per
0008C5r 3               ; call, checking both keysets in the same pass (so both players' presses
0008C5r 3               ; in the same drain window are captured, not just whichever keyset was
0008C5r 3               ; checked first). LEFT/RIGHT checks compile out for a 2-directional caller
0008C5r 3               ; that never defines DIR_LEFT/DIR_RIGHT (e.g. Pong).
0008C5r 3               ; Out: KB_DIR_P1 = last WASD direction seen this call, or KB_DIR_NONE.
0008C5r 3               ;      KB_DIR_P2 = last arrow-key direction seen this call, or KB_DIR_NONE.
0008C5r 3               ;      KB_FIRE = 1 if EITHER fire key was seen this call, else 0 - kept
0008C5r 3               ;      for callers with only one shared fire/start/pause action (every
0008C5r 3               ;      game as of this writing: "did anyone press it" is all that
0008C5r 3               ;      matters, mirroring how either joystick's A button already
0008C5r 3               ;      triggers the same shared action today).
0008C5r 3               ;      KB_FIRE_P1 = 1 if space (P1's fire key) was seen this call, else 0.
0008C5r 3               ;      KB_FIRE_P2 = 1 if enter (P2's fire key) was seen this call, else 0.
0008C5r 3               ;      A future game with independent per-player fire (e.g. a two-player
0008C5r 3               ;      shooter) reads KB_FIRE_P1/KB_FIRE_P2 instead of the combined flag.
0008C5r 3               ; Clobbers: A
0008C5r 3               ; -----------------------------------------------------------------------------
0008C5r 3               DrainKeyboardSplit:
0008C5r 3  A9 FF          lda #KB_DIR_NONE
0008C7r 3  85 68          sta KB_DIR_P1
0008C9r 3  85 69          sta KB_DIR_P2
0008CBr 3  64 6A          stz KB_FIRE
0008CDr 3  64 6D          stz KB_FIRE_P1
0008CFr 3  64 6E          stz KB_FIRE_P2
0008D1r 3               @drain:
0008D1r 3  20 rr rr       jsr NextKey
0008D4r 3  90 72          bcc @done                 ; C=0 = no key waiting, buffer empty
0008D6r 3               
0008D6r 3  C9 57          cmp #KEY_W
0008D8r 3  F0 36          beq @p1Up
0008DAr 3  C9 53          cmp #KEY_S
0008DCr 3  F0 39          beq @p1Down
0008DEr 3               .ifdef DIR_LEFT
0008DEr 3  C9 41          cmp #KEY_A
0008E0r 3  F0 3C          beq @p1Left
0008E2r 3               .endif
0008E2r 3               .ifdef DIR_RIGHT
0008E2r 3  C9 44          cmp #KEY_D
0008E4r 3  F0 3F          beq @p1Right
0008E6r 3               .endif
0008E6r 3  C9 1E          cmp #KEY_UP_ARROW
0008E8r 3  F0 42          beq @p2Up
0008EAr 3  C9 1F          cmp #KEY_DOWN_ARROW
0008ECr 3  F0 45          beq @p2Down
0008EEr 3               .ifdef DIR_LEFT
0008EEr 3  C9 1C          cmp #KEY_LEFT_ARROW
0008F0r 3  F0 48          beq @p2Left
0008F2r 3               .endif
0008F2r 3               .ifdef DIR_RIGHT
0008F2r 3  C9 1D          cmp #KEY_RIGHT_ARROW
0008F4r 3  F0 4B          beq @p2Right
0008F6r 3               .endif
0008F6r 3  C9 20          cmp #KEY_FIRE
0008F8r 3  F0 0D          beq @p1Fire
0008FAr 3  C9 0D          cmp #KEY_FIRE2
0008FCr 3  D0 D3          bne @drain
0008FEr 3  A9 01          lda #1
000900r 3  85 6A          sta KB_FIRE
000902r 3  85 6E          sta KB_FIRE_P2
000904r 3  4C rr rr       jmp @drain
000907r 3               @p1Fire:
000907r 3  A9 01          lda #1
000909r 3  85 6A          sta KB_FIRE
00090Br 3  85 6D          sta KB_FIRE_P1
00090Dr 3  4C rr rr       jmp @drain
000910r 3               
000910r 3               @p1Up:
000910r 3  A9 00          lda #DIR_UP
000912r 3  85 68          sta KB_DIR_P1
000914r 3  4C rr rr       jmp @drain
000917r 3               @p1Down:
000917r 3  A9 01          lda #DIR_DOWN
000919r 3  85 68          sta KB_DIR_P1
00091Br 3  4C rr rr       jmp @drain
00091Er 3               .ifdef DIR_LEFT
00091Er 3               @p1Left:
00091Er 3  A9 02          lda #DIR_LEFT
000920r 3  85 68          sta KB_DIR_P1
000922r 3  4C rr rr       jmp @drain
000925r 3               .endif
000925r 3               .ifdef DIR_RIGHT
000925r 3               @p1Right:
000925r 3  A9 03          lda #DIR_RIGHT
000927r 3  85 68          sta KB_DIR_P1
000929r 3  4C rr rr       jmp @drain
00092Cr 3               .endif
00092Cr 3               @p2Up:
00092Cr 3  A9 00          lda #DIR_UP
00092Er 3  85 69          sta KB_DIR_P2
000930r 3  4C rr rr       jmp @drain
000933r 3               @p2Down:
000933r 3  A9 01          lda #DIR_DOWN
000935r 3  85 69          sta KB_DIR_P2
000937r 3  4C rr rr       jmp @drain
00093Ar 3               .ifdef DIR_LEFT
00093Ar 3               @p2Left:
00093Ar 3  A9 02          lda #DIR_LEFT
00093Cr 3  85 69          sta KB_DIR_P2
00093Er 3  4C rr rr       jmp @drain
000941r 3               .endif
000941r 3               .ifdef DIR_RIGHT
000941r 3               @p2Right:
000941r 3  A9 03          lda #DIR_RIGHT
000943r 3  85 69          sta KB_DIR_P2
000945r 3  4C rr rr       jmp @drain
000948r 3               .endif
000948r 3               
000948r 3               @done:
000948r 3  60             rts
000949r 3               
000949r 2               
000949r 2               ; -----------------------------------------------------------------------------
000949r 2               ; PollInput - P1: joystick 1 first, WASD fallback when idle. Also reads
000949r 2               ; joystick 2 and drains the keyboard (once, for both players), and ORs A on
000949r 2               ; either joystick, space or enter into START_PRESSED, independent of the
000949r 2               ; direction priority.
000949r 2               ; -----------------------------------------------------------------------------
000949r 2               PollInput:
000949r 2  64 4C        	stz START_PRESSED
00094Br 2               
00094Br 2  20 rr rr     	jsr PollJoy1
00094Er 2  20 rr rr     	jsr PollJoy2
000951r 2  20 rr rr     	jsr DrainKeyboardSplit
000954r 2               
000954r 2  A5 3E        	lda JOY_STATE
000956r 2  29 F0        	and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
000958r 2  C9 F0        	cmp #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
00095Ar 2  F0 2B        	beq @kbDir                ; joystick idle on all 4 directions -> fallback
00095Cr 2               
00095Cr 2  A5 3E        	lda JOY_STATE
00095Er 2  29 10        	and #JOY_UP
000960r 2  D0 04        	bne @jNotUp
000962r 2  A9 00        	lda #DIR_UP
000964r 2  85 43        	sta NEXT_DIR
000966r 2               @jNotUp:
000966r 2  A5 3E        	lda JOY_STATE
000968r 2  29 20        	and #JOY_DOWN
00096Ar 2  D0 04        	bne @jNotDown
00096Cr 2  A9 01        	lda #DIR_DOWN
00096Er 2  85 43        	sta NEXT_DIR
000970r 2               @jNotDown:
000970r 2  A5 3E        	lda JOY_STATE
000972r 2  29 40        	and #JOY_LEFT
000974r 2  D0 04        	bne @jNotLeft
000976r 2  A9 02        	lda #DIR_LEFT
000978r 2  85 43        	sta NEXT_DIR
00097Ar 2               @jNotLeft:
00097Ar 2  A5 3E        	lda JOY_STATE
00097Cr 2  29 80        	and #JOY_RIGHT
00097Er 2  D0 04        	bne @jNotRight
000980r 2  A9 03        	lda #DIR_RIGHT
000982r 2  85 43        	sta NEXT_DIR
000984r 2               @jNotRight:
000984r 2  4C rr rr     	jmp @doneDir
000987r 2               
000987r 2               @kbDir:
000987r 2  A5 68        	lda KB_DIR_P1
000989r 2  C9 FF        	cmp #KB_DIR_NONE
00098Br 2  F0 02        	beq @doneDir
00098Dr 2  85 43        	sta NEXT_DIR
00098Fr 2               @doneDir:
00098Fr 2               
00098Fr 2               	; Fire/A: OR'd independently of direction priority - A held on either
00098Fr 2               	; joystick, or space or enter seen this drain, sets START_PRESSED.
00098Fr 2  A5 3E        	lda JOY_STATE
000991r 2  25 4F        	and JOY_STATE2                ; active low: pressed on either stick
000993r 2  29 01        	and #JOY_A
000995r 2  D0 07        	bne @checkKbFire
000997r 2  A9 01        	lda #1
000999r 2  85 4C        	sta START_PRESSED
00099Br 2  4C rr rr     	jmp @doneFire
00099Er 2               @checkKbFire:
00099Er 2  A5 6A        	lda KB_FIRE
0009A0r 2  F0 04        	beq @doneFire
0009A2r 2  A9 01        	lda #1
0009A4r 2  85 4C        	sta START_PRESSED
0009A6r 2               @doneFire:
0009A6r 2               
0009A6r 2  A9 00        	lda #$00
0009A8r 2  85 4D        	sta FIRE_EDGE
0009AAr 2  A5 3F        	lda PREV_FIRE
0009ACr 2  D0 06        	bne @noEdge
0009AEr 2  A5 4C        	lda START_PRESSED
0009B0r 2  F0 02        	beq @noEdge
0009B2r 2  E6 4D        	inc FIRE_EDGE
0009B4r 2               @noEdge:
0009B4r 2  A5 4C        	lda START_PRESSED
0009B6r 2  85 3F        	sta PREV_FIRE
0009B8r 2  60           	rts
0009B9r 2               
0009B9r 2               ; -----------------------------------------------------------------------------
0009B9r 2               ; PollInputP2 - P2: joystick 2 first (read by PollInput), arrow-key fallback
0009B9r 2               ; when idle. Always run, whatever GAME_MODE says: on the title screen GAME_MODE
0009B9r 2               ; is only the mode picked so far, and MenuInput reads
0009B9r 2               ; player 2's stick there too. During 1P play ComputeP2AIDirection overwrites
0009B9r 2               ; P2_NEXT_DIR right after this on every path, so a stick in port 2 can't steer
0009B9r 2               ; the CPU.
0009B9r 2               ; -----------------------------------------------------------------------------
0009B9r 2               PollInputP2:
0009B9r 2  A5 4F        	lda JOY_STATE2
0009BBr 2  29 F0        	and #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
0009BDr 2  C9 F0        	cmp #(JOY_UP | JOY_DOWN | JOY_LEFT | JOY_RIGHT)
0009BFr 2  F0 29        	beq @kbDir                ; joystick idle on all 4 directions -> fallback
0009C1r 2               
0009C1r 2  A5 4F        	lda JOY_STATE2
0009C3r 2  29 10        	and #JOY_UP
0009C5r 2  D0 04        	bne @notUp
0009C7r 2  A9 00        	lda #DIR_UP
0009C9r 2  85 48        	sta P2_NEXT_DIR
0009CBr 2               @notUp:
0009CBr 2  A5 4F        	lda JOY_STATE2
0009CDr 2  29 20        	and #JOY_DOWN
0009CFr 2  D0 04        	bne @notDown
0009D1r 2  A9 01        	lda #DIR_DOWN
0009D3r 2  85 48        	sta P2_NEXT_DIR
0009D5r 2               @notDown:
0009D5r 2  A5 4F        	lda JOY_STATE2
0009D7r 2  29 40        	and #JOY_LEFT
0009D9r 2  D0 04        	bne @notLeft
0009DBr 2  A9 02        	lda #DIR_LEFT
0009DDr 2  85 48        	sta P2_NEXT_DIR
0009DFr 2               @notLeft:
0009DFr 2  A5 4F        	lda JOY_STATE2
0009E1r 2  29 80        	and #JOY_RIGHT
0009E3r 2  D0 0D        	bne @done
0009E5r 2  A9 03        	lda #DIR_RIGHT
0009E7r 2  85 48        	sta P2_NEXT_DIR
0009E9r 2  60           	rts
0009EAr 2               
0009EAr 2               @kbDir:
0009EAr 2  A5 69        	lda KB_DIR_P2
0009ECr 2  C9 FF        	cmp #KB_DIR_NONE
0009EEr 2  F0 02        	beq @done
0009F0r 2  85 48        	sta P2_NEXT_DIR
0009F2r 2               @done:
0009F2r 2  60           	rts
0009F3r 2               
0009F3r 1               .include "src/sound.asm"
0009F3r 2               ; =============================================================================
0009F3r 2               ;   sound.asm - sound effects on the SID, and the interrupt handler
0009F3r 2               ; =============================================================================
0009F3r 2               ;   The sounds of Trap, TrailDuel's version in DuelTastic, rebuilt for the
0009F3r 2               ;   SID's three voices (tools/build-sound.mjs holds them): a blip as a person
0009F3r 2               ;   turns, the menu's select, a chord as a round starts, the crash, and the
0009F3r 2               ;   win and draw stings. An effect takes the voice it prefers, or another, and
0009F3r 2               ;   a louder one can take a voice from a quieter one. There's no music.
0009F3r 2               ;
0009F3r 2               ;   A timer interrupt (the VIA's timer 2, on the GPIO card) runs SoundTick 60
0009F3r 2               ;   times a second from bank 0, so the sound keeps time however busy the game
0009F3r 2               ;   is. The game only leaves requests in a queue. This fixed-bank half holds
0009F3r 2               ;   those calls and the interrupt handler.
0009F3r 2               ; =============================================================================
0009F3r 2               
0009F3r 2               .segment "CART"
0009F3r 2               
0009F3r 2               TIMER_FRAME   = 16600              ; a 60th of a second, less the time to restart it
0009F3r 2               
0009F3r 2               ; SoundInit - at start-up, with interrupts still off: silence, take over the
0009F3r 2               ; interrupt, and start the timer if there's a sound card and a GPIO card.
0009F3r 2               SoundInit:
0009F3r 2  A2 50          ldx #S_VARS_END - S_REG - 1
0009F5r 2               @clear:
0009F5r 2  9E 00 0A       stz S_REG,x
0009F8r 2  CA             dex
0009F9r 2  10 FA          bpl @clear
0009FBr 2  AD 00 03       lda IRQ_PTR
0009FEr 2  85 A9          sta OLD_IRQ
000A00r 2  AD 01 03       lda IRQ_PTR+1
000A03r 2  85 AA          sta OLD_IRQ+1
000A05r 2  A9 rr          lda #<SysIrq
000A07r 2  8D 00 03       sta IRQ_PTR
000A0Ar 2  A9 rr          lda #>SysIrq
000A0Cr 2  8D 01 03       sta IRQ_PTR+1
000A0Fr 2  AD 0D 03       lda HW_PRESENT
000A12r 2  29 40          and #HW_SID
000A14r 2  F0 2B          beq @done
000A16r 2  A2 18          ldx #$18
000A18r 2               @sid:
000A18r 2  9E 00 98       stz SID_V1_FREQ_LO,x
000A1Br 2  CA             dex
000A1Cr 2  10 FA          bpl @sid
000A1Er 2  AD 0D 03       lda HW_PRESENT
000A21r 2  29 20          and #HW_GPIO
000A23r 2  F0 1C          beq @done
000A25r 2  A9 01          lda #1
000A27r 2  8D 2B 0A       sta S_ON
000A2Ar 2  AD 0B 94       lda GPIO_ACR
000A2Dr 2  29 DF          and #%11011111                   ; timer 2 counts clock cycles
000A2Fr 2  8D 0B 94       sta GPIO_ACR
000A32r 2  A9 A0          lda #GPIO_IER_SET | GPIO_INT_T2
000A34r 2  8D 0E 94       sta GPIO_IER
000A37r 2  A9 D8          lda #<TIMER_FRAME
000A39r 2  8D 08 94       sta GPIO_T2CL
000A3Cr 2  A9 40          lda #>TIMER_FRAME
000A3Er 2  8D 09 94       sta GPIO_T2CH
000A41r 2               @done:
000A41r 2  60             rts
000A42r 2               
000A42r 2               ; SysIrq - the machine's interrupt handler from now on, as 6502-HexFleet's: serial
000A42r 2               ; bytes while linked, the keyboard as the Kernal handles it, and the sound
000A42r 2               ; timer. While linked, a received byte goes into the link's ring, which also
000A42r 2               ; keeps it out of the keyboard buffer. The sound runs with interrupts back on,
000A42r 2               ; so a long tick can't make the serial port lose a byte. A BRK is the Kernal's.
000A42r 2               SysIrq:
000A42r 2  48             pha
000A43r 2  DA             phx
000A44r 2  5A             phy
000A45r 2  BA             tsx
000A46r 2  BD 04 01       lda $104,x                       ; the saved flags
000A49r 2  29 10          and #$10
000A4Br 2  D0 62          bne @brk
000A4Dr 2  A5 8B          lda LINK_ON
000A4Fr 2  F0 11          beq @keys
000A51r 2  AD 01 90       lda SC_STATUS
000A54r 2  29 08          and #SC_STATUS_RDRF
000A56r 2  F0 0A          beq @keys
000A58r 2  AD 00 90       lda SC_DATA
000A5Br 2  A6 A0          ldx RX_HEAD
000A5Dr 2  9D 00 08       sta RX_BUF,x
000A60r 2  E6 A0          inc RX_HEAD
000A62r 2               @keys:
000A62r 2  AD 0D 03       lda HW_PRESENT
000A65r 2  29 20          and #HW_GPIO
000A67r 2  F0 42          beq @exit
000A69r 2  AD 0D 94       lda GPIO_IFR
000A6Cr 2  29 10          and #GPIO_INT_CB1
000A6Er 2  F0 08          beq @ps2
000A70r 2  AD 00 94       lda GPIO_PORTB                   ; the matrix keyboard
000A73r 2  20 06 A0       jsr WriteBuffer
000A76r 2  80 0D          bra @timer
000A78r 2               @ps2:
000A78r 2  AD 0D 94       lda GPIO_IFR
000A7Br 2  29 02          and #GPIO_INT_CA1
000A7Dr 2  F0 06          beq @timer
000A7Fr 2  AD 01 94       lda GPIO_PORTA                   ; a PS/2 keyboard
000A82r 2  20 06 A0       jsr WriteBuffer
000A85r 2               @timer:
000A85r 2  AD 2B 0A       lda S_ON
000A88r 2  F0 21          beq @exit
000A8Ar 2  AD 0D 94       lda GPIO_IFR
000A8Dr 2  29 20          and #GPIO_INT_T2
000A8Fr 2  F0 1A          beq @exit
000A91r 2  A9 D8          lda #<TIMER_FRAME
000A93r 2  8D 08 94       sta GPIO_T2CL
000A96r 2  A9 40          lda #>TIMER_FRAME
000A98r 2  8D 09 94       sta GPIO_T2CH                    ; also clears the flag
000A9Br 2  AD 2A 0A       lda S_BUSY
000A9Er 2  D0 0B          bne @exit                        ; the last tick is still running
000AA0r 2  EE 2A 0A       inc S_BUSY
000AA3r 2  58             cli
000AA4r 2  20 rr rr       jsr SoundTick
000AA7r 2  78             sei
000AA8r 2  9C 2A 0A       stz S_BUSY
000AABr 2               @exit:
000AABr 2  7A             ply
000AACr 2  FA             plx
000AADr 2  68             pla
000AAEr 2  40             rti
000AAFr 2               @brk:
000AAFr 2  7A             ply
000AB0r 2  FA             plx
000AB1r 2  68             pla
000AB2r 2  6C A9 00       jmp (OLD_IRQ)
000AB5r 2               
000AB5r 2               ; --- What the game calls. These keep X and Y. ---
000AB5r 2               
000AB5r 2               ; SoundRequest - leave request A for the next tick.
000AB5r 2               SoundRequest:
000AB5r 2  DA             phx
000AB6r 2  AE 2B 0A       ldx S_ON
000AB9r 2  F0 10          beq @done
000ABBr 2  AE 28 0A       ldx S_QH
000ABEr 2  9D 20 0A       sta S_Q,x
000AC1r 2  E8             inx
000AC2r 2  E0 08          cpx #8
000AC4r 2  90 02          bcc @stored
000AC6r 2  A2 00          ldx #0
000AC8r 2               @stored:
000AC8r 2  8E 28 0A       stx S_QH
000ACBr 2               @done:
000ACBr 2  FA             plx
000ACCr 2  60             rts
000ACDr 2               
000ACDr 2               .macro SOUND name, effect
000ACDr 2               name:
000ACDr 2                 lda #effect
000ACDr 2                 jmp SoundRequest
000ACDr 2               .endmacro
000ACDr 2               
000ACDr 2  A9 01 4C rr  SOUND SndTurn, SFX_TURN
000AD1r 2  rr           
000AD2r 2  A9 02 4C rr  SOUND SndSelect, SFX_SELECT
000AD6r 2  rr           
000AD7r 2  A9 03 4C rr  SOUND SndGo, SFX_GO
000ADBr 2  rr           
000ADCr 2  A9 06 4C rr  SOUND SndCrash, SFX_CRASH
000AE0r 2  rr           
000AE1r 2  A9 08 4C rr  SOUND SndWin, SFX_WIN
000AE5r 2  rr           
000AE6r 2  A9 0B 4C rr  SOUND SndDraw, SFX_DRAW
000AEAr 2  rr           
000AEBr 2               
000AEBr 2               ; =============================================================================
000AEBr 2               ;   The driver, in bank 0, which TrailDuel never switches away from. Everything
000AEBr 2               ;   here runs in the interrupt, so it keeps to its own memory.
000AEBr 2               ; =============================================================================
000AEBr 2               
000AEBr 2               .segment "BANK00"
000000r 2               
000000r 2               .include "sounddata.inc"
000000r 3               ; =============================================================================
000000r 3               ;   sounddata.inc - GENERATED by tools/build-sound.mjs (make sound).
000000r 3               ;   Do not edit by hand: change the script and run it again.
000000r 3               ; =============================================================================
000000r 3               
000000r 3               SFX_TURN = 1
000000r 3               SFX_SELECT = 2
000000r 3               SFX_GO = 3
000000r 3               SFX_GO_E = 4
000000r 3               SFX_GO_G = 5
000000r 3               SFX_CRASH = 6
000000r 3               SFX_THUD = 7
000000r 3               SFX_WIN = 8
000000r 3               SFX_WIN_E = 9
000000r 3               SFX_WIN_G = 10
000000r 3               SFX_DRAW = 11
000000r 3               SFX_DRAW_D = 12
000000r 3               SFX_COUNT = 12
000000r 3               
000000r 3               .segment "BANK00"
000000r 3               
000000r 3               ; Indexed by effect number (0 is nothing)
000000r 3               FxPrio:
000000r 3  00 02 02 05    .byte $00,$02,$02,$05,$05,$05,$07,$07,$08,$08,$08,$08,$08
000004r 3  05 05 07 07  
000008r 3  08 08 08 08  
00000Dr 3               FxVoice:
00000Dr 3  00 00 00 00    .byte $00,$00,$00,$00,$01,$02,$02,$01,$00,$01,$02,$00,$01
000011r 3  01 02 02 01  
000015r 3  00 01 02 00  
00001Ar 3               FxOther:
00001Ar 3  00 02 02 00    .byte $00,$02,$02,$00,$00,$00,$00,$00,$00,$00,$00,$00,$00
00001Er 3  00 00 00 00  
000022r 3  00 00 00 00  
000027r 3               FxPair:
000027r 3  00 00 00 04    .byte $00,$00,$00,$04,$05,$00,$07,$00,$09,$0A,$00,$0C,$00
00002Br 3  05 00 07 00  
00002Fr 3  09 0A 00 0C  
000034r 3               FxLo:
