0002CDr 2               
0002CDr 2  A9 11          lda #ARENA_MIN_Y + 1
0002CFr 2  85 55          sta SCAN_TMP
0002D1r 2               @down:
0002D1r 2  64 B8          stz PX_HI
0002D3r 2  A2 08          ldx #<ARENA_MIN_X
0002D5r 2  A5 55          lda SCAN_TMP
