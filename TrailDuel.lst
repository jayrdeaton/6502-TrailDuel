000292r 2  C8             iny
000293r 2  D0 FA          bne @vramPage
000295r 2  CA             dex
000296r 2  D0 F7          bne @vramPage
000298r 2  68             pla
000299r 2  1A             inc a
00029Ar 2  C9 03          cmp #3
00029Cr 2  D0 E2          bne @bank
00029Er 2  A9 00          lda #0
0002A0r 2  4C rr rr       jmp SetVBank
0002A3r 2               
0002A3r 2               ; DrawBorder - the arena's edge, a pixel wide all round.
0002A3r 2               DrawBorder:
0002A3r 2  A9 08          lda #<ARENA_MIN_X
0002A5r 2  85 89          sta FL_TILE
0002A7r 2  A9 00          lda #>ARENA_MIN_X
0002A9r 2  85 8A          sta FL_TILE+1
0002ABr 2               @across:
0002ABr 2  A5 8A          lda FL_TILE+1
0002ADr 2  85 B8          sta PX_HI
0002AFr 2  A6 89          ldx FL_TILE
0002B1r 2  A9 10          lda #ARENA_MIN_Y
0002B3r 2  20 rr rr       jsr PixelSetBorder
0002B6r 2  A9 DF          lda #ARENA_MAX_Y
0002B8r 2  20 rr rr       jsr PixelSetBorder
0002BBr 2  E6 89          inc FL_TILE
0002BDr 2  D0 02          bne @nextX
0002BFr 2  E6 8A          inc FL_TILE+1
0002C1r 2               @nextX:
