0002DAr 2  A9 01          lda #>ARENA_MAX_X
0002DCr 2  85 B8          sta PX_HI
0002DEr 2  A2 37          ldx #<ARENA_MAX_X
0002E0r 2  A5 55          lda SCAN_TMP
0002E2r 2  20 rr rr       jsr PixelSetBorder
0002E5r 2  E6 55          inc SCAN_TMP
0002E7r 2  A5 55          lda SCAN_TMP
0002E9r 2  C9 DF          cmp #ARENA_MAX_Y
0002EBr 2  D0 E4          bne @down
0002EDr 2  60             rts
0002EEr 2               
0002EEr 2               ; --- The riders' heads: a white pixel each, as sprites ---
0002EEr 2               
0002EEr 2               InitHeadSprites:
0002EEr 2  A9 00          lda #0
0002F0r 2  20 rr rr       jsr SetVBank
0002F3r 2  A9 00          lda #<V_SPRPAT
0002F5r 2  A2 28          ldx #>V_SPRPAT
0002F7r 2  20 rr rr       jsr VAddr
0002FAr 2  A9 80          lda #%10000000                   ; pattern 0: the top left pixel
0002FCr 2  8D 00 9C       sta VC_DATA
0002FFr 2  A2 07          ldx #7
000301r 2               @rows:
000301r 2  9C 00 9C       stz VC_DATA
000304r 2  CA             dex
000305r 2  D0 FA          bne @rows
000307r 2  A9 00          lda #<V_SPRATTR
000309r 2  A2 20          ldx #>V_SPRATTR
00030Br 2  20 rr rr       jsr VAddr
00030Er 2  20 rr rr       jsr HideHead
000311r 2                 ; falls through
000311r 2               
000311r 2               HideHead:
000311r 2  A9 F0          lda #HIDE_Y
000313r 2  8D 00 9C       sta VC_DATA
000316r 2  9C 00 9C       stz VC_DATA
000319r 2  9C 00 9C       stz VC_DATA
00031Cr 2  9C 00 9C       stz VC_DATA
00031Fr 2  60             rts
000320r 2               
000320r 2               UpdateHeadSprites:
000320r 2  A9 00          lda #0
000322r 2  20 rr rr       jsr SetVBank
000325r 2  A9 00          lda #<V_SPRATTR
000327r 2  A2 20          ldx #>V_SPRATTR
000329r 2  20 rr rr       jsr VAddr
00032Cr 2  A5 44          lda P1_ALIVE
00032Er 2  F0 0D          beq @hide1
000330r 2  A5 BB          lda P1_XH
000332r 2  85 B8          sta PX_HI
000334r 2  A5 41          lda P1_Y
000336r 2  A6 40          ldx P1_X
000338r 2  20 rr rr       jsr PutHead
00033Br 2  80 03          bra @second
00033Dr 2               @hide1:
00033Dr 2  20 rr rr       jsr HideHead
000340r 2               @second:
000340r 2  A5 49          lda P2_ALIVE
000342r 2  F0 CD          beq HideHead
000344r 2  A5 BC          lda P2_XH
000346r 2  85 B8          sta PX_HI
000348r 2  A5 46          lda P2_Y
00034Ar 2  A6 45          ldx P2_X
00034Cr 2                 ; falls through
00034Cr 2               
00034Cr 2               ; PutHead - a head sprite's slot, at row A, column X (bit 8 in PX_HI).
00034Cr 2               PutHead:
00034Cr 2  C9 F0          cmp #HIDE_Y
00034Er 2  B0 C1          bcs HideHead
000350r 2  8D 00 9C       sta VC_DATA
000353r 2  8E 00 9C       stx VC_DATA
000356r 2  9C 00 9C       stz VC_DATA
000359r 2  A5 B8          lda PX_HI
00035Br 2  F0 04          beq @low
00035Dr 2  A9 C7          lda #HEAD_ATTR | VC_ATTR_BIT8    ; the attribute's top bit is X's bit 8
00035Fr 2  80 02          bra @attr
000361r 2               @low:
000361r 2  A9 47          lda #HEAD_ATTR
000363r 2               @attr:
000363r 2  8D 00 9C       sta VC_DATA
